# ============================================
# BRASARGENT — VARIABLES DE ENTORNO (PRODUCCIÓN)
# ============================================
# Copia este archivo como .env y ajusta las contraseñas.

# ============================================
# BASE DE DATOS MYSQL
# ============================================
DB_HOST=db
DB_PORT=3306
DB_USER=brasargent_user
DB_PASSWORD=your_secure_password_here
DB_NAME=brasargent
DB_ROOT_PASSWORD=your_root_password_here

# ============================================
# OPENWA (WHATSAPP API)
# ============================================
OPENWA_API_URL=http://openwa:2785/api
OPENWA_API_KEY=your_openwa_api_key_here
OPENWA_ADMIN_KEY=your_openwa_admin_key_here
OPENWA_DEFAULT_SESSION=brasargent
