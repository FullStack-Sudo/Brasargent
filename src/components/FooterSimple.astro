<script>
document.addEventListener('DOMContentLoaded', async () => {
    // 🔴 Registrar visita y actualizar burbuja en tiempo real
    try {
        const response = await fetch('/api/visitas');
        const data = await response.json();
        
        if (data.success) {
            const bubbleCount = document.querySelector('.bubble-count');
            if (bubbleCount) {
                bubbleCount.textContent = data.total.toString();
            }
        }
    } catch (error) {
        console.error('Error al actualizar contador de visitas:', error);
    }

    // 🔴 Modal de desarrollador (Easter Egg) — Rediseñado
    const trigger = document.getElementById("developer-modal-trigger");
    const modal = document.getElementById("developer-modal");
    const modalContent = document.getElementById("developer-modal-content");
    const closeBtn = document.getElementById("close-developer-modal");

    if (trigger && modal && modalContent && closeBtn) {

        const openModal = () => {
            modal.classList.add("ee-active");
            document.body.style.overflow = 'hidden';

            // Stagger reveal each section
            setTimeout(() => {
                modal.classList.add("ee-visible");
            }, 10);

            const sections = modalContent.querySelectorAll('.ee-section');
            sections.forEach((section, i) => {
                const delay = parseInt(section.getAttribute('data-ee-delay') || '0', 10);
                setTimeout(() => {
                    section.classList.add('ee-section-visible');
                }, 200 + delay * 80);
            });
        };

        const closeModal = () => {
            modal.classList.remove("ee-visible");
            
            // Remove section reveals
            const sections = modalContent.querySelectorAll('.ee-section');
            sections.forEach(section => {
                section.classList.remove('ee-section-visible');
            });

            setTimeout(() => {
                modal.classList.remove("ee-active");
                document.body.style.overflow = '';
            }, 400);
        };

        trigger.addEventListener("click", openModal);
        closeBtn.addEventListener("click", closeModal);

        modal.addEventListener("click", (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && modal.classList.contains("ee-active")) {
                closeModal();
            }
        });
    }

    // 🔴 Scroll Reveal para el footer
    const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add('footer-visible');
                observer.unobserve(entry.target);
            }
        });
    }, observerOptions);

    document.querySelectorAll('.footer-col, .footer-social-row, .footer-bottom-bar').forEach((el) => {
        observer.observe(el);
    });
});
</script>

