---
// src/components/FooterSimple.astro
// Footer Premium Luxury — Inspirado en hoteles/restaurantes de alto nivel
// Secciones: Pre-footer CTA → Info Columns → Social → Bottom Bar

import { query } from '../lib/db';

let visitasTotales = 0;
let visitasHoy = 0;

try {
    const [result] = await query('SELECT COUNT(*) as total FROM visitas_ip') as any[];
    visitasTotales = result?.[0]?.total || 0;

    const [hoy] = await query("SELECT COUNT(*) as hoy FROM visitas_ip WHERE DATE(fecha_visita) = CURDATE()") as any[];
    visitasHoy = hoy?.[0]?.hoy || 0;
} catch (error) {
    console.error('Error al obtener visitas SSR en FooterSimple:', error);
}

const currentYear = new Date().getFullYear();
