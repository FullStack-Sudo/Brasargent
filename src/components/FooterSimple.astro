<!-- Script para actualización en tiempo real de contador de visitas y control del modal -->
<script>
document.addEventListener('DOMContentLoaded', async () => {
    // 🔴 Registrar visita y actualizar burbuja en tiempo real
    try {
        const response = await fetch('/api/visitas');
        const data = await response.json();
        
        if (data.success) {
            const bubbleCount = document.querySelector('.bubble-count');
            const totalNumSpan = document.querySelector('.visitas-total-num');

            if (bubbleCount) {
                const current = parseInt(bubbleCount.textContent || '0', 10);
                const target = data.total;

                bubbleCount.textContent = target.toString();
                if (totalNumSpan) totalNumSpan.textContent = target.toString();

                const bubble = document.querySelector('.bubble');
                if (bubble && (data.es_nueva || target > current)) {
                    bubble.classList.add('bubble-pop');
                    setTimeout(() => {
                        bubble.classList.remove('bubble-pop');
                    }, 600);
                }
            }
            
            // Actualizar visitas del día y total
            const totalResponse = await fetch('/api/visitas/total');
            const totalData = await totalResponse.json();
            
            if (totalData.success) {
                const hoyNumSpan = document.querySelector('.visitas-hoy-num');
                if (hoyNumSpan) {
                    hoyNumSpan.textContent = totalData.hoy.toString();
                }
            }
        }
    } catch (error) {
        console.error('Error al actualizar contador de visitas:', error);
    }

    // 🔴 Modal de desarrollador
    const trigger = document.getElementById("developer-modal-trigger");
    const modal = document.getElementById("developer-modal");
    const modalContent = document.getElementById("developer-modal-content");
    const closeBtn = document.getElementById("close-developer-modal");

    if (trigger && modal && modalContent && closeBtn) {
        trigger.addEventListener("click", () => {
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            setTimeout(() => {
                modalContent.classList.remove("scale-95", "opacity-0");
                modalContent.classList.add("scale-100", "opacity-100");
            }, 10);
        });

        const closeModal = () => {
            modalContent.classList.remove("scale-100", "opacity-100");
            modalContent.classList.add("scale-95", "opacity-0");
            setTimeout(() => {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
            }, 500);
        };

        closeBtn.addEventListener("click", closeModal);

        modal.addEventListener("click", (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !modal.classList.contains("hidden")) {
                closeModal();
            }
        });
    }
});
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap");

  .font-lato {
    font-family: "Lato", sans-serif;
  }

  /* Animación latido y resplandor para el botón de descarga */
  @keyframes heartbeat-glow {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(158, 42, 43, 0.7);
    }
    50% {
      transform: scale(1.03);
      box-shadow: 0 0 25px 8px rgba(158, 42, 43, 0.4);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(158, 42, 43, 0);
    }
  }

  .btn-download-app {
    animation: heartbeat-glow 2.5s infinite ease-in-out;
  }

  .btn-download-app:hover {
    animation: none;
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 12px 30px rgba(158, 42, 43, 0.5);
  }

  /* ============================================
     🔴 BURBUJA PALPITANTE
     ============================================ */
  .bubble-container {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
  }

  .bubble {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, #9e2a2b, #7a2021);
    color: #fffaf0;
    box-shadow: 0 6px 22px rgba(158, 42, 43, 0.4);
    z-index: 2;
    transition: all 0.3s ease;
    cursor: default;
    user-select: none;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .bubble .bubble-count {
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.1;
    font-family: 'Inter', sans-serif;
  }

  .bubble .bubble-label {
    font-size: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.85;
    font-weight: 600;
  }

  /* 🔴 Burbuja de pulso suave */
  .bubble-pulse {
    position: absolute;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid rgba(158, 42, 43, 0.4);
    animation: pulseBubble 2.2s ease-in-out infinite;
    z-index: 1;
    pointer-events: none;
  }

  .bubble-pulse::before {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid rgba(158, 42, 43, 0.2);
    animation: pulseBubble 2.2s ease-in-out infinite 0.6s;
  }

  .bubble-pulse::after {
    content: '';
    position: absolute;
    inset: -16px;
    border-radius: 50%;
    border: 2px solid rgba(158, 42, 43, 0.1);
    animation: pulseBubble 2.2s ease-in-out infinite 1.2s;
  }

  @keyframes pulseBubble {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.18);
      opacity: 0.35;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* 🔴 Efecto Pop al registrar nueva visita */
  .bubble.bubble-pop {
    animation: popBubble 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes popBubble {
    0% {
      transform: scale(1);
    }
    30% {
      transform: scale(1.3);
      box-shadow: 0 8px 40px rgba(158, 42, 43, 0.7);
    }
    60% {
      transform: scale(0.9);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 6px 22px rgba(158, 42, 43, 0.4);
    }
