---
// Carrusel infinito de platos
const whatsappNumber = "59178555886";

// Array con todas las imágenes de platos
const platosImages = [
  "/img/platos/1.webp",
  "/img/platos/2.webp",
  "/img/platos/3.webp",
  "/img/platos/4.webp",
  "/img/platos/5.webp",
  "/img/platos/6.webp",
  "/img/platos/7.webp",
  "/img/platos/8.webp",
  "/img/platos/9.webp",
  "/img/platos/10.webp",
  "/img/platos/11.webp",
  "/img/platos/12.webp",
  "/img/platos/13.webp",
];

// Duplicamos el array para crear el efecto infinito
const allImages = [...platosImages, ...platosImages];
---

<section id="menu" class="meatgrid-section">
  <div class="meatgrid-header-wrap">
    <!-- Badge superior -->
    <div class="meatgrid-badge-row" data-aos="fade-up">
      <span class="meatgrid-badge">Carta de Cortes</span>
    </div>
    <!-- Título -->
    <h2 class="meatgrid-title" data-aos="fade-up" data-aos-delay="100">
      Nuestros Platos <span class="meatgrid-title-accent">Premium</span>
    </h2>
    <!-- Divider dorado -->
    <div class="meatgrid-divider" data-aos="fade-up" data-aos-delay="150">
      <div class="meatgrid-divider-line"></div>
      <span class="meatgrid-divider-icon">✦</span>
      <div class="meatgrid-divider-line"></div>
    </div>
    <p class="meatgrid-subtitle" data-aos="fade-up" data-aos-delay="200">
      Cortes seleccionados con técnica precisa, servidos continuamente en tu mesa
    </p>
  </div>
  <div> <!-- Cierre de max-w-7xl para el header -->

  <!-- Carrusel Infinito (Fuera del contenedor para ser full-width) -->
  <div class="relative w-full" data-aos="fade-in" data-aos-delay="200">
    <!-- Gradientes de fade en los bordes -->
    <div class="absolute left-0 top-0 bottom-0 w-32 bg-gradient-to-r from-white/20 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-white/20 to-transparent z-10 pointer-events-none"></div>
    
    <!-- Contenedor del carrusel -->
    <div class="carousel-container overflow-hidden py-8">
      <div class="carousel-track flex gap-4" style="animation: scroll-right 120s linear infinite;">
        {allImages.map((image, index) => (
          <div class="carousel-item flex-shrink-0">
            <div class="relative group">
              <div class="w-80 h-80 rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105">
                <img
                  src={image}
                  alt={`Plato ${(index % platosImages.length) + 1}`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
                <!-- Overlay con gradiente -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
/* ============================================
   MEATGRID — DARK PREMIUM SECTION
   ============================================ */
.meatgrid-section {
  padding: 80px 0 80px;
  overflow: hidden;
  background: #1A1A1A;
  position: relative;
}

.meatgrid-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 30% 50%, rgba(139,26,26,0.08) 0%, transparent 60%),
              radial-gradient(circle at 70% 50%, rgba(201,168,124,0.05) 0%, transparent 60%);
  pointer-events: none;
}

.meatgrid-header-wrap {
  text-align: center;
  margin-bottom: 48px;
  padding: 0 24px;
  position: relative;
  z-index: 1;
}

.meatgrid-badge-row { margin-bottom: 14px; }

.meatgrid-badge {
  display: inline-block;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.65rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 3px;
  color: #C9A87C;
  background: rgba(201, 168, 124, 0.08);
  border: 1px solid rgba(201, 168, 124, 0.15);
  padding: 6px 20px;
  border-radius: 50px;
}

.meatgrid-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 4.5vw, 3.2rem);
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.02em;
  margin-bottom: 16px;
  line-height: 1.15;
}

.meatgrid-title-accent {
  color: #C9A87C;
  font-style: italic;
}

.meatgrid-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin: 16px auto;
  max-width: 220px;
}
.meatgrid-divider-line {
  flex: 1;
  height: 1px;
  background: rgba(201,168,124,0.25);
}
.meatgrid-divider-icon {
  color: rgba(201,168,124,0.5);
  font-size: 0.8rem;
}

.meatgrid-subtitle {
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  font-weight: 300;
  color: rgba(255,255,255,0.4);
  max-width: 480px;
  margin: 0 auto;
  line-height: 1.7;
}

  @keyframes scroll-right {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }
  @keyframes scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .carousel-track { width: max-content; }

  /* Imagen oscurecida en dark mode */
  .carousel-item img {
    filter: brightness(0.9);
    transition: filter 0.3s ease;
  }
  .carousel-item:hover img {
    filter: brightness(1);
  }

  /* Pausar animación al hover */
  .carousel-container:hover .carousel-track {
    animation-play-state: paused;
  }

  /* Fade edges con fondo oscuro */
  .absolute.left-0 { background: linear-gradient(to right, #1A1A1A, transparent) !important; }
  .absolute.right-0 { background: linear-gradient(to left, #1A1A1A, transparent) !important; }
</style>
