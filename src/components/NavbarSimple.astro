---
// src/components/NavbarSimple.astro
// Navbar Premium — Transparente al inicio → Blanco glassmorphism al scroll
const whatsappNumber = "59178555886";
const whatsappMessage = encodeURIComponent(
  "Hola! Me gustaría hacer una reserva en Brasargent"
);
---

<nav id="navbar" class="navbar-luxury-fixed">
  <div class="navbar-inner">

    <!-- Logo Oficial (blanca.png arriba -> negro.png al scroll) -->
    <a href="/" class="navbar-logo-luxury" aria-label="Brasargent - Inicio">
      <img
        src="/img/logo/blanca.png"
        alt="Brasargent Rodizio Logo"
        class="navbar-logo-img"
        id="navbar-logo-img"
      />
    </a>

    <!-- Desktop Menu -->
    <div class="navbar-links-luxury hidden md:flex">
      <a href="/#inicio"      class="nav-link-luxury">Inicio</a>
      <a href="/#menu"        class="nav-link-luxury">Nuestros Platos</a>
      <a href="/#testimonios" class="nav-link-luxury">Testimonios</a>
      <a href="/sucursales"   class="nav-link-luxury nav-link-new">
        Sucursales
        <span class="nav-new-badge">NEW</span>
      </a>

      <div class="navbar-cta-group">
        <a href="/admin/login" class="nav-link-luxury nav-link-admin">
          Iniciar Sesión
        </a>
        <a href="/sucursales" class="btn-nav-reservar">
          <span class="btn-shimmer"></span>
          Reservar
        </a>
      </div>
    </div>

    <!-- Mobile Hamburger -->
    <button id="hamburgerBtn"
      class="hamburger-luxury md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <div class="hamburger-lines">
        <span id="line1"></span>
        <span id="line2"></span>
        <span id="line3"></span>
      </div>
    </button>
  </div>
</nav>

<!-- Mobile Menu Fullscreen -->
<div id="mobileMenu" class="mobile-menu-overlay">
  <div class="mobile-menu-inner">

    <!-- Links principales -->
    <nav class="mobile-nav-links">
      <a href="/#inicio"      class="menu-link mobile-nav-item">Inicio</a>
      <a href="/#menu"        class="menu-link mobile-nav-item">Nuestros Platos</a>
      <a href="/#testimonios" class="menu-link mobile-nav-item">Testimonios</a>
      <a href="/sucursales"   class="menu-link mobile-nav-item">
        Sucursales
        <span class="mobile-badge-new">🔥 NEW</span>
      </a>
      <a href="/#contacto"    class="menu-link mobile-nav-item">Contacto</a>
      <a href="/admin/login"  class="menu-link mobile-nav-item">Iniciar Sesión</a>
    </nav>

    <!-- Divider -->
    <div class="mobile-divider">
      <div class="mobile-divider-line"></div>
      <span class="mobile-divider-icon">✦</span>
      <div class="mobile-divider-line"></div>
    </div>

    <!-- CTA Reservar -->
    <a href="/sucursales" class="mobile-btn-reservar">
      <span class="mobile-btn-shimmer"></span>
      📅 Reservar Mesa
    </a>

    <!-- Redes Sociales -->
    <div class="mobile-social-links">
      <a href="https://facebook.com/brasargent" target="_blank" rel="noopener noreferrer"
         class="mobile-social-icon" aria-label="Facebook">
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
          <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.99h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
        </svg>
      </a>
      <a href="https://instagram.com/brasargent" target="_blank" rel="noopener noreferrer"
         class="mobile-social-icon" aria-label="Instagram">
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>
    </div>

    <p class="mobile-copyright">© 2026 BRASARGENT — Todos los derechos reservados</p>
  </div>
</div>

<style>
/* ============================================
   NAVBAR — TRANSPARENTE → BLANCO CON SCROLL
   ============================================ */
.navbar-luxury-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  /* Estado inicial: transparente */
  background: transparent;
  border-bottom: 1px solid transparent;
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Estado scrolled — añadido via JS */
.navbar-luxury-fixed.scrolled {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(26, 26, 26, 0.06);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
}

.navbar-inner {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 72px;
  padding: 0 24px;
}

/* Logo */
.navbar-logo-luxury {
  display: flex;
  align-items: center;
  text-decoration: none;
  transition: opacity 0.3s ease;
}
.navbar-logo-luxury:hover { opacity: 0.85; }

.navbar-logo-img {
  height: 44px;
  width: auto;
  object-fit: contain;
  transition: all 0.35s ease;
}

/* Desktop Links */
.navbar-links-luxury {
  align-items: center;
  gap: 32px;
}

.nav-link-luxury {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  /* Inicial: blanco */
  color: rgba(255, 255, 255, 0.85);
  text-decoration: none;
  transition: all 0.35s ease;
  position: relative;
}
.nav-link-luxury::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 0;
  height: 2px;
  background: #C9A87C;
  transition: width 0.3s ease;
}
.nav-link-luxury:hover {
  color: #fff;
}
.nav-link-luxury:hover::after { width: 100%; }

/* Scrolled state para links: Negrita resaltada al scroll */
.navbar-luxury-fixed.scrolled .nav-link-luxury {
  color: #111115;
  font-weight: 700;
}
.navbar-luxury-fixed.scrolled .nav-link-luxury:hover {
  color: #8B1A1A;
}
.navbar-luxury-fixed.scrolled .nav-link-luxury::after {
  background: #8B1A1A;
}

.nav-link-new { position: relative; }
.nav-new-badge {
  position: absolute;
  top: -10px;
  right: -28px;
  font-size: 0.55rem;
  font-weight: 800;
  background: #8B1A1A;
  color: white;
  padding: 2px 6px;
  border-radius: 10px;
  letter-spacing: 0.5px;
  animation: pulseBadge 2s ease-in-out infinite;
}

.nav-link-admin {
  color: rgba(255, 255, 255, 0.9) !important;
  font-weight: 700;
}
.navbar-luxury-fixed.scrolled .nav-link-admin {
  color: #8B1A1A !important;
  font-weight: 700 !important;
}
.nav-link-admin:hover { color: #C9A87C !important; }

.navbar-cta-group {
  display: flex;
  align-items: center;
  gap: 16px;
  padding-left: 20px;
  border-left: 1px solid rgba(255, 255, 255, 0.15);
  transition: border-color 0.35s ease;
}
.navbar-luxury-fixed.scrolled .navbar-cta-group {
  border-left-color: rgba(26, 26, 26, 0.1);
}

/* Botón Reservar — siempre terracota */
.btn-nav-reservar {
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #8B1A1A;
  color: #fffaf0;
  padding: 8px 20px;
  border-radius: 50px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.4s ease;
  box-shadow: 0 4px 16px rgba(139, 26, 26, 0.3);
}
.btn-nav-reservar:hover {
  background: #C9A87C;
  color: #1A1A1A;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(201, 168, 124, 0.35);
}
.btn-shimmer {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
  transform: translateX(-100%);
  transition: transform 0.8s ease;
}
.btn-nav-reservar:hover .btn-shimmer { transform: translateX(100%); }

/* Hamburger - SOLO EN MÓVIL */
.hamburger-luxury {
  display: none;
  align-items: center;
  justify-content: center;
  width: 40px; height: 40px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 4px;
  border-radius: 8px;
  transition: background 0.3s;
}

@media (max-width: 768px) {
  .hamburger-luxury {
    display: flex !important;
  }
  .navbar-links-luxury {
    display: none !important;
  }
}

@media (min-width: 769px) {
  .hamburger-luxury {
    display: none !important;
  }
  .navbar-links-luxury {
    display: flex !important;
  }
}
.hamburger-luxury:hover { background: rgba(255,255,255,0.1); }
.navbar-luxury-fixed.scrolled .hamburger-luxury:hover {
  background: rgba(0,0,0,0.05);
}

.hamburger-lines {
  position: relative;
  width: 24px; height: 18px;
}
.hamburger-lines span {
  position: absolute;
  left: 0;
  width: 100%;
  height: 2px;
  background: #fff;
  border-radius: 2px;
  transition: all 0.3s ease;
}
.navbar-luxury-fixed.scrolled .hamburger-lines span {
  background: #1A1A1A;
}
#line1 { top: 0; }
#line2 { top: 8px; }
#line3 { top: 16px; }

/* ============================================
   MOBILE MENU FULLSCREEN
   ============================================ */
.mobile-menu-overlay {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(26, 26, 26, 0.98);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  display: none;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
  transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}
.mobile-menu-overlay.open {
  display: flex;
  opacity: 1;
  pointer-events: auto;
  visibility: visible;
}

.mobile-menu-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  width: 100%;
  max-width: 480px;
  padding: 24px;
}

.mobile-nav-links {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: 100%;
  margin-top: 64px;
}

.mobile-nav-item {
  font-family: 'Playfair Display', serif;
  font-size: 2.8rem;
  font-weight: 700;
  color: rgba(255,255,255,0.75);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 12px;
  transition: all 0.3s ease;
  transform: translateX(-20px) scale(0.95);
  opacity: 0;
  position: relative;
}
.mobile-nav-item::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 2px;
  background: linear-gradient(90deg, #8B1A1A, #C9A87C);
  transition: width 0.3s ease;
}
.mobile-nav-item:hover { color: #fff; }
.mobile-nav-item:hover::after { width: 100%; }

.mobile-badge-new {
  font-size: 0.75rem;
  font-family: 'Montserrat', sans-serif;
  background: linear-gradient(135deg, #8B1A1A, #C9A87C);
  color: white;
  padding: 4px 12px;
  border-radius: 50px;
  font-weight: 700;
}

.mobile-divider {
  display: flex;
  align-items: center;
  gap: 16px;
  margin: 24px 0 20px;
  width: 240px;
}
.mobile-divider-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(201,168,124,0.4));
}
.mobile-divider-line:last-child {
  background: linear-gradient(90deg, rgba(201,168,124,0.4), transparent);
}
.mobile-divider-icon { color: rgba(201,168,124,0.6); font-size: 0.9rem; }

.mobile-btn-reservar {
  position: relative;
  overflow: hidden;
  width: 100%;
  max-width: 320px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: linear-gradient(135deg, #8B1A1A, #6B1414);
  color: #fffaf0;
  padding: 16px 24px;
  border-radius: 12px;
  font-family: 'Montserrat', sans-serif;
  font-weight: 600;
  font-size: 1rem;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 8px 32px rgba(139,26,26,0.35);
}
.mobile-btn-reservar:hover {
  transform: scale(1.03);
  box-shadow: 0 12px 40px rgba(139,26,26,0.45);
}
.mobile-btn-shimmer {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
  transform: translateX(-100%);
  transition: transform 1s ease;
}
.mobile-btn-reservar:hover .mobile-btn-shimmer { transform: translateX(100%); }

.mobile-social-links {
  display: flex;
  gap: 24px;
  margin-top: 24px;
}
.mobile-social-icon {
  color: rgba(255,255,255,0.3);
  transition: all 0.3s ease;
}
.mobile-social-icon:hover {
  color: #C9A87C;
  transform: translateY(-3px) scale(1.1);
}

.mobile-copyright {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.65rem;
  color: rgba(255,255,255,0.15);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-top: 20px;
  text-align: center;
}

/* Animaciones */
@keyframes pulseBadge {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%       { transform: scale(1.1); opacity: 0.75; }
}

html { scroll-behavior: smooth; }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const navbar      = document.getElementById('navbar');
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const mobileMenu   = document.getElementById('mobileMenu');
  const menuLinks    = document.querySelectorAll('.menu-link');

  // ============================================
  // SCROLL DETECTION — Transparente → Blanco
  // ============================================
  const SCROLL_THRESHOLD = 60;

  const logoImg = document.getElementById('navbar-logo-img') as HTMLImageElement | null;

  function updateNavbar() {
    if (!navbar) return;
    if (window.scrollY > SCROLL_THRESHOLD) {
      navbar.classList.add('scrolled');
      if (logoImg && !logoImg.src.endsWith('/img/logo/negro.png')) {
        logoImg.src = '/img/logo/negro.png';
      }
    } else {
      navbar.classList.remove('scrolled');
      if (logoImg && !logoImg.src.endsWith('/img/logo/blanca.png')) {
        logoImg.src = '/img/logo/blanca.png';
      }
    }
  }

  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar(); // run on load

  // ============================================
  // MOBILE MENU
  // ============================================
  if (!hamburgerBtn || !mobileMenu) return;

  const lines = [
    document.getElementById('line1'),
    document.getElementById('line2'),
    document.getElementById('line3'),
  ];

  const menu = {
    isOpen: false,

    open() {
      this.isOpen = true;
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      mobileMenu.classList.add('open');
      document.body.style.overflow = 'hidden';

      // X icon
      if (lines[0] && lines[1] && lines[2]) {
        lines[0].style.transform = 'rotate(45deg)';
        lines[0].style.top = '8px';
        lines[1].style.opacity = '0';
        lines[2].style.transform = 'rotate(-45deg)';
        lines[2].style.top = '8px';
      }

      // Stagger links in
      menuLinks.forEach((link, i) => {
        const el = link as HTMLElement;
        el.style.transitionDelay = `${i * 70 + 100}ms`;
        el.style.transform = 'translateX(0) scale(1)';
        el.style.opacity = '1';
      });
    },

    close() {
      this.isOpen = false;
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.remove('open');
      document.body.style.overflow = '';

      // Reset icon
      if (lines[0] && lines[1] && lines[2]) {
        lines[0].style.transform = 'rotate(0deg)';
        lines[0].style.top = '0px';
        lines[1].style.opacity = '1';
        lines[2].style.transform = 'rotate(0deg)';
        lines[2].style.top = '16px';
      }

      // Reset links
      menuLinks.forEach((link) => {
        const el = link as HTMLElement;
        el.style.transitionDelay = '0ms';
        el.style.transform = 'translateX(-20px) scale(0.95)';
        el.style.opacity = '0';
      });
    },

    toggle() { this.isOpen ? this.close() : this.open(); }
  };

  hamburgerBtn.addEventListener('click', () => menu.toggle());

  // Close on link click
  menuLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('/#')) {
        const id = href.substring(1);
        if (window.location.pathname === '/') {
          e.preventDefault();
          menu.close();
          setTimeout(() => {
            document.querySelector(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 400);
        }
      } else {
        menu.close();
      }
    });
  });

  // Close on ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.isOpen) menu.close();
  });

  // Close on resize to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth > 768 && menu.isOpen) menu.close();
  });

  // Init hidden for stagger
  menuLinks.forEach((link) => {
    const el = link as HTMLElement;
    el.style.transform = 'translateX(-20px) scale(0.95)';
    el.style.opacity = '0';
    el.style.transition = 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
  });

  // Smooth scroll for desktop nav-links
  document.querySelectorAll('.nav-link-luxury').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const href = (this as HTMLAnchorElement).getAttribute('href');
      if (href && href.startsWith('/#')) {
        const targetId = href.substring(1);
        const target = document.querySelector(targetId);
        if (target && window.location.pathname === '/') {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
});
</script>
