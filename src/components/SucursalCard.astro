---
// src/components/SucursalCard.astro
// Tarjeta de sucursal con diseño premium

interface Props {
    id?: number | string;
    nombre?: string;
    concepto?: string;
    direccion?: string;
    telefono?: string;
    horario?: string;
    capacidad?: number | string;
    rating?: number;
    resenas?: number | string;
    icono?: string;
    color?: string;
    permite_reservas?: boolean;
    sucursal?: any;
}

const props = Astro.props;
const sucursal = props.sucursal || {
    id: props.id,
    nombre: props.nombre,
    concepto: props.concepto,
    direccion: props.direccion,
    telefono: props.telefono,
    horario: props.horario,
    capacidad: props.capacidad || 120,
    rating: props.rating || 4.5,
    resenas: props.resenas || 0,
    icono: props.icono || "🏢",
    color: props.color || "#8B1A1A",
    permite_reservas: props.permite_reservas ?? true,
};

const {
    id,
    nombre,
    concepto,
    direccion,
    telefono,
    horario,
    capacidad,
    rating,
    resenas,
    icono,
    color,
    permite_reservas,
} = sucursal;
---

<div class="sucursal-card-premium">
    <!-- Borde superior decorativo -->
    <div
        class="sucursal-card-accent"
        style={`background: ${color || "#8B1A1A"}`}
    >
    </div>

    <div class="sucursal-card-content">
        <!-- Header -->
        <div class="sucursal-header-premium">
            <div class="sucursal-info-premium">
                <span class="sucursal-icon-premium">{icono || "🏢"}</span>
                <div>
                    <h3 class="sucursal-nombre">{nombre}</h3>
                    <span class="sucursal-concepto"
                        >{concepto || "Restaurante"}</span
                    >
                </div>
            </div>
            <div class="sucursal-rating-premium">
                <svg
                    class="rating-star"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="#C9A87C"
                >
                    <polygon
                        points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                    ></polygon>
                </svg>
                <span class="rating-number">{rating || 4.5}</span>
                <span class="rating-count">({resenas || 0})</span>
            </div>
        </div>

        <!-- Detalles con iconos refinados -->
        <div class="sucursal-detalles-premium">
            <div class="detalle-premium">
                <svg
                    class="detalle-icon-premium"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#6B6B6B"
                    stroke-width="1.5"
                >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                    ></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>{direccion}</span>
            </div>
            <div class="detalle-premium">
                <svg
                    class="detalle-icon-premium"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#6B6B6B"
                    stroke-width="1.5"
                >
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>{horario}</span>
            </div>
        </div>

        <!-- Capacidad -->
        <div class="capacidad-premium">
            <span class="capacidad-label">🪑 Capacidad:</span>
            <span class="capacidad-valor">{capacidad || 120} cubiertos</span>
        </div>

        <!-- Acciones -->
        <div class="sucursal-actions-premium">
            <button
                class="btn-action-premium btn-ubicacion"
                onclick={`verUbicacion('${id}')`}
            >
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                    ></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>Ubicación</span>
            </button>
            <button
                class="btn-action-premium btn-menu"
                onclick={`verMenu('${id}')`}
            >
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
                <span>Menú</span>
            </button>
            <button
                class="btn-action-premium btn-whatsapp"
                onclick={`abrirWhatsApp('${telefono}')`}
            >
                <img
                    src="/img/iconos/wp.png"
                    alt="WhatsApp"
                    width="18"
                    height="18"
                />
                <span>WhatsApp</span>
            </button>
            {
                permite_reservas && (
                    <button
                        class="btn-action-premium btn-reservar"
                        onclick={`abrirModalReserva('${id}')`}
                    >
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <rect
                                x="3"
                                y="4"
                                width="18"
                                height="18"
                                rx="2"
                                ry="2"
                            />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                        <span>Reservar</span>
                    </button>
                )
            }
        </div>
    </div>
</div>

<style>
    /* ============================================
   TARJETA DE SUCURSAL - PREMIUM
   ============================================ */
    .sucursal-card-premium {
        background: var(--color-blanco);
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: var(--shadow-elegante);
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        border: 1px solid rgba(0, 0, 0, 0.04);
    }

    .sucursal-card-premium:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-premium);
    }

    .sucursal-card-accent {
        height: 4px;
        background: var(--color-terracota);
    }

    .sucursal-card-content {
        padding: 24px 28px;
    }

    /* Header Premium */
    .sucursal-header-premium {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
    }

    .sucursal-info-premium {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .sucursal-icon-premium {
        font-size: 2rem;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.04));
    }

    .sucursal-nombre {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--color-carbon);
        margin: 0;
    }

    .sucursal-concepto {
        display: block;
        font-size: 0.7rem;
        color: var(--color-texto-secundario);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .sucursal-rating-premium {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .rating-star {
        width: 16px;
        height: 16px;
    }

    .rating-number {
        font-weight: 600;
        color: var(--color-carbon);
        font-size: 0.9rem;
    }

    .rating-count {
        color: var(--color-texto-secundario);
        font-size: 0.75rem;
    }

    /* Detalles Premium */
    .sucursal-detalles-premium {
        background: var(--color-crema);
        border-radius: var(--border-radius-sm);
        padding: 14px 18px;
        margin: 12px 0 16px;
    }

    .detalle-premium {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 4px 0;
        font-size: 0.85rem;
        color: var(--color-texto);
    }

    .detalle-icon-premium {
        flex-shrink: 0;
        color: var(--color-texto-secundario);
    }

    /* Capacidad */
    .capacidad-premium {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 12px 0 16px;
        font-size: 0.85rem;
    }

    .capacidad-label {
        font-weight: 500;
        color: var(--color-texto-secundario);
    }

    .capacidad-valor {
        font-weight: 600;
        color: var(--color-carbon);
    }

    /* Acciones Premium */
    .sucursal-actions-premium {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        margin-top: 8px;
    }

    .btn-action-premium {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 10px 8px;
        border: none;
        border-radius: var(--border-radius-sm);
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        background: transparent;
        color: var(--color-texto);
    }

    .btn-action-premium svg,
    .btn-action-premium img {
        flex-shrink: 0;
    }

    .btn-action-premium:hover {
        transform: translateY(-2px);
    }

    /* Botones específicos */
    .btn-ubicacion {
        background: rgba(139, 26, 26, 0.06);
        color: var(--color-terracota);
    }

    .btn-ubicacion:hover {
        background: rgba(139, 26, 26, 0.12);
    }

    .btn-menu {
        background: rgba(139, 26, 26, 0.06);
        color: var(--color-terracota);
    }

    .btn-menu:hover {
        background: rgba(139, 26, 26, 0.12);
    }

    .btn-whatsapp {
        background: rgba(37, 211, 102, 0.06);
        color: #25d366;
    }

    .btn-whatsapp:hover {
        background: rgba(37, 211, 102, 0.12);
    }

    .btn-reservar {
        background: rgba(201, 168, 124, 0.06);
        color: var(--color-dorado);
        border: 1px solid rgba(201, 168, 124, 0.08);
    }

    .btn-reservar:hover {
        background: rgba(201, 168, 124, 0.12);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .sucursal-actions-premium {
            grid-template-columns: repeat(2, 1fr);
        }

        .sucursal-card-content {
            padding: 18px 20px;
        }

        .sucursal-header-premium {
            flex-direction: column;
            gap: 8px;
        }
    }

    @media (max-width: 480px) {
        .sucursal-card-content {
            padding: 14px 16px;
        }

        .btn-action-premium {
            font-size: 0.7rem;
            padding: 8px 6px;
        }
    }
</style>
