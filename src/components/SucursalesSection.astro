// Componente de Sucursales con diseño futurista
import pool from "../lib/db";
import { agruparHorarios } from "../lib/horarios";

let sucursales = [];
try {
  const [rows] = (await pool.query(`
      SELECT 
          id,
          nombre as name,
          concepto as type,
          rating,
          resenas as reviews,
          direccion as address,
          horarios,
          telefono as whatsapp,
          capacidad_total,
          COALESCE(cubiertos_disponibles, capacidad_total) AS cubiertos_disponibles,
          COALESCE(cubiertos_ocupados, 0) AS cubiertos_ocupados,
          permite_reservas,
          permite_cubiertos
      FROM sucursales
      WHERE activo = 1
      ORDER BY nombre
  `)) as any[];

  sucursales = rows.map((s: any) => {
    let image = "/img/sucursales/beni.jpeg";
    let footerLogo = "/img/logo/LOGO1SF.png";
    let featured = false;
    let mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(s.name + " " + s.address)}`;

    if (
      s.name.includes("Churrasqueria") ||
      s.name.includes("Churrasquería") ||
      s.type.includes("Churrasquería")
    ) {
      image = "/img/sucursales/beni.jpeg";
      footerLogo = "/img/logo/LOGO1SF.png";
      mapUrl = "https://maps.app.goo.gl/9pjKcgmrKJvESw2f7?g_st=ac";
    } else if (s.name.includes("Fast Grill") || s.type.includes("Fast Grill")) {
      image = "/img/sucursales/fassGrill.jpeg";
      featured = true;
      footerLogo = "/img/logo/LOGO2SF.png";
      mapUrl = "https://maps.app.goo.gl/vZBQXjJqVpYPaL9TA?g_st=ac";
    } else if (s.name.includes("Rodizio")) {
      image = "/img/sucursales/RODIZIO.webp";
      footerLogo = "/img/logo/LOGO3SF.png";
      mapUrl = "https://maps.app.goo.gl/YL5CTgSqqguhKezc6?g_st=ac";
    }

    let hours: string[] | string = agruparHorarios(s.horarios);
    let status = "";

    return {
      ...s,
      image,
      mapUrl,
      footerLogo,
      featured,
      hours,
      status,
      rating: s.rating || 4.5,
      reviews: s.reviews ? s.reviews.toString() : "0",
    };
  });

  // Ordenar tarjetas: 1. Churrasquería, 2. Rodizio, 3. Fast Grill
  sucursales.sort((a: any, b: any) => {
    const nameA = (a.name || '').toLowerCase();
    const nameB = (b.name || '').toLowerCase();

    let orderA = 99;
    let orderB = 99;

    if (nameA.includes('churrasquer')) orderA = 1;
    else if (nameA.includes('rodizio')) orderA = 2;
    else if (nameA.includes('fast')) orderA = 3;

    if (nameB.includes('churrasquer')) orderB = 1;
    else if (nameB.includes('rodizio')) orderB = 2;
    else if (nameB.includes('fast')) orderB = 3;

    return orderA - orderB;
  });
} catch (error) {
  console.error("Error al cargar sucursales en SucursalesSection:", error);
}
