<script>
  // ============================================
  // GIF HOVER ANIMATION CONTROLLER (FROZEN UNLESS HOVERED)
  // ============================================
  function initGifHover() {
    const containers = document.querySelectorAll("[data-gif-container]");
    containers.forEach((container) => {
      if (container.hasAttribute("data-gif-inited")) return;
      container.setAttribute("data-gif-inited", "true");

      const img = container.querySelector("img.gif-hover");
      if (!img) return;

      // Create static canvas for frame 1
      const canvas = document.createElement("canvas");
      canvas.className =
        (img.className || "").replace("gif-hover", "") +
        " gif-static-canvas pointer-events-none";
      canvas.style.display = "block";

      img.style.display = "none";

      function drawFirstFrame() {
        if (!img.naturalWidth || !img.naturalHeight) return;
        canvas.width = img.naturalWidth;
        canvas.height = img.naturalHeight;
        const ctx = canvas.getContext("2d");
        if (ctx) {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        }
      }

      if (img.complete && img.naturalWidth > 0) {
        drawFirstFrame();
      } else {
        img.addEventListener("load", drawFirstFrame);
      }

      container.insertBefore(canvas, img);

      // Play animation on hover enter
      container.addEventListener("mouseenter", () => {
        canvas.style.display = "none";
        img.style.display = "block";
        const currentSrc = img.src;
        img.src = "";
        img.src = currentSrc;
      });

      // Freeze animation on hover leave
      container.addEventListener("mouseleave", () => {
        img.style.display = "none";
        canvas.style.display = "block";
      });
    });
  }

  if (typeof window !== "undefined") {
    const initReservaButtons = () => {
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        const btn = target?.closest(".btn-abrir-reserva");
        if (btn) {
          e.preventDefault();
          const sucursalId = btn.getAttribute("data-sucursal-id");
          const sucursalName = btn.getAttribute("data-sucursal-name");
          if (
            sucursalId &&
            typeof (window as any).abrirModalReserva === "function"
          ) {
            (window as any).abrirModalReserva(
              Number(sucursalId),
              sucursalName || "",
            );
          }
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        initGifHover();
        initReservaButtons();
      });
    } else {
      initGifHover();
      initReservaButtons();
    }
  }

