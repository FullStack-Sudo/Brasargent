  window.abrirModalReserva = function (sucursalId, sucursalNombre) {
    if (typeof (window as any).abrirTerminosModal === "function") {
      (window as any).abrirTerminosModal(sucursalId, sucursalNombre, () => {
        (window as any)._mostrarFormularioReserva(sucursalId, sucursalNombre);
      });
    } else {
      (window as any)._mostrarFormularioReserva(sucursalId, sucursalNombre);
    }
  };

  window._cargarTurnosModal = async function (sucursalId, fecha) {
    const containerEl = document.getElementById("turnosContainer");
    const gridEl = document.getElementById("turnosGrid");
    const horasWrap = document.getElementById("horasWrapper");
    const turnoInput = document.getElementById("turnoReserva");
    const horaInput = document.getElementById("horaReserva");
    const festivoAviso = document.getElementById("festivoAviso");
    const festivoMotivo = document.getElementById("festivoMotivo");
    const precioContainer = document.getElementById("precioContainer");
    const btnEnviar = document.getElementById("btnEnviarReserva");
    const fechaInput = document.getElementById(
      "fechaReserva",
    ) as HTMLInputElement;

    // Reset estado
    if (containerEl) containerEl.classList.remove("hidden");
    if (horasWrap) horasWrap.classList.add("hidden");
    if (gridEl)
      gridEl.innerHTML =
        '<div class="turnos-loading" style="padding: 1rem; text-align: center;"><div class="loading-spinner" style="border: 2px solid rgba(0,0,0,0.1); border-left-color: #9e2a2b; border-radius: 50%; width: 20px; height: 20px; animation: spin 1s linear infinite; display: inline-block;"></div></div>';

    const _relojH = document.getElementById("relojHora");
    const _relojM = document.getElementById("relojMinuto");
    if (_relojH) _relojH.innerHTML = "";
    if (_relojM) _relojM.innerHTML = "";

    if (turnoInput) turnoInput.value = "";
    if (horaInput) horaInput.value = "";

    // 🔴 1. Validar si la fecha permite reservas (Domingos/Festivos)
    try {
      const valRes = await fetch(
        `/api/precios/validar-reserva?sucursal_id=${sucursalId}&fecha=${fecha}`,
      );
      const valData = await valRes.json();

      const personasSections = document.querySelectorAll(".personas-section");
      const grupoBadges = document.querySelectorAll(".badge-grupo");
      const grupoBanner = document.querySelector(".grupo-grande-banner");
      const comentariosSection = document.querySelector(".comentarios-section");

      if (valData.success && !valData.permite_reservas) {
        if (fechaInput) fechaInput.classList.add("fecha-invalida-bloqueada");
        if (festivoMotivo)
          festivoMotivo.innerHTML =
            valData.motivo ||
            "Los domingos, días feriados y fechas cívicas trabajamos por orden de llegada (SIN reservas).";
        if (festivoAviso) festivoAviso.classList.remove("hidden");
        if (containerEl) containerEl.classList.add("hidden");
        if (horasWrap) horasWrap.classList.add("hidden");
        if (precioContainer) precioContainer.classList.add("hidden");

        // Ocultar sección de Adultos y Niños
        personasSections.forEach(
          (sec) => ((sec as HTMLElement).style.display = "none"),
        );
        // Ocultar badge de personas
        grupoBadges.forEach((b) => ((b as HTMLElement).style.display = "none"));
        // Ocultar banner de grupos grandes
        if (grupoBanner) (grupoBanner as HTMLElement).style.display = "none";
        // Ocultar caja de comentarios
        if (comentariosSection)
          (comentariosSection as HTMLElement).style.display = "none";

        if (btnEnviar) {
          (btnEnviar as HTMLButtonElement).disabled = true;
          (btnEnviar as HTMLElement).style.display = "none";
        }
        return;
      } else {
        if (fechaInput) fechaInput.classList.remove("fecha-invalida-bloqueada");
        if (festivoAviso) festivoAviso.classList.add("hidden");

        // Restaurar visualización en días normales
        personasSections.forEach(
          (sec) => ((sec as HTMLElement).style.display = ""),
        );
        grupoBadges.forEach((b) => ((b as HTMLElement).style.display = ""));
        if (grupoBanner) (grupoBanner as HTMLElement).style.display = "";
        if (comentariosSection)
          (comentariosSection as HTMLElement).style.display = "";

        if (btnEnviar) {
          (btnEnviar as HTMLButtonElement).disabled = false;
          (btnEnviar as HTMLElement).style.display = "";
        }
      }
    } catch (err) {
      console.error("Error validando feriado:", err);
    }

    // 🔴 2. Obtener Precios por cubierto para esta fecha
    try {
      const pRes = await fetch(
        `/api/precios?sucursal_id=${sucursalId}&fecha=${fecha}&hora=12:00`,
      );
      const pData = await pRes.json();
      if (pData.success && precioContainer) {
        precioContainer.classList.remove("hidden");
        const elAdulto = document.getElementById("precioAdulto");
        const elNino = document.getElementById("precioNino");
        if (elAdulto)
          elAdulto.textContent = `${pData.precio_adulto} Bs Adultos`;
        if (elNino)
          elNino.textContent = `${pData.precio_nino} Bs Niños (${pData.edad_minima || 5}-${pData.edad_maxima || 10} años)`;
      }
    } catch (err) {
      console.error("Error cargando precio:", err);
    }

    try {
      const response = await fetch(
        `/api/reservas/horas-disponibles?sucursal_id=${sucursalId}&fecha=${fecha}`,
      );
      const result = await response.json();

      if (!result.success || !result.data || !result.data.turnos) {
        if (gridEl)
          gridEl.innerHTML =
            '<span class="error-message" style="color: #ef4444; font-size: 0.9rem;">No se pudieron cargar los horarios para esta fecha.</span>';
        return;
      }

      const data = result.data;
      window._turnoData = data;

      const iconos = { manana: "☀️", tarde: "🌙", noche: "🌙", continuo: "🔁" };
      let html = "";

      if (data.turnos.length === 0) {
        html =
          '<span style="color: #666; font-size: 0.9rem; grid-column: 1 / -1; text-align: center; padding: 1rem;">No hay atención configurada en esta fecha.</span>';
      } else {
        data.turnos.forEach((turno) => {
          const icono = iconos[turno.tipo] || "🌙";
          const labelTurno = (turno.label || "").replace(
            "Turno Tarde",
            "Turno Noche",
          );

          // Renderizamos la tarjeta limpia, sin bloqueos ni barras de capacidad
          html += `
                    <button
                        type="button"
                        class="turno-card"
                        data-turno-tipo="${turno.tipo}"
                        onclick="window._seleccionarTurnoModal(this)"
                    >
                        <span class="turno-icono">${icono}</span>
                        <div class="turno-info">
                            <span class="turno-nombre">${labelTurno}</span>
                            <span class="turno-horario">${turno.inicio} – ${turno.fin}</span>
                        </div>
                    </button>
                `;
        });
      }

      if (gridEl) gridEl.innerHTML = html;
    } catch (error) {
      console.error("Error cargando turnos:", error);
      if (gridEl)
        gridEl.innerHTML =
          '<span class="error-message" style="color: #ef4444; font-size: 0.9rem;">Error de conexión. Intenta de nuevo.</span>';
    }
  };

  // Alias para mantener compatibilidad
  window._cargarHorasModal = window._cargarTurnosModal;

  // ============================================
  // SELECCIONAR TURNO Y CARGAR RELOJ DIGITAL
  // ============================================

  window._seleccionarTurnoModal = function (element) {
    if (element.disabled || element.classList.contains("turno-card--disabled"))
      return;

    const gridEl = document.getElementById("turnosGrid");
    const horasWrap = document.getElementById("horasWrapper");
    const turnoInput = document.getElementById("turnoReserva");
    const horaInput = document.getElementById("horaReserva");

    const selectHora = document.getElementById("relojHora");
    const selectMin = document.getElementById("relojMinuto");
    const relojInfo = document.getElementById("relojInfo");

    // Deseleccionar todos
    gridEl
      .querySelectorAll(".turno-card")
      .forEach((c) => c.classList.remove("turno-card--selected"));
    element.classList.add("turno-card--selected");

    const tipoTurno = element.dataset.turnoTipo;
    turnoInput.value = tipoTurno;

    // Ocultar error de turno
    const errorTurno = document.getElementById("errorTurno");
    if (errorTurno) errorTurno.style.display = "none";

    // Limpiar hora seleccionada anterior
    horaInput.value = "";

    // Obtener horas del turno seleccionado
    const data = window._turnoData;
    if (!data) return;

    const turno = data.turnos.find((t) => t.tipo === tipoTurno);
    if (!turno) return;

    // CONFIGURACIÓN DE HORARIOS POR TURNO
    const CONFIG_TURNOS = {
      manana: {
        label: "Turno Mañana",
        hora_apertura: "11:30",
        hora_cierre: "15:00",
        hora_limite_reserva: "14:30",
        horas_permitidas: ["11", "12", "13", "14"],
      },
      tarde: {
        label: "Turno Tarde / Noche",
        hora_apertura: "18:30",
        hora_cierre: "22:00",
        hora_limite_reserva: "21:30",
        horas_permitidas: ["18", "19", "20", "21"],
      },
      noche: {
        label: "Turno Noche",
        hora_apertura: "18:30",
        hora_cierre: "22:00",
        hora_limite_reserva: "21:30",
        horas_permitidas: ["18", "19", "20", "21"],
      },
    };

    // Extraer horas únicas permitidas para el turno seleccionado
    const cfgTurno = CONFIG_TURNOS[tipoTurno] || CONFIG_TURNOS["manana"];
    const horasEnTurno = turno.horas.map((h) => h.hora.split(":")[0]);
    const horasFiltradas = horasEnTurno.filter((h) =>
      cfgTurno.horas_permitidas.includes(h),
    );
    const horasUnicas = [
      ...new Set(
        horasFiltradas.length > 0 ? horasFiltradas : cfgTurno.horas_permitidas,
      ),
    ].sort();

    // Llenar select de horas y seleccionar la hora de apertura por defecto (11 o 18)
    const [aperturaHStr, aperturaMStr] = cfgTurno.hora_apertura.split(":");
    selectHora.innerHTML = horasUnicas
      .map((h) => `<option value="${h}">${h}</option>`)
      .join("");
    if (horasUnicas.includes(aperturaHStr)) {
      selectHora.value = aperturaHStr;
    }

    // Función para actualizar minutos según la hora seleccionada (restringiendo a rango de apertura/límite)
    function actualizarMinutos() {
      const [apH, apM] = cfgTurno.hora_apertura.split(":").map(Number);
      const [limH, limM] = (
        cfgTurno.hora_limite_reserva || cfgTurno.hora_cierre
      )
        .split(":")
        .map(Number);
      const horaSel = parseInt(selectHora.value, 10);

      let minInicio = 0;
      let minFin = 59;

      if (horaSel === apH) {
        minInicio = apM;
      }
      if (horaSel === limH) {
        minFin = limM;
      }

      const minutos = [];
      for (let i = minInicio; i <= minFin; i++) {
        minutos.push(String(i).padStart(2, "0"));
      }

      const prevMin = selectMin.value;
      selectMin.innerHTML = minutos
        .map((min) => `<option value="${min}">${min}</option>`)
        .join("");

      if (minutos.includes(prevMin)) {
        selectMin.value = prevMin;
      } else {
        selectMin.value = String(minInicio).padStart(2, "0");
      }

      actualizarValorFinal();
    }

    // Función para actualizar el valor final de la hora y su cupo
    function actualizarValorFinal() {
      const horaSel = selectHora.value;
      const minSel = selectMin.value;
      if (!horaSel || !minSel) {
        horaInput.value = "";
        if (relojInfo) relojInfo.innerHTML = "";
        return;
      }

      const horaCompleta = `${horaSel}:${minSel}`;
      const limiteMax = cfgTurno.hora_limite_reserva || cfgTurno.hora_cierre;

      // Verificar si la hora está dentro del rango del turno
      if (horaCompleta < cfgTurno.hora_apertura || horaCompleta > limiteMax) {
        horaInput.value = "";
        if (relojInfo) {
          relojInfo.style.display = "block";
          relojInfo.style.color = "#d97706";
          relojInfo.style.padding = "8px 12px";
          relojInfo.style.borderRadius = "8px";
          relojInfo.style.background = "#fffbeb";
          relojInfo.style.border = "1px solid #fcd34d";
          relojInfo.innerHTML = `⚠️ <strong>Hora fuera de turno:</strong> ${cfgTurno.label} opera desde las <strong>${cfgTurno.hora_apertura}</strong> hasta las <strong>${limiteMax}</strong>.`;
        }
        return;
      }

      horaInput.value = horaCompleta;

      const hObj =
        turno.horas.find((h) => h.hora === horaCompleta) ||
        (data.horas || []).find((h) => h.hora === horaCompleta);

      let capInfo = horasWrap.querySelector(".capacidad-info");
      if (!capInfo) {
        capInfo = document.createElement("div");
        capInfo.className = "capacidad-info";
        horasWrap.appendChild(capInfo);
      }

      if (hObj) {
        if (hObj.disponibles <= 0) {
          if (relojInfo) {
            relojInfo.style.display = "block";
            relojInfo.style.color = "#ef4444";
            relojInfo.style.padding = "8px 12px";
            relojInfo.style.borderRadius = "8px";
            relojInfo.style.background = "#fef2f2";
            relojInfo.style.border = "1px solid #fca5a5";
            relojInfo.innerHTML = `⚠️ <strong>Agotado:</strong> No hay cubiertos disponibles a las <strong>${horaCompleta}</strong>. Elige otro horario.`;
          }
          capInfo.innerHTML = `
                    <span class="info-disponibles" style="color: #ef4444; font-weight: 700;">⚠️ 0 cubiertos disponibles a las ${horaCompleta}</span>
                    <span class="info-total">📋 Capacidad total: ${data.capacidad_total}</span>
                `;
        } else {
          if (relojInfo) {
            relojInfo.style.display = "none";
            relojInfo.innerHTML = "";
          }
          capInfo.innerHTML = `
                    <span class="info-disponibles" style="color: #16a34a; font-weight: 600;">🪑 ${hObj.disponibles} cubiertos disponibles a las ${horaCompleta}</span>
                    <span class="info-total">📋 Capacidad total: ${data.capacidad_total}</span>
                `;
        }
      } else {
        if (relojInfo) relojInfo.style.display = "none";
        capInfo.innerHTML = `
                <span class="info-disponibles">🪑 ${data.disponibles_hoy} cubiertos disponibles hoy</span>
                <span class="info-total">📋 Capacidad total: ${data.capacidad_total}</span>
            `;
      }

      // Limpiar error de hora
      const errorHora = document.getElementById("errorHora");
      if (errorHora) errorHora.style.display = "none";
    }

    // Bindear eventos
    selectHora.onchange = actualizarMinutos;
    selectMin.onchange = actualizarValorFinal;

    // Inicializar minutos e info
    actualizarMinutos();

    // Mostrar sección con animación
    horasWrap.classList.remove("hidden");
    horasWrap.classList.add("horas-animate-in");
    setTimeout(() => horasWrap.classList.remove("horas-animate-in"), 400);
  };

  // ============================================
  // SELECCIONAR HORA (Mantenido por compatibilidad)
  // ============================================

  window._seleccionarHoraModal = function (element) {
    // Obsoleto por el nuevo Reloj Digital
  };

  // ============================================
  // CAMBIAR CANTIDAD ADULTOS/NIÑOS/BEBÉS
  // ============================================

  window._cambiarCantidad = function (inputId, delta, min = 0, max = 500) {
    const input = document.getElementById(inputId);
    if (!input) return;
    let valor = (parseInt(input.value) || 0) + delta;
    valor = Math.max(min, Math.min(max, valor));
    input.value = valor;
  };

  // ============================================
  // ENVIAR RESERVA - CON NIÑOS, TURNO Y VALIDACIÓN DE HORA
  // ============================================

  window.enviarReserva = async function (sucursalId, sucursalNombre) {
    const btn = document.getElementById("btnEnviarReserva");
    btn.classList.add("loading");
    btn.disabled = true;

    const nombre = document.getElementById("nombreCliente").value.trim();
    const telefono = document.getElementById("telefonoCliente").value.trim();
    const codigoPais = document.getElementById("codigoPais").value;
    const fecha = document.getElementById("fechaReserva").value;
    const turno = document.getElementById("turnoReserva").value;
    const hora = document.getElementById("horaReserva").value;
    const personas = parseInt(document.getElementById("personasReserva").value);
    const observaciones = document
      .getElementById("observacionesReserva")
      .value.trim();

    // 👶 Campos de niños
    const cantidadNinos =
      parseInt(document.getElementById("cantidadNinos")?.value) || 0;
    const necesitaSilla =
      document.getElementById("necesitaSilla")?.checked || false;

    // Validaciones en cliente
    if (!nombre || nombre.length < 3) {
      alert("❌ Por favor ingresa tu nombre completo");
      btn.classList.remove("loading");
      btn.disabled = false;
      return;
    }

    if (!telefono || telefono.length < 7) {
      alert("❌ Por favor ingresa un número de teléfono válido");
      btn.classList.remove("loading");
      btn.disabled = false;
      return;
    }

    if (!fecha) {
      alert("❌ Por favor selecciona una fecha");
      btn.classList.remove("loading");
      btn.disabled = false;
      return;
    }

    if (!turno) {
      alert("❌ Por favor selecciona un turno (Mañana/Noche)");
      btn.classList.remove("loading");
      btn.disabled = false;
      return;
    }

    if (!hora) {
      alert(
        "❌ Por favor selecciona una hora disponible de las opciones mostradas",
      );
      btn.classList.remove("loading");
      btn.disabled = false;
      return;
    }

    if (!personas || personas < 1) {
      alert("❌ Por favor ingresa el número de personas");
      btn.classList.remove("loading");
      btn.disabled = false;
      return;
    }

    const data = {
      sucursal_id: sucursalId,
      nombre_cliente: nombre,
      telefono: telefono,
      codigo_pais: codigoPais,
      telefono_completo: `${codigoPais}${telefono}`,
      fecha: fecha,
      turno: turno,
      hora: hora,
      numero_personas: personas,
      cantidad_ninos: cantidadNinos,
      necesita_silla_bebe: necesitaSilla,
      observaciones: observaciones || null,
    };

    try {
      const response = await fetch("/api/reservas/cliente", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (result.success) {
        window.cerrarModalReserva();
        window.mostrarModalConfirmacion(
          sucursalNombre,
          nombre,
          fecha,
          hora,
          personas,
          cantidadNinos,
          necesitaSilla,
          result.numero_reserva,
        );
      } else {
        alert("❌ " + (result.error || "Error al solicitar la reserva"));
        btn.classList.remove("loading");
        btn.disabled = false;
      }
    } catch (error) {
      alert("❌ Error de conexión. Intenta de nuevo.");
      btn.classList.remove("loading");
      btn.disabled = false;
    }
  };

  // ============================================
  // CERRAR MODAL
  // ============================================

  window.cerrarModalReserva = function () {
    const modal = document.getElementById("modalReservaCliente");
    if (modal) {
      modal.style.opacity = "0";
      setTimeout(() => {
        modal.remove();
        document.body.classList.remove("modal-open");
      }, 300);
    }
  };

  // ============================================
  // MODAL DE CONFIRMACIÓN
  // ============================================

  window.mostrarModalConfirmacion = function (
    sucursalNombre,
    nombreCliente,
    fecha,
    hora,
    personas,
    ninos,
    silla,
    numeroReserva,
  ) {
    // Construir HTML de niños si aplica
    let ninosHTML = "";
    if (ninos > 0) {
      ninosHTML += `<div class="confirmacion-item"><span class="confirmacion-label">👧 Niños:</span><span class="confirmacion-valor">${ninos}</span></div>`;
    }
    let prepHTML = "";
    if (silla) {
      prepHTML = `<div class="confirmacion-item"><span class="confirmacion-label">📋 Preparación:</span><span class="confirmacion-valor">🪑 Silla para niños</span></div>`;
    }

    const modalHTML = `
        <div class="modal-overlay modal-confirmacion" id="modalConfirmacion" onclick="window.cerrarModalConfirmacion()">
            <div class="modal-container modal-confirmacion-container" onclick="event.stopPropagation()">
                <div class="modal-confirmacion-content">
                    <div class="confirmacion-icono">✅</div>
                    <h2>¡Reserva Solicitada!</h2>
                    <p>En breves momentos confirmaremos tu reserva en <strong>${sucursalNombre}</strong></p>
                    <p style="font-size: 0.9rem; color: #25d366;">
                        💬 Espera tu mensaje de confirmación por <strong>WhatsApp</strong>
                    </p>
                    <div class="confirmacion-detalles">
                        ${
                          numeroReserva
                            ? `
                        <div class="confirmacion-item" style="border-bottom: 1px dashed rgba(26,26,26,0.12); padding-bottom: 8px; margin-bottom: 8px;">
                            <span class="confirmacion-label" style="font-weight: 700; color: #9e2a2b;">📋 Nº de Reserva:</span>
                            <span class="confirmacion-valor" style="font-family: monospace; font-weight: 700; color: #9e2a2b; background: rgba(158,42,43,0.1); padding: 3px 10px; border-radius: 6px; font-size: 1.05rem;">
                                ${numeroReserva}
                            </span>
                        </div>
                        `
                            : ""
                        }
                        <div class="confirmacion-item">
                            <span class="confirmacion-label">Cliente:</span>
                            <span class="confirmacion-valor">${nombreCliente}</span>
                        </div>
                        <div class="confirmacion-item">
                            <span class="confirmacion-label">Fecha:</span>
                            <span class="confirmacion-valor">${new Date(fecha + "T12:00:00").toLocaleDateString("es-ES")}</span>
                        </div>
                        <div class="confirmacion-item">
                            <span class="confirmacion-label">Hora:</span>
                            <span class="confirmacion-valor">${hora}</span>
                        </div>
                        <div class="confirmacion-item">
                            <span class="confirmacion-label">Adultos:</span>
                            <span class="confirmacion-valor">${personas || 2}</span>
                        </div>
                        ${ninosHTML}
                        ${prepHTML}
                    </div>
                    <button class="btn-confirmacion" onclick="window.cerrarModalConfirmacion()">
                        ¡Entendido!
                    </button>
                </div>
            </div>
        </div>
    `;

    document.body.insertAdjacentHTML("beforeend", modalHTML);
    document.body.classList.add("modal-open");

    setTimeout(() => {
      window.cerrarModalConfirmacion();
    }, 8000);
  };

  window.cerrarModalConfirmacion = function () {
    const modal = document.getElementById("modalConfirmacion");
    if (modal) {
      modal.style.opacity = "0";
      setTimeout(() => {
        modal.remove();
        document.body.classList.remove("modal-open");
      }, 300);
    }
  };

  // Cerrar con ESC
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
      window.cerrarModalReserva();
      window.cerrarModalConfirmacion();
    }
  });
</script>

