---
// src/components/TerminosModal.astro
// Modal de Términos y Condiciones por Sucursal
---

<!-- 🔴 MODAL DE TÉRMINOS Y CONDICIONES POR SUCURSAL -->
<div id="terminosModal" class="terminos-modal-overlay" style="display: none;">
    <div class="terminos-modal-container">
        <!-- Botón de cerrar -->
        <button class="terminos-modal-close" id="btnCerrarTerminos" aria-label="Cerrar" title="Cerrar">
            ✕
        </button>

        <!-- Encabezado del Modal -->
        <div class="terminos-modal-header">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#9e2a2b]/10 rounded-full mb-1">
                <span class="w-2 h-2 rounded-full bg-[#9e2a2b] animate-ping"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-[#9e2a2b]">Condiciones de Reserva</span>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-gray-900 mt-1 font-serif">
                Términos y condiciones en la sucursal <span id="terminosNombreSucursal" class="text-[#9e2a2b]">...</span>
            </h2>
            <p class="text-xs md:text-sm text-gray-600 mt-1">
                Por favor lee y acepta las condiciones antes de solicitar tu reserva.
            </p>
        </div>

        <!-- Lista de Términos -->
        <div class="terminos-modal-body">
            <div class="terminos-lista-grid">
                <!-- Tiempo de espera -->
                <div class="termino-card-item">
                    <div class="termino-info">
                        <span class="termino-label">Puntualidad</span>
                        <p class="termino-value">Tiempo de espera de <strong>10 Minutos</strong>.</p>
                    </div>
                </div>

                <!-- Todos los comensales -->
                <div class="termino-card-item">
                    <div class="termino-info">
                        <span class="termino-label">Ingreso de grupo</span>
                        <p class="termino-value">Para ingresar deben de estar <strong>todos los comensales</strong>.</p>
                    </div>
                </div>

                <!-- Liberación de cubiertos -->
                <div class="termino-card-item">
                    <div class="termino-info">
                        <span class="termino-label">Tolerancia</span>
                        <p class="termino-value">Si no llegan a tiempo <strong>se liberan los cubiertos</strong>.</p>
                    </div>
                </div>

                <!-- Edad 0 a 5 años -->
                <div class="termino-card-item">
                    <div class="termino-info">
                        <span class="termino-label">Niños pequeños</span>
                        <p class="termino-value"><strong>No pagan</strong> de 0 a 5 años.</p>
                    </div>
                </div>

                <!-- Edad 5 a 10 años -->
                <div class="termino-card-item">
                    <div class="termino-info">
                        <span class="termino-label">Niños</span>
                        <p class="termino-value"><strong>Pagan tarifa especial</strong> de 5 a 10 años.</p>
                    </div>
                </div>

                <!-- Feriados y domingos -->
                <div class="termino-card-item termino-card-highlight">
                    <div class="termino-info">
                        <span class="termino-label text-red-800 font-bold">Atención sin Reserva</span>
                        <p class="termino-value text-red-900"><strong>Domingos, Feriados y Días festivos</strong> trabajamos por orden de llegada (sin reserva).</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones de Acción -->
        <div class="terminos-modal-actions">
            <button 
                id="btnAceptarTerminos"
                class="terminos-btn-terminos btn-aceptar"
            >
                Aceptar y Continuar
            </button>
            <button 
                id="btnCancelarTerminos"
                class="terminos-btn-terminos btn-volver"
            >
                Cancelar
            </button>
        </div>

        <!-- Footer Informativo -->
        <p class="terminos-modal-footer">
            Al continuar declaras estar de acuerdo con las condiciones de la sucursal.
        </p>
    </div>
</div>

<!-- SCRIPT DEL MODAL DE TÉRMINOS -->
<script>
    if (typeof window !== 'undefined') {
        let pendingAceptarCallback: (() => void) | null = null;

        (window as any).abrirTerminosModal = function(sucursalId: number, sucursalNombre: string, callback: () => void) {
            const modal = document.getElementById('terminosModal');
            const titleSucursal = document.getElementById('terminosNombreSucursal');
            pendingAceptarCallback = callback;

            if (titleSucursal) {
                titleSucursal.textContent = sucursalNombre;
            }

            if (modal) {
                modal.style.display = 'flex';
                document.body.classList.add('modal-open');
            }
        };

        (window as any).cerrarTerminosModal = function() {
            const modal = document.getElementById('terminosModal');
            if (modal) {
                modal.classList.add('terminos-modal-fade-out');
                setTimeout(() => {
                    modal.style.display = 'none';
                    modal.classList.remove('terminos-modal-fade-out');
                    document.body.classList.remove('modal-open');
                }, 300);
            }
            pendingAceptarCallback = null;
        };

        document.addEventListener('DOMContentLoaded', () => {
            const btnAceptar = document.getElementById('btnAceptarTerminos');
            const btnCancelar = document.getElementById('btnCancelarTerminos');
            const btnCerrar = document.getElementById('btnCerrarTerminos');

            btnAceptar?.addEventListener('click', () => {
                const cb = pendingAceptarCallback;
                (window as any).cerrarTerminosModal();
                if (cb && typeof cb === 'function') {
                    cb();
                }
            });

            btnCancelar?.addEventListener('click', () => {
                (window as any).cerrarTerminosModal();
            });

            btnCerrar?.addEventListener('click', () => {
                (window as any).cerrarTerminosModal();
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    const modal = document.getElementById('terminosModal');
                    if (modal && modal.style.display !== 'none') {
                        (window as any).cerrarTerminosModal();
                    }
                }
            });
        });
    }
</script>

<style>
    /* OVERLAY PRINCIPAL */
    .terminos-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10001;
        padding: 16px;
        animation: terminosFadeIn 0.3s ease;
    }

    @keyframes terminosFadeIn {
        from {
            opacity: 0;
            transform: scale(0.96);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .terminos-modal-fade-out {
        animation: terminosFadeOut 0.3s ease forwards;
    }

    @keyframes terminosFadeOut {
        from {
            opacity: 1;
            transform: scale(1);
        }
        to {
            opacity: 0;
            transform: scale(0.96);
        }
    }

    /* CONTENEDOR DEL MODAL */
    .terminos-modal-container {
        position: relative;
        max-width: 680px;
        width: 100%;
        max-height: 92vh;
        background: #fffaf0;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.2);
        animation: terminosSlideUp 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        display: flex;
        flex-direction: column;
    }

    @keyframes terminosSlideUp {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.97);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* BOTÓN CERRAR */
    .terminos-modal-close {
        position: absolute;
        top: 16px;
        right: 18px;
        background: rgba(0, 0, 0, 0.06);
        border: 1px solid rgba(0, 0, 0, 0.1);
        color: #1a1a1a;
        font-size: 1.1rem;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 20;
    }

    .terminos-modal-close:hover {
        background: rgba(158, 42, 43, 0.9);
        color: #ffffff;
        transform: rotate(90deg);
    }

    /* ENCABEZADO DEL MODAL */
    .terminos-modal-header {
        padding: 24px 28px 16px;
        background: #fffaf0;
        border-bottom: 1px solid rgba(26, 26, 26, 0.06);
    }

    /* BODY Y TARJETAS */
    .terminos-modal-body {
        padding: 20px 28px;
        overflow-y: auto;
        max-height: 60vh;
    }

    .terminos-lista-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .termino-card-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        background: #ffffff;
        border: 1.5px solid rgba(26, 26, 26, 0.07);
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
        transition: all 0.25s ease;
    }

    .termino-card-item:hover {
        border-color: rgba(158, 42, 43, 0.3);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
    }

    .termino-card-highlight {
        grid-column: 1 / -1;
        background: #fef2f2;
        border-color: #fecaca;
    }

    .termino-icon-box {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    .termino-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .termino-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #888;
    }

    .termino-value {
        font-size: 0.85rem;
        color: #2c2c2c;
        margin: 0;
        line-height: 1.35;
    }

    /* BOTONES DE ACCIÓN */
    .terminos-modal-actions {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 14px;
        padding: 18px 28px;
        background: #fffaf0;
        border-top: 1px solid rgba(26, 26, 26, 0.08);
    }

    .terminos-btn-terminos {
        padding: 14px 20px;
        border: none;
        border-radius: 14px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: 'Inter', sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-aceptar {
        background: linear-gradient(135deg, #9e2a2b, #7a2021);
        color: #fffaf0;
        box-shadow: 0 6px 20px rgba(158, 42, 43, 0.35);
    }

    .btn-aceptar:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(158, 42, 43, 0.45);
    }

    .btn-volver {
        background: #ffffff;
        color: #4a4a54;
        border: 1.5px solid rgba(26, 26, 26, 0.15);
    }

    .btn-volver:hover {
        background: rgba(26, 26, 26, 0.05);
        color: #1a1a1f;
    }

    /* FOOTER INFORMATIVO */
    .terminos-modal-footer {
        padding: 10px 28px 18px;
        background: #fffaf0;
        text-align: center;
        font-size: 0.72rem;
        color: rgba(26, 26, 26, 0.45);
        margin: 0;
    }

    /* RESPONSIVE */
    @media (max-width: 640px) {
        .terminos-lista-grid {
            grid-template-columns: 1fr;
        }

        .terminos-modal-actions {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .terminos-modal-header {
            padding: 20px 20px 14px;
        }

        .terminos-modal-body {
            padding: 16px 20px;
        }

        .terminos-modal-actions {
            padding: 14px 20px;
        }
    }
</style>
