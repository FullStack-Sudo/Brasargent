---
// src/components/admin/BurbujaReservasDia.astro
// Burbuja flotante para reservas del dia (sin emojis)
---

<button
    id="burbujaReservasDia"
    class="burbuja-reservas-dia"
    type="button"
    data-action="abrir-modal-reservas-dia"
    aria-label="Ver reservas del dia"
    title="Reservas del Dia"
>
    <svg class="burbuja-icono" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
    </svg>
    <span class="burbuja-badge" id="burbujaReservasDiaBadge" style="display: none;">0</span>
    <span class="burbuja-pulso"></span>
</button>

<script>
function moverABodyReservasDia() {
    const el = document.getElementById('burbujaReservasDia');
    if (el && el.parentElement !== document.body) {
        document.body.appendChild(el);
    }
    const modal = document.getElementById('modalReservasDia');
    if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
    }
}

function abrirModalReservasDia() {
    moverABodyReservasDia();
    const modal = document.getElementById('modalReservasDia');
    if (modal) {
        modal.style.display = 'flex';
        modal.style.zIndex = '9999999';
        document.body.style.overflow = 'hidden';
        if (typeof (window as any).cargarReservasDia === 'function') {
            (window as any).cargarReservasDia();
        }
    }
}

async function cargarBadgeReservasDia() {
    moverABodyReservasDia();
    try {
        const response = await fetch('/api/reservas-dia');
        const data = await response.json();
        if (data.success && data.estadisticas) {
            const count = data.estadisticas.total_pendientes || 0;
            const badge = document.getElementById('burbujaReservasDiaBadge');
            if (badge) {
                badge.textContent = String(count);
                badge.style.display = count > 0 ? 'flex' : 'none';
            }
            const btnBadge = document.getElementById('btnReservasDiaHeaderBadge');
            if (btnBadge) {
                btnBadge.textContent = String(count);
                btnBadge.style.display = count > 0 ? 'inline-flex' : 'none';
            }
        }
    } catch (error) {
        console.error('Error cargando badge de reservas del dia:', error);
    }
}

(window as any).abrirModalReservasDia = abrirModalReservasDia;
(window as any).cargarBadgeReservasDia = cargarBadgeReservasDia;

document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest('#burbujaReservasDia, [data-action="abrir-modal-reservas-dia"]');
    if (target) {
        e.preventDefault();
        e.stopPropagation();
        abrirModalReservasDia();
    }
});

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
        moverABodyReservasDia();
        cargarBadgeReservasDia();
    });
} else {
    moverABodyReservasDia();
    cargarBadgeReservasDia();
}

setInterval(cargarBadgeReservasDia, 60000);
</script>

<style is:global>
/* ============================================
   BURBUJA RESERVAS DEL DIA
   ============================================ */
.burbuja-reservas-dia {
    position: fixed !important;
    bottom: 110px !important;
    right: 32px !important;
    width: 64px !important;
    height: 64px !important;
    border-radius: 50% !important;
    background: linear-gradient(135deg, #C9A87C, #B89A6E) !important;
    border: 2px solid #FFFFFF !important;
    color: #1A1A1A !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow:
        0 8px 32px rgba(201, 168, 124, 0.4),
        0 0 0 1px rgba(255, 255, 255, 0.15) !important;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    z-index: 999998 !important;
}

.burbuja-reservas-dia:hover {
    transform: scale(1.1) translateY(-4px) !important;
    box-shadow:
        0 12px 48px rgba(201, 168, 124, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.25) !important;
}

.burbuja-reservas-dia:active {
    transform: scale(0.95) !important;
}

.burbuja-icono {
    position: relative;
    z-index: 2;
    stroke: #1A1A1A;
    pointer-events: none;
}

.burbuja-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 24px;
    height: 24px;
    padding: 0 6px;
    border-radius: 12px;
    background: #8B1A1A;
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #FFFFFF;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    z-index: 3;
    pointer-events: none;
}

.burbuja-pulso {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(201, 168, 124, 0.4);
    animation: pulsoReservasDia 2s ease-in-out infinite;
    z-index: 1;
    pointer-events: none;
}

.burbuja-pulso::before {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: rgba(201, 168, 124, 0.2);
    animation: pulsoReservasDia 2s ease-in-out infinite 0.5s;
}

@keyframes pulsoReservasDia {
    0% {
        transform: scale(1);
        opacity: 1;
    }
    50% {
        transform: scale(1.3);
        opacity: 0;
    }
    100% {
        transform: scale(1);
        opacity: 0;
    }
}

/* Responsive */
@media (max-width: 768px) {
    .burbuja-reservas-dia {
        bottom: 155px !important;
        right: 18px !important;
        width: 58px !important;
        height: 58px !important;
    }
    
    .burbuja-icono {
        width: 20px;
        height: 20px;
    }
    
    .burbuja-badge {
        min-width: 20px;
        height: 20px;
        font-size: 0.65rem;
    }
}
</style>
