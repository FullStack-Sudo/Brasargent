---
// ModalCrearPlato.astro
import { getCategorias } from '../../lib/queries/menu';

const categoriasList = await getCategorias();
---
<div class="modal-overlay fixed inset-0 z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 p-3 sm:p-6" id="modalCrearPlato">
    <!-- Backdrop Overlay -->
    <div class="absolute inset-0 bg-black/60 backdrop-blur-md" id="modalCrearOverlay"></div>

    <!-- Modal Container -->
    <div class="modal-container relative bg-white rounded-3xl w-full max-w-[780px] max-h-[92vh] flex flex-col shadow-[0_25px_60px_-15px_rgba(0,0,0,0.4)] transform scale-95 transition-all duration-300 overflow-hidden z-10 border border-gray-100">
        
        <!-- Header Sticky -->
        <div class="modal-header px-6 py-4 sm:px-8 sm:py-4.5 border-b border-gray-100 flex items-center justify-between bg-white shrink-0">
            <div class="flex items-center gap-3.5">
                <div class="w-10 h-10 rounded-2xl bg-[#9e2a2b]/10 text-[#9e2a2b] flex items-center justify-center text-xl font-bold shrink-0">
                    🍳
                </div>
                <div>
                    <h2 class="modal-title-text font-serif font-bold text-gray-900 text-lg sm:text-xl m-0 tracking-tight">Añadir Nuevo Plato al Menú</h2>
                    <p class="modal-subtitle-text text-gray-400 text-xs sm:text-sm m-0 mt-0.5">Completa la información para incluirlo en el menú</p>
                </div>
            </div>
            <button type="button" class="modal-close-btn w-9 h-9 rounded-xl bg-gray-100 text-gray-500 hover:bg-gray-200 hover:text-gray-800 flex items-center justify-center transition-all border-0 cursor-pointer" id="btnCerrarModalCrear" title="Cerrar modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        
        <!-- Body Scrollable -->
        <div class="modal-body-scroll overflow-y-auto px-6 py-5 sm:px-8 sm:py-6">
            <form id="formCrearPlato" class="space-y-6">
                <input type="hidden" name="sucursal_id" id="create_sucursal_id" />
                
                <!-- Main Grid Layout: 2 Columns on Desktop -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                    
                    <!-- Left Column: Imagen y Destacado (5 cols) -->
                    <div class="md:col-span-5 flex flex-col justify-start">
                        <label class="block font-semibold text-gray-700 text-xs sm:text-sm mb-2 uppercase tracking-wider">
                            📷 Imagen del Plato
                        </label>
                        <div class="upload-area border-2 border-dashed border-gray-200 rounded-2xl p-4 text-center cursor-pointer transition-all bg-gray-50/70 hover:bg-[#9e2a2b]/5 hover:border-[#9e2a2b]/40 min-h-[200px] flex flex-col items-center justify-center relative group" id="dropZone">
                            
                            <div class="upload-content flex flex-col items-center justify-center py-2" id="uploadContent">
                                <div class="w-12 h-12 rounded-2xl bg-white shadow-sm border border-gray-100 flex items-center justify-center text-2xl mb-2.5 group-hover:scale-110 transition-transform">
                                    📸
                                </div>
                                <p class="text-gray-700 font-semibold text-xs sm:text-sm m-0 mb-1">Haz clic o arrastra una imagen</p>
                                <span class="text-gray-400 text-[11px]">PNG, JPG, WEBP • Máx 2MB</span>
                            </div>
                            
                            <input type="file" id="imagenInput" name="imagen" accept="image/*" class="hidden" />
                            
                            <div id="previewContainer" class="hidden relative w-full h-full min-h-[180px] flex items-center justify-center" style="display: none;">
                                <img id="previewImage" alt="Vista previa" class="max-h-[170px] w-full object-cover rounded-xl shadow-md border border-gray-100" />
                                <button type="button" id="removeImage" class="absolute -top-2 -right-2 w-7 h-7 rounded-full bg-red-500 text-white flex items-center justify-center hover:bg-red-600 transition-all shadow-md text-xs font-bold border-0 cursor-pointer">✕</button>
                            </div>
                        </div>
                        
                        <!-- Switch Destacado -->
                        <div class="mt-4 p-3.5 bg-amber-50/60 border border-amber-200/60 rounded-2xl">
                            <label class="flex items-center justify-between cursor-pointer select-none">
                                <div class="flex items-center gap-2.5">
                                    <span class="text-lg">🔥</span>
                                    <div>
                                        <span class="block text-gray-900 font-semibold text-xs sm:text-sm">Plato Destacado</span>
                                        <span class="block text-gray-500 text-[11px]">Badge "🔥 Destacado" en el menú</span>
                                    </div>
                                </div>
                                <div class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" name="destacado" id="create_destacado" class="sr-only peer" value="1" />
                                    <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#9e2a2b]"></div>
                                </div>
                            </label>
                        </div>
                    </div>
                    
                    <!-- Right Column: Form Fields (7 cols) -->
                    <div class="md:col-span-7 flex flex-col space-y-4">
                        <label class="block font-semibold text-gray-700 text-xs sm:text-sm mb-0.5 uppercase tracking-wider">
                            📝 Información del Plato
                        </label>
                        
                        <!-- Nombre del Plato -->
                        <div>
                            <label for="create_nombre" class="block font-medium text-gray-700 text-xs sm:text-sm mb-1">
                                Nombre del Plato <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="create_nombre" name="nombre" placeholder="Ej: Picaña Premium Especial" maxlength="100" required 
                                class="form-field-input w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-900 focus:bg-white focus:outline-none focus:border-[#9e2a2b] focus:ring-2 focus:ring-[#9e2a2b]/15 transition-all placeholder:text-gray-400" />
                        </div>
                        
                        <!-- Categoría y Precio Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label for="create_categoria" class="block font-medium text-gray-700 text-xs sm:text-sm mb-1">
                                    Categoría <span class="text-red-500">*</span>
                                </label>
                                <select id="create_categoria" name="categoria_id" required
                                    class="form-field-input w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-900 focus:bg-white focus:outline-none focus:border-[#9e2a2b] focus:ring-2 focus:ring-[#9e2a2b]/15 transition-all">
                                    <option value="">Seleccionar categoría</option>
                                    {categoriasList.map((cat: any) => (
                                        <option value={cat.id}>{cat.nombre}</option>
                                    ))}
                                </select>
                            </div>
                            
                            <div>
                                <label for="create_precio" class="block font-medium text-gray-700 text-xs sm:text-sm mb-1">
                                    Precio (Bs.) <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-semibold text-xs select-none">Bs.</span>
                                    <input type="number" id="create_precio" name="precio" placeholder="120.00" step="0.50" min="0" required 
                                        class="form-field-input w-full py-2.5 pr-3 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-900 font-semibold focus:bg-white focus:outline-none focus:border-[#9e2a2b] focus:ring-2 focus:ring-[#9e2a2b]/15 transition-all placeholder:text-gray-300" style="padding-left: 2.4rem !important;" />
                                </div>
                            </div>
                        </div>
                        
                        <!-- Descripción -->
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label for="create_descripcion" class="block font-medium text-gray-700 text-xs sm:text-sm">
                                    Descripción
                                </label>
                                <span class="text-[11px] text-gray-400" id="charCounter">0/500</span>
                            </div>
                            <textarea id="create_descripcion" name="descripcion" rows="3" placeholder="Ingredientes principales, preparación o detalles..." maxlength="500"
                                class="form-field-input w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-900 focus:bg-white focus:outline-none focus:border-[#9e2a2b] focus:ring-2 focus:ring-[#9e2a2b]/15 transition-all placeholder:text-gray-400 resize-none"></textarea>
                        </div>
                    </div>
                </div>
                
                <!-- Bottom Section: Sucursales -->
                <div class="mt-4 pt-4 border-t border-gray-100">
                    <label class="block font-medium text-gray-800 text-xs sm:text-sm mb-2">
                        Sucursales disponibles <span class="text-red-500">*</span>
                    </label>
                    <div class="sucursales-grid grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                        <label class="sucursal-chip flex items-center gap-2.5 p-2.5 px-3.5 bg-gray-50 border border-gray-200 rounded-xl cursor-pointer transition-all hover:bg-gray-100 [&:has(:checked)]:bg-[#9e2a2b]/10 [&:has(:checked)]:border-[#9e2a2b]">
                            <input type="checkbox" name="sucursales" value="1" class="accent-[#9e2a2b] w-4 h-4 rounded" checked />
                            <span class="text-sm">🔥</span>
                            <span class="font-medium text-gray-800 text-xs sm:text-sm">Churrasquería</span>
                        </label>
                        <label class="sucursal-chip flex items-center gap-2.5 p-2.5 px-3.5 bg-gray-50 border border-gray-200 rounded-xl cursor-pointer transition-all hover:bg-gray-100 [&:has(:checked)]:bg-[#9e2a2b]/10 [&:has(:checked)]:border-[#9e2a2b]">
                            <input type="checkbox" name="sucursales" value="2" class="accent-[#9e2a2b] w-4 h-4 rounded" checked />
                            <span class="text-sm">⚡</span>
                            <span class="font-medium text-gray-800 text-xs sm:text-sm">Fast Grill</span>
                        </label>
                        <label class="sucursal-chip flex items-center gap-2.5 p-2.5 px-3.5 bg-gray-50 border border-gray-200 rounded-xl cursor-pointer transition-all hover:bg-gray-100 [&:has(:checked)]:bg-[#9e2a2b]/10 [&:has(:checked)]:border-[#9e2a2b]">
                            <input type="checkbox" name="sucursales" value="3" class="accent-[#9e2a2b] w-4 h-4 rounded" checked />
                            <span class="text-sm">🥩</span>
                            <span class="font-medium text-gray-800 text-xs sm:text-sm">Rodizio</span>
                        </label>
                    </div>
                </div>
                
                <div id="formError" class="hidden mt-3 p-3 bg-red-50 text-red-600 rounded-xl border border-red-200 text-xs font-medium"></div>
            </form>
        </div>
        
        <!-- Footer Sticky -->
        <div class="modal-footer px-6 py-4 sm:px-8 sm:py-4 border-t border-gray-100 flex items-center justify-end gap-3 bg-gray-50/80 shrink-0">
            <button type="button" class="px-5 py-2.5 bg-white text-gray-700 border border-gray-200 rounded-xl text-xs sm:text-sm font-semibold hover:bg-gray-100 transition-colors shadow-sm cursor-pointer" id="btnCancelarCrear">
                Cancelar
            </button>
            <button type="submit" form="formCrearPlato" class="px-6 py-2.5 bg-gradient-to-r from-[#9e2a2b] to-[#7a2021] text-white rounded-xl text-xs sm:text-sm font-semibold shadow-[0_4px_14px_rgba(158,42,43,0.35)] hover:shadow-[0_6px_20px_rgba(158,42,43,0.45)] hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer min-w-[140px] flex items-center justify-center gap-2 border-0" id="btnGuardarCrear">
                <span class="btn-text">Guardar Plato</span>
                <svg class="btn-spinner hidden w-4 h-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            </button>
        </div>
    </div>
</div>

<style>
    /* Enforce scoped typography so global.css does not force giant clamp sizes */
    #modalCrearPlato h2.modal-title-text {
        font-size: 1.25rem !important;
        line-height: 1.3 !important;
        margin: 0 !important;
        font-family: 'Playfair Display', Georgia, serif !important;
    }
    #modalCrearPlato p.modal-subtitle-text {
        font-size: 0.85rem !important;
        line-height: 1.4 !important;
        margin: 0 !important;
    }
    #modalCrearPlato label {
        font-size: 0.8rem !important;
        line-height: 1.4 !important;
    }
    #modalCrearPlato .form-field-input {
        font-size: 0.875rem !important;
        line-height: 1.4 !important;
    }

    .modal-active {
        opacity: 1 !important;
        pointer-events: auto !important;
    }
    .modal-active > .modal-container {
        transform: scale(1) translateY(0) !important;
        opacity: 1 !important;
    }
    .form-group input.error,
    .form-group select.error {
        border-color: #ef4444 !important;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15) !important;
    }
</style>

<script>
    // Validaciones del frontend
    const form = document.getElementById('formCrearPlato') as HTMLFormElement;
    const desc = document.getElementById('create_descripcion') as HTMLTextAreaElement;
    const charCounter = document.getElementById('charCounter');
    
    if (desc && charCounter) {
        desc.addEventListener('input', () => {
            charCounter.textContent = `${desc.value.length}/500`;
        });
    }

    // Lógica de Image Upload
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('imagenInput') as HTMLInputElement;
    const previewContainer = document.getElementById('previewContainer');
    const previewImage = document.getElementById('previewImage') as HTMLImageElement;
    const uploadContent = document.getElementById('uploadContent');
    const removeImageBtn = document.getElementById('removeImage');

    function handleFile(file: File) {
        if (!file || !file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = (e) => {
            if(e.target?.result && previewImage && previewContainer && uploadContent) {
                previewImage.src = e.target.result as string;
                previewContainer.classList.remove('hidden');
                previewContainer.style.display = 'flex';
                uploadContent.classList.add('hidden');
                uploadContent.style.display = 'none';
            }
        };
        reader.readAsDataURL(file);
    }

    if (dropZone && fileInput) {
        dropZone.addEventListener('click', (e) => {
            if (e.target !== removeImageBtn) {
                fileInput.click();
            }
        });

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-[#9e2a2b]', 'bg-[#9e2a2b]/5');
        });

        dropZone.addEventListener('dragleave', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-[#9e2a2b]', 'bg-[#9e2a2b]/5');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-[#9e2a2b]', 'bg-[#9e2a2b]/5');
            if (e.dataTransfer?.files.length) {
                const dt = new DataTransfer();
                dt.items.add(e.dataTransfer.files[0]);
                fileInput.files = dt.files;
                handleFile(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files?.length) {
                handleFile(fileInput.files[0]);
            }
        });
    }

    if (removeImageBtn) {
        removeImageBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (fileInput) fileInput.value = '';
            if (previewContainer) {
                previewContainer.classList.add('hidden');
                previewContainer.style.display = 'none';
            }
            if (uploadContent) {
                uploadContent.classList.remove('hidden');
                uploadContent.style.display = 'flex';
            }
            if (previewImage) previewImage.removeAttribute('src');
        });
    }
</script>
