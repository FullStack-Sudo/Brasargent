---
import { getCategorias } from '../../lib/queries/menu';

const categoriasList = await getCategorias();
---

<div id="modalEditarPlato" class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 p-4">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-md" id="modalEditarOverlay"></div>
    
    <div class="relative bg-white rounded-3xl w-full max-w-lg shadow-[0_25px_60px_-15px_rgba(0,0,0,0.4)] transform scale-95 transition-all duration-300 overflow-hidden border border-gray-100" id="modalEditarContent">
        <!-- Header -->
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-white">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-[#9e2a2b]/10 text-[#9e2a2b] flex items-center justify-center text-lg font-bold">
                    ✏️
                </div>
                <h3 class="modal-edit-title font-serif font-bold text-gray-900 text-lg m-0">Editar Plato</h3>
            </div>
            <button id="btnCerrarModalEditar" type="button" class="w-8 h-8 rounded-xl bg-gray-100 text-gray-500 hover:bg-gray-200 hover:text-gray-800 flex items-center justify-center transition-all border-0 cursor-pointer">
                ✕
            </button>
        </div>
        
        <form id="formEditarPlato" class="p-6 space-y-4">
            <input type="hidden" id="edit_plato_id" name="plato_id" />
            
            <div>
                <label for="edit_nombre" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Nombre del Plato</label>
                <input 
                    type="text" 
                    id="edit_nombre" 
                    name="nombre" 
                    class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 text-sm focus:bg-white focus:ring-2 focus:ring-[#9e2a2b]/15 focus:border-[#9e2a2b] outline-none transition-all"
                    required 
                    maxlength="100"
                />
            </div>
            
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="edit_categoria" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Categoría</label>
                    <select 
                        id="edit_categoria" 
                        name="categoria_id"
                        class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 text-sm focus:bg-white focus:ring-2 focus:ring-[#9e2a2b]/15 focus:border-[#9e2a2b] outline-none transition-all"
                    >
                        <option value="">Seleccionar categoría</option>
                        {categoriasList.map((cat: any) => (
                            <option value={cat.id}>{cat.nombre}</option>
                        ))}
                    </select>
                </div>
                <div>
                    <label for="edit_precio" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Precio (Bs.)</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-semibold text-xs select-none">Bs.</span>
                        <input 
                            type="number" 
                            id="edit_precio" 
                            name="precio" 
                            step="0.50" 
                            min="0"
                            class="w-full py-2.5 pr-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 font-semibold text-sm focus:bg-white focus:ring-2 focus:ring-[#9e2a2b]/15 focus:border-[#9e2a2b] outline-none transition-all"
                            style="padding-left: 2.4rem !important;"
                            required
                        />
                    </div>
                </div>
            </div>
            
            <div>
                <label for="edit_descripcion" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Descripción</label>
                <textarea 
                    id="edit_descripcion" 
                    name="descripcion" 
                    rows="3" 
                    class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 text-sm focus:bg-white focus:ring-2 focus:ring-[#9e2a2b]/15 focus:border-[#9e2a2b] outline-none transition-all resize-none"
                    placeholder="Descripción del plato..."
                ></textarea>
            </div>
            
            <div class="pt-3 flex gap-3 justify-end border-t border-gray-100">
                <button type="button" id="btnCancelarEditar" class="px-5 py-2.5 bg-white text-gray-700 border border-gray-200 rounded-xl text-xs sm:text-sm font-semibold hover:bg-gray-100 transition-colors shadow-sm cursor-pointer">
                    Cancelar
                </button>
                <button type="submit" id="btnGuardarEditar" class="px-6 py-2.5 bg-gradient-to-r from-[#9e2a2b] to-[#7a2021] text-white rounded-xl text-xs sm:text-sm font-semibold hover:shadow-[0_6px_20px_rgba(158,42,43,0.4)] transition-all cursor-pointer border-0">
                    <span class="btn-text">Guardar Cambios</span>
                    <span class="loader hidden absolute inset-0 flex items-center justify-center">
                        <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    #modalEditarPlato h3.modal-edit-title {
        font-size: 1.15rem !important;
        line-height: 1.3 !important;
        margin: 0 !important;
        font-family: 'Playfair Display', Georgia, serif !important;
    }
    .modal-active {
        opacity: 1 !important;
        pointer-events: auto !important;
    }
    .modal-active #modalEditarContent {
        transform: scale(1) !important;
    }
</style>
