---
---

<div id="modalImagenPlato" class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 p-4">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-md" id="modalImagenOverlay"></div>
    
    <div class="relative bg-white rounded-3xl w-full max-w-md p-6 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.4)] transform scale-95 transition-all duration-300 overflow-hidden border border-gray-100" id="modalImagenContent">
        <div class="flex justify-between items-center mb-5">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-[#9e2a2b]/10 text-[#9e2a2b] flex items-center justify-center text-lg font-bold">
                    📷
                </div>
                <h3 class="modal-img-title font-serif font-bold text-gray-900 text-lg m-0">Subir Imagen</h3>
            </div>
            <button id="btnCerrarModalImagen" type="button" class="w-8 h-8 rounded-xl bg-gray-100 text-gray-500 hover:bg-gray-200 hover:text-gray-800 flex items-center justify-center transition-all border-0 cursor-pointer">
                ✕
            </button>
        </div>
        
        <form id="formSubirImagen" class="space-y-4">
            <input type="hidden" id="upload_plato_id" name="plato_id" />
            
            <div id="dropZone" class="border-2 border-dashed border-gray-200 rounded-2xl p-8 text-center hover:bg-[#9e2a2b]/5 hover:border-[#9e2a2b]/40 transition-colors cursor-pointer group bg-gray-50/70">
                <div class="upload-content flex flex-col items-center justify-center space-y-3">
                    <span class="text-4xl group-hover:scale-110 transition-transform">📷</span>
                    <p class="text-sm font-semibold text-gray-700 m-0">Arrastra una imagen aquí o haz clic para seleccionar</p>
                    <span class="text-xs text-gray-400">JPG, PNG, WEBP • Max 2MB</span>
                </div>
                <input type="file" id="fileInput" name="imagen" accept="image/jpeg, image/png, image/webp" class="hidden" />
            </div>

            <!-- Preview de la imagen seleccionada -->
            <div id="previewContainer" class="hidden relative mt-4">
                <div class="aspect-video w-full rounded-xl overflow-hidden bg-gray-100 border border-gray-200">
                    <img id="previewImage" src="" alt="Vista previa" class="w-full h-full object-cover" />
                </div>
                <button type="button" id="btnRemoveImage" class="absolute top-2 right-2 bg-white text-gray-600 rounded-full w-8 h-8 flex items-center justify-center shadow-md hover:bg-red-50 hover:text-red-600 transition-colors cursor-pointer border-0">
                    ✕
                </button>
            </div>
            
            <div class="pt-3 flex gap-3 justify-end border-t border-gray-100">
                <button type="button" id="btnCancelarImagen" class="px-5 py-2.5 bg-white text-gray-700 border border-gray-200 rounded-xl text-xs sm:text-sm font-semibold hover:bg-gray-100 transition-colors shadow-sm cursor-pointer">
                    Cancelar
                </button>
                <button type="submit" id="btnGuardarImagen" class="px-6 py-2.5 bg-gradient-to-r from-[#9e2a2b] to-[#7a2021] text-white rounded-xl text-xs sm:text-sm font-semibold hover:shadow-[0_6px_20px_rgba(158,42,43,0.4)] transition-all cursor-pointer border-0 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                    <span class="btn-text">Subir Imagen</span>
                    <span class="loader hidden absolute inset-0 flex items-center justify-center">
                        <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    #modalImagenPlato h3.modal-img-title {
        font-size: 1.15rem !important;
        line-height: 1.3 !important;
        margin: 0 !important;
        font-family: 'Playfair Display', Georgia, serif !important;
    }
    .modal-img-active {
        opacity: 1 !important;
        pointer-events: auto !important;
    }
    .modal-img-active #modalImagenContent {
        transform: scale(1) !important;
    }
    .drop-active {
        border-color: #9e2a2b !important;
        background-color: rgba(158, 42, 43, 0.05) !important;
    }
</style>
