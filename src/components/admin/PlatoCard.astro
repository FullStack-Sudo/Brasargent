---
interface Props {
    plato: {
        id: number;
        nombre: string;
        descripcion: string;
        precio: number;
        categoria: string;
        imagen_url: string;
        disponible: number | boolean;
        destacado: number | boolean;
    };
    sucursalId: number;
}

const { plato, sucursalId } = Astro.props;
const isAvailable = Boolean(plato.disponible);
const isHighlighted = Boolean(plato.destacado);

// Fallback logo based on sucursal ID
const fallbackLogos: Record<number, string> = {
    1: "/img/logo/LOGO1SF.png",
    2: "/img/logo/LOGO2SF.png",
    3: "/img/logo/LOGO3SF.png",
};
const defaultImage = fallbackLogos[sucursalId] || "/img/logo/logo-SF.png";
const hasImage = Boolean(plato.imagen_url && plato.imagen_url.trim() !== '');
const imageUrl = hasImage ? plato.imagen_url : defaultImage;
---

<div class="pc-card plato-card" data-id={plato.id}>
    <!-- Image Section -->
    <div class="pc-image-wrap">
        <img 
            src={imageUrl} 
            alt={plato.nombre}
            class={`pc-image ${hasImage ? '' : 'pc-image--fallback'}`}
            onerror={`this.src='${defaultImage}'; this.classList.add('pc-image--fallback');`}
            loading="lazy"
        />
        
        <!-- Badges overlay -->
        <div class="pc-badges">
            {isHighlighted && (
                <span class="pc-badge pc-badge--featured">🔥 Destacado</span>
            )}
            <span class={`pc-badge status-badge ${isAvailable ? 'pc-badge--available' : 'pc-badge--sold'}`}>
                {isAvailable ? 'Disponible' : 'Agotado'}
            </span>
        </div>

        <!-- Camera overlay on hover -->
        <button class="pc-camera-overlay btn-upload-img" data-id={plato.id} type="button" title="Cambiar imagen">
            <div class="pc-camera-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
            </div>
            <span class="pc-camera-text">Cambiar Imagen</span>
        </button>
    </div>

    <!-- Content Section -->
    <div class="pc-content">
        <!-- Name + Price -->
        <div class="pc-top-row">
            <h4 class="pc-name" title={plato.nombre}>{plato.nombre}</h4>
            <span class="pc-price">Bs. {Number(plato.precio).toFixed(2)}</span>
        </div>
        
        <!-- Description -->
        <p class="pc-description" title={plato.descripcion}>
            {plato.descripcion || "Sin descripción"}
        </p>

        <!-- Actions Row -->
        <div class="pc-actions">
            <!-- Toggle Status -->
            <button 
                class={`pc-action-btn btn-toggle-status ${isAvailable ? 'pc-action-btn--on' : 'pc-action-btn--off'}`}
                data-id={plato.id}
                data-sucursal={sucursalId}
                data-status={isAvailable ? '1' : '0'}
                title={isAvailable ? "Marcar como Agotado" : "Marcar como Disponible"}
                type="button"
            >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                </svg>
            </button>
            
            <!-- Edit -->
            <button 
                class="pc-action-btn pc-action-btn--edit btn-edit-plato"
                data-id={plato.id}
                data-nombre={plato.nombre}
                data-descripcion={plato.descripcion}
                data-precio={plato.precio}
                data-categoria={plato.categoria}
                data-categoria-id={(plato as any).categoria_id}
                data-imagen={plato.imagen_url || ''}
                data-destacado={plato.destacado ? '1' : '0'}
                title="Editar información"
                type="button"
            >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
            </button>

            <!-- Delete -->
            <button 
                class="pc-action-btn pc-action-btn--delete btn-delete-plato"
                data-id={plato.id}
                data-nombre={plato.nombre}
                data-sucursal={sucursalId}
                title="Eliminar plato del menú"
                type="button"
            >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
            </button>
        </div>
    </div>
</div>

<style>
    .pc-card {
        background: #fff;
        border-radius: 1.125rem;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        border: 1px solid #f0f0f2;
        box-shadow: 0 2px 12px rgba(0,0,0,.04);
        transition: transform .3s cubic-bezier(.4,0,.2,1), box-shadow .3s;
    }
    .pc-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 36px rgba(0,0,0,.1);
    }

    /* ===== IMAGE ===== */
    .pc-image-wrap {
        position: relative;
        height: 180px;
        background: linear-gradient(135deg, #f8f8fa 0%, #f0f0f2 100%);
        overflow: hidden;
    }
    .pc-image {
        width: 100%; height: 100%;
        object-fit: contain;
        padding: .5rem;
        transition: transform .5s cubic-bezier(.4,0,.2,1);
    }
    .pc-image--fallback { opacity: .4; padding: 2rem; }
    .pc-card:hover .pc-image { transform: scale(1.05); }

    /* Badges */
    .pc-badges {
        position: absolute; top: .625rem; left: .625rem;
        display: flex; flex-direction: column; gap: .35rem;
        z-index: 2;
    }
    .pc-badge {
        display: inline-flex; align-items: center;
        padding: .25rem .6rem;
        border-radius: .5rem;
        font-size: .65rem; font-weight: 700;
        letter-spacing: .02em;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        line-height: 1.3;
    }
    .pc-badge--featured {
        background: rgba(251,191,36,.9);
        color: #78350f;
    }
    .pc-badge--available {
        background: rgba(16,185,129,.12);
        color: #059669;
        border: 1px solid rgba(16,185,129,.2);
    }
    .pc-badge--sold {
        background: rgba(239,68,68,.12);
        color: #dc2626;
        border: 1px solid rgba(239,68,68,.2);
    }

    /* Camera Overlay */
    .pc-camera-overlay {
        position: absolute; inset: 0;
        background: rgba(15,15,20,.55);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: .5rem;
        opacity: 0;
        transition: opacity .25s;
        cursor: pointer;
        border: none; z-index: 3;
    }
    .pc-card:hover .pc-camera-overlay { opacity: 1; }
    .pc-camera-icon {
        width: 46px; height: 46px;
        border-radius: 50%;
        background: rgba(255,255,255,.92);
        color: #333;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 16px rgba(0,0,0,.2);
        transition: transform .2s;
    }
    .pc-camera-overlay:hover .pc-camera-icon { transform: scale(1.08); }
    .pc-camera-text {
        color: #fff; font-size: .78rem; font-weight: 600;
        text-shadow: 0 1px 4px rgba(0,0,0,.3);
    }

    /* ===== CONTENT ===== */
    .pc-content {
        padding: 1.1rem 1.25rem 1.15rem;
        display: flex; flex-direction: column;
        flex: 1;
    }

    .pc-top-row {
        display: flex; align-items: flex-start;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .5rem;
    }
    .pc-name {
        font-family: 'Playfair Display', Georgia, serif !important;
        font-size: 1rem !important; font-weight: 700 !important;
        color: #1a1a1f !important;
        margin: 0 !important; line-height: 1.25 !important;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }
    .pc-price {
        font-size: .88rem; font-weight: 700;
        color: #9e2a2b;
        white-space: nowrap;
        padding: .2rem .6rem;
        background: rgba(158,42,43,.06);
        border-radius: .5rem;
        flex-shrink: 0;
    }

    .pc-description {
        font-size: .78rem !important; line-height: 1.5 !important;
        color: #7a7a84 !important;
        margin: 0 0 auto !important;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        padding-bottom: .75rem;
    }

    /* ===== ACTIONS ===== */
    .pc-actions {
        display: flex; gap: .45rem;
        justify-content: flex-end;
        padding-top: .75rem;
        border-top: 1px solid #f0f0f2;
    }
    .pc-action-btn {
        width: 34px; height: 34px;
        border-radius: .625rem;
        display: flex; align-items: center; justify-content: center;
        border: 1.5px solid #e5e5ea;
        background: #fafafa;
        color: #8b8b94;
        cursor: pointer;
        transition: all .2s;
    }
    .pc-action-btn:hover { transform: translateY(-1px); }

    .pc-action-btn--on:hover {
        background: rgba(239,68,68,.08);
        border-color: rgba(239,68,68,.25);
        color: #ef4444;
    }
    .pc-action-btn--off:hover {
        background: rgba(16,185,129,.08);
        border-color: rgba(16,185,129,.25);
        color: #10b981;
    }
    .pc-action-btn--edit:hover {
        background: rgba(37,99,235,.08);
        border-color: rgba(37,99,235,.25);
        color: #2563eb;
    }
    .pc-action-btn--delete:hover {
        background: rgba(239,68,68,.08);
        border-color: rgba(239,68,68,.25);
        color: #ef4444;
    }
</style>
