---
// src/components/admin/Sidebar.astro
// Sidebar compacto de 200px de ancho con badges de notificación

import pool from '../../lib/db';

let configuracion = [];
try {
    const [rows] = await pool.query(
        'SELECT clave, valor FROM configuracion_sistema'
    );
    configuracion = rows as any[];
} catch (e) {
    console.error("Error cargando configuracion:", e);
}

const modulosActivos: Record<string, boolean> = {
    modulo_reservas: true,
    modulo_clientes: true,
    modulo_menu: true,
    modulo_cocina: false
};

configuracion.forEach((item: any) => {
    modulosActivos[item.clave] = item.valor === 'true';
});

// Usuario desde locals o cookies
const usuario = Astro.locals.usuario;
const esSuperAdmin = usuario?.es_super_admin === true || usuario?.es_super_admin === 1 || Astro.cookies.get('es_super_admin')?.value === 'true';
const userSucursalId = usuario?.sucursal_id || (Astro.cookies.get('user_sucursal')?.value ? parseInt(Astro.cookies.get('user_sucursal')!.value, 10) : null);
const userRole = usuario?.rol || Astro.cookies.get('user_role')?.value || 'admin';
const userName = usuario?.nombre || Astro.cookies.get('user_name')?.value || 'Administrador';
const sucursalNombre = usuario?.sucursal_nombre;
const currentPath = Astro.url.pathname;

// Obtener reservas pendientes para el badge (filtrado por sucursal si no es super admin)
let pendientesCount = 0;
try {
    let pendQuery = `SELECT COUNT(*) as total FROM reservas WHERE estado = 'pendiente'`;
    const pendParams: any[] = [];
    if (!esSuperAdmin && userSucursalId) {
        pendQuery += ` AND sucursal_id = ?`;
        pendParams.push(userSucursalId);
    }
    const [pendRows] = await pool.query(pendQuery, pendParams) as any[];
    pendientesCount = pendRows[0]?.total || 0;
} catch (e) {}

const links: any[] = [];

if (userRole === 'admin') {
    links.push({ href: '/admin/dashboard', icon: '📊', label: 'Dashboard' });
    if (modulosActivos['modulo_reservas']) {
        links.push({ href: '/admin/reservas', icon: '📅', label: 'Reservas', badge: pendientesCount > 0 ? pendientesCount : null });
    }
    if (esSuperAdmin) {
        links.push({ href: '/admin/usuarios', icon: '👥', label: 'Administradores' });
    }
    links.push({ href: '/admin/whatsapp', icon: '💬', label: 'OpenWA WhatsApp' });
    if (modulosActivos['modulo_clientes']) {
        links.push({ href: '/admin/clientes', icon: '👥', label: 'Clientes' });
    }
    if (modulosActivos['modulo_menu']) {
        links.push({ href: '/admin/menu', icon: '🍽️', label: 'Menú' });
    }
    if (modulosActivos['modulo_cocina']) {
        links.push({ href: '/admin/cocina', icon: '🔥', label: 'Cocina' });
    }
    links.push({ href: '/admin/precios', icon: '💰', label: 'Precios & Festivos' });
    links.push({ href: '/admin/sucursales', icon: '🏢', label: 'Sucursales' });
    if (esSuperAdmin) {
        links.push({ href: '/admin/configuracion', icon: '⚙️', label: 'Configuración' });
    }
}

if (userRole === 'mesero') {
    if (modulosActivos['modulo_reservas']) {
        links.push({ href: '/admin/reservas', icon: '📅', label: 'Reservas', badge: pendientesCount > 0 ? pendientesCount : null });
    }
    if (modulosActivos['modulo_clientes']) {
        links.push({ href: '/admin/clientes', icon: '👥', label: 'Clientes' });
    }
    if (modulosActivos['modulo_cocina']) {
        links.push({ href: '/admin/cocina', icon: '🔥', label: 'Cocina' });
    }
}

if (userRole === 'cocinero' && modulosActivos['modulo_cocina']) {
    links.push({ href: '/admin/cocina', icon: '🔥', label: 'Cocina' });
}
---

<aside class="sidebar-compact">
    <!-- Logo de la Empresa (Animación Parpadeo Lento entre blanca.png y negro.png) -->
    <div class="sidebar-logo">
        <a href="/admin/dashboard" class="sidebar-logo-link" aria-label="Brasargent Dashboard">
            <div class="logo-blinking-wrapper">
                <img 
                    src="/img/logo/blanca.png" 
                    alt="Brasargent Rodizio Logo" 
                    class="logo-img logo-img-white"
                />
                <img 
                    src="/img/logo/negro.png" 
                    alt="Brasargent Rodizio Logo" 
                    class="logo-img logo-img-black"
                />
            </div>
        </a>
    </div>

    <!-- Usuario -->
    <div class="sidebar-user">
        <span class="user-avatar">{userName.charAt(0).toUpperCase()}</span>
        <div class="user-info">
            <span class="user-name">{userName}</span>
            <span class="user-role">
                {esSuperAdmin ? '👑 Super Admin' : sucursalNombre ? `🏢 Admin ${sucursalNombre}` : userRole === 'admin' ? '🏢 Admin Sucursal' : userRole === 'mesero' ? '🍽️ Mesero' : '👨‍🍳 Cocinero'}
            </span>
        </div>
    </div>

    <!-- Navegación -->
    <nav class="sidebar-nav">
        {links.length === 0 ? (
            <div class="sidebar-empty">
                <span>🔒</span>
                <p>No hay módulos disponibles</p>
            </div>
        ) : (
            links.map((link) => (
                <a 
                    href={link.href} 
                    class={`nav-link ${currentPath === link.href || currentPath.startsWith(link.href + '/') ? 'active' : ''}`}
                >
                    <span class="nav-icon">{link.icon}</span>
                    <span class="nav-text">{link.label}</span>
                    {link.badge && <span class="nav-badge">{link.badge}</span>}
                </a>
            ))
        )}
    </nav>

    <!-- Footer -->
    <div class="sidebar-footer">
        <form method="POST" action="/admin/logout">
            <button type="submit" class="nav-link logout">
                <span class="nav-icon">🚪</span>
                <span class="nav-text">Salir</span>
            </button>
        </form>
    </div>
</aside>

<style is:global>
/* ============================================
   SIDEBAR COMPACTO (200px)
   ============================================ */
.sidebar-compact,
.admin-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 200px;
    height: 100vh;
    background: #1a1a1a;
    color: #fffaf0;
    display: flex;
    flex-direction: column;
    z-index: 100;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    padding: 6px 0;
}

/* Logo */
.sidebar-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 8px;
}

.sidebar-logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    width: 100%;
}

.sidebar-logo-img {
    height: 46px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
}

/* Animación Parpadeo Lento (Blinking Cross-fade) */
.logo-blinking-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    width: 100%;
}

.logo-img {
    height: 44px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
}

.logo-blinking-wrapper:hover .logo-img {
    transform: scale(1.05);
}

.logo-img-white {
    position: relative;
    z-index: 1;
    animation: logoFadeWhite 6s ease-in-out infinite;
}

.logo-img-black {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    opacity: 0;
    animation: logoFadeBlack 6s ease-in-out infinite;
}

@keyframes logoFadeWhite {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
}

@keyframes logoFadeBlack {
    0%, 100% { opacity: 0; }
    50% { opacity: 1; }
}

.logo-icon {
    font-size: 1.2rem;
}

.logo-title {
    display: flex;
    flex-direction: column;
}

.logo-text {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    color: #fffaf0;
    line-height: 1.1;
}

.logo-text span {
    color: #C9A87C;
}

.logo-subtitle {
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

/* Usuario */
.sidebar-user {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    margin: 0 8px 6px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 8px;
}

.user-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #9e2a2b, #7a2021);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
}

.user-info {
    flex: 1;
    min-width: 0;
}

.user-name {
    display: block;
    font-size: 0.78rem;
    font-weight: 500;
    color: #fffaf0;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.user-role {
    display: block;
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.35);
}

/* Navegación */
.sidebar-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 6px;
    overflow-y: auto;
}

.nav-link,
.sidebar-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    transition: all 0.2s ease;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    border: none;
    background: transparent;
    width: 100%;
    font-family: 'Inter', sans-serif;
}

.nav-link:hover,
.sidebar-link:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #fffaf0;
}

.nav-link.active,
.sidebar-link.active {
    background: rgba(201, 168, 124, 0.08) !important;
    color: #fffaf0 !important;
    font-weight: 600;
    border-left: 2px solid #C9A87C;
}

.nav-link.active .nav-icon,
.sidebar-link.active .link-icon {
    color: #C9A87C;
}

.nav-icon,
.link-icon {
    font-size: 1rem;
    width: 20px;
    text-align: center;
    flex-shrink: 0;
}

.nav-text,
.link-text {
    flex: 1;
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nav-badge {
    background: #9e2a2b;
    color: #fffaf0;
    font-size: 0.65rem;
    padding: 2px 7px;
    border-radius: 10px;
    font-weight: 700;
    min-width: 18px;
    text-align: center;
}

/* Footer */
.sidebar-footer {
    padding: 6px 6px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: 4px;
}

.nav-link.logout,
.sidebar-link.logout {
    color: rgba(255, 255, 255, 0.3);
}

.nav-link.logout:hover,
.sidebar-link.logout:hover {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.08);
}

.sidebar-empty {
    text-align: center;
    padding: 24px 10px;
}

.sidebar-empty span {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 6px;
}

.sidebar-empty p {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.75rem;
}

/* Scroll personalizado */
.sidebar-nav::-webkit-scrollbar {
    width: 3px;
}
.sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
}
.sidebar-nav::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
}

/* Responsive */
@media (max-width: 768px) {
    .sidebar-compact,
    .admin-sidebar {
        width: 56px;
    }
    
    .logo-title,
    .user-info,
    .nav-text,
    .link-text,
    .nav-badge {
        display: none;
    }
    
    .sidebar-logo {
        justify-content: center;
        padding: 10px;
    }
    
    .sidebar-user {
        justify-content: center;
        padding: 6px;
        margin: 0 4px;
    }
    
    .nav-link,
    .sidebar-link {
        justify-content: center;
        padding: 8px;
    }
    
    .nav-icon,
    .link-icon {
        font-size: 1.1rem;
        width: auto;
    }
}

/* Ocultar sidebar en móviles para dar paso a la Bottom Navigation */
@media (max-width: 768px) {
    .sidebar-compact,
    .admin-sidebar,
    aside {
        display: none !important;
    }
}
