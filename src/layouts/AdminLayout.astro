---
// src/layouts/AdminLayout.astro
// Layout unificado para todas las páginas del admin

import Sidebar from "../components/admin/Sidebar.astro";
import '../styles/admin.css';

export interface Props {
    title: string;
    description?: string;
    currentPage?: string;
}

const { title, description } = Astro.props;

const usuario = Astro.locals.usuario;
const esSuperAdmin = usuario?.es_super_admin === true || usuario?.es_super_admin === 1 || Astro.cookies.get('es_super_admin')?.value === 'true';
const userName = usuario?.nombre || Astro.cookies.get('user_name')?.value || 'Administrador';
const userRole = usuario?.rol || Astro.cookies.get('user_role')?.value || 'admin';
const sucursalNombre = usuario?.sucursal_nombre;

const roleBadgeText = esSuperAdmin 
    ? '👑 Super Admin' 
    : sucursalNombre 
        ? `🏢 Admin ${sucursalNombre}` 
        : userRole === 'admin' ? '🏢 Admin Sucursal' : userRole === 'mesero' ? '🍽️ Mesero' : '👨‍🍳 Cocinero';

const userInitial = userName ? userName.charAt(0).toUpperCase() : 'A';

const pathname = Astro.url.pathname;
const currentPage = Astro.props.currentPage || (
    pathname.includes('/admin/reservas') ? 'reservas' :
    pathname.includes('/admin/sucursales') ? 'sucursales' :
    pathname.includes('/admin/clientes') ? 'clientes' :
    pathname.includes('/admin/menu') ? 'menu' :
    pathname.includes('/admin/configuracion') ? 'configuracion' :
    pathname.includes('/admin/usuarios') ? 'usuarios' :
    pathname.includes('/admin/whatsapp') ? 'whatsapp' : 'dashboard'
);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/img/logo/logoPestaña.png" />
        <title>{title} - BRASARGENT Admin</title>

        <!-- Google Fonts — Premium Trio -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <div class="admin-layout">
            <!-- Sidebar -->
            <Sidebar />

            <!-- Contenido principal -->
            <main class="admin-main">
                <!-- Header superior -->
                <header class="admin-header">
                    <div class="admin-header-left">
                        <h1>{title}</h1>
                        {
                            description && (
                                <span class="subtitle">{description}</span>
                            )
                        }
                    </div>
                    <div class="admin-header-right">
                        <div class="admin-user">
                            <div class="admin-avatar">{userInitial}</div>
                            <div>
                                <div class="admin-name">{userName}</div>
                                <div class="admin-role">{roleBadgeText}</div>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- Contenido de la página -->
                <div class="admin-content fade-in-up">
                    <slot />
                </div>
            </main>

            <!-- 🔴 BOTTOM NAVIGATION (SOLO MÓVIL ≤768px) -->
            <nav class="bottom-nav" id="bottomNav" role="navigation" aria-label="Navegación móvil admin">
                <!-- 1. Dashboard -->
                <a href="/admin/dashboard" class={`nav-item ${currentPage === 'dashboard' ? 'active' : ''}`}>
                    <span class="icon">📊</span>
                    <span>Dashboard</span>
                </a>
                
                <!-- 2. Reservas -->
                <a href="/admin/reservas" class={`nav-item ${currentPage === 'reservas' ? 'active' : ''}`}>
                    <span class="icon">📋</span>
                    <span>Reservas</span>
                </a>
                
                <!-- 3. Sucursales -->
                <a href="/admin/sucursales" class={`nav-item ${currentPage === 'sucursales' ? 'active' : ''}`}>
                    <span class="icon">🏢</span>
                    <span>Sucursales</span>
                </a>
                
                <!-- 4. Más (Accesos Directos) -->
                <button type="button" class="nav-item more-btn" id="moreBtn" aria-label="Más opciones de menú">
                    <span class="icon">⚙️</span>
                    <span>Más</span>
                </button>
            </nav>
            
            <!-- 🔴 MENÚ DE ACCESOS DIRECTOS -->
            <div class="quick-menu" id="quickMenu" role="menu">
                {esSuperAdmin && (
                    <a href="/admin/usuarios" role="menuitem">
                        <span class="menu-icon">👑</span>
                        <span>Administradores</span>
                    </a>
                )}
                <a href="/admin/clientes" role="menuitem">
                    <span class="menu-icon">👥</span>
                    <span>Clientes</span>
                </a>
                <a href="/admin/menu" role="menuitem">
                    <span class="menu-icon">🍽️</span>
                    <span>Menú</span>
                </a>
                <a href="/admin/precios" role="menuitem">
                    <span class="menu-icon">💰</span>
                    <span>Precios & Festivos</span>
                </a>
                <a href="/admin/whatsapp" role="menuitem">
                    <span class="menu-icon">💬</span>
                    <span>WhatsApp</span>
                </a>
                {esSuperAdmin && (
                    <a href="/admin/configuracion" role="menuitem">
                        <span class="menu-icon">⚙️</span>
                        <span>Configuración</span>
                    </a>
                )}
                <div class="divider"></div>
                <a href="/admin/logout" role="menuitem" style="color: #EF4444;">
                    <span class="menu-icon">🚪</span>
                    <span>Cerrar Sesión</span>
                </a>
            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const moreBtn = document.getElementById('moreBtn');
                const quickMenu = document.getElementById('quickMenu');

                if (!moreBtn || !quickMenu) return;

                moreBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    quickMenu.classList.toggle('open');
                    moreBtn.classList.toggle('active');
                });

                document.addEventListener('click', (e) => {
                    if (quickMenu.classList.contains('open')) {
                        if (!quickMenu.contains(e.target as Node) && !moreBtn.contains(e.target as Node)) {
                            quickMenu.classList.remove('open');
                            moreBtn.classList.remove('active');
                        }
                    }
                });

                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && quickMenu.classList.contains('open')) {
                        quickMenu.classList.remove('open');
                        moreBtn.classList.remove('active');
                    }
                });
            });
        </script>
    </body>
</html>
