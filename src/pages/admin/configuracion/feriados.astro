---
// src/pages/admin/configuracion/feriados.astro
// Gestión de días feriados y fechas sin reserva
import AdminLayout from '../../../layouts/AdminLayout.astro';
import pool from '../../../lib/db';

const [feriadosRows] = await pool.query(
    'SELECT id, fecha, descripcion, sucursal_id, sin_reservas FROM dias_festivos WHERE sin_reservas = TRUE ORDER BY fecha ASC'
) as any[];
const feriados = feriadosRows || [];
---

<AdminLayout title="Feriados" description="Gestión de días sin reservas">
    <div class="feriados-admin">
        <div class="page-header">
            <h1>📅 Días Sin Reservas</h1>
            <p>Gestiona los días feriados, cívicos y fechas especiales en los que NO se aceptan reservas.</p>
        </div>

        <div class="section-card">
            <h3>📋 Días Feriados y Cívicos Configurados</h3>
            <div class="table-wrapper">
                <table class="tabla-feriados">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tablaFeriadosBody">
                        {feriados.length === 0 ? (
                            <tr><td colspan="4" class="empty-td">No hay feriados registrados</td></tr>
                        ) : (
                            feriados.map((feriado: any) => {
                                const fechaStr = String(feriado.fecha).split('T')[0];
                                const fechaObj = new Date(fechaStr + 'T12:00:00');
                                const fechaFormateada = isNaN(fechaObj.getTime()) ? fechaStr : fechaObj.toLocaleDateString('es-ES', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
                                return (
                                    <tr>
                                        <td><strong>{fechaStr}</strong> ({fechaFormateada})</td>
                                        <td>{feriado.descripcion}</td>
                                        <td><span class="badge-sin-reserva">🚫 Sin Reservas</span></td>
                                        <td>
                                            <button class="btn-eliminar" onclick={`eliminarFeriado(${feriado.id})`}>
                                                🗑️ Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                );
                            })
                        )}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="section-card">
            <h3>➕ Agregar Nuevo Día Sin Reservas</h3>
            <form id="formFeriado" onsubmit="agregarFeriado(event)">
                <div class="form-row">
                    <div class="form-group">
                        <label for="fecha">Fecha <span class="req">*</span></label>
                        <input type="date" id="fecha" required />
                    </div>
                    <div class="form-group">
                        <label for="descripcion">Descripción <span class="req">*</span></label>
                        <input type="text" id="descripcion" placeholder="Ej: Aniversario de Santa Cruz" required />
                    </div>
                </div>
                <button type="submit" class="btn-guardar">➕ Agregar Feriado</button>
            </form>
        </div>
    </div>
</AdminLayout>

<script>
    window.agregarFeriado = async function(e: Event) {
        e.preventDefault();
        const fecha = (document.getElementById('fecha') as HTMLInputElement).value;
        const descripcion = (document.getElementById('descripcion') as HTMLInputElement).value.trim();

        if (!fecha || !descripcion) return;

        try {
            const res = await fetch('/api/admin/festivos', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    sucursal_id: 1, // Default o global
                    fecha,
                    descripcion,
                    sin_reservas: true
                })
            });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert('❌ Error: ' + (data.error || 'No se pudo guardar'));
            }
        } catch (err) {
            alert('❌ Error de conexión');
        }
    };

    window.eliminarFeriado = async function(id: number) {
        if (!confirm('¿Deseas eliminar este día sin reservas?')) return;
        try {
            const res = await fetch(`/api/admin/festivos?id=${id}`, {
                method: 'DELETE'
            });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert('❌ Error: ' + data.error);
            }
        } catch (err) {
            alert('❌ Error de conexión');
        }
    };
</script>

<style>
    .feriados-admin {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .page-header h1 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #1a1a1a;
        margin-bottom: 4px;
    }

    .page-header p {
        color: #6b7280;
        font-size: 0.9rem;
    }

    .section-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    }

    .section-card h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 16px;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 12px 16px;
        text-align: left;
        border-bottom: 1px solid rgba(26,26,26,0.06);
        font-size: 0.9rem;
    }

    th {
        background: #f8f5f0;
        font-weight: 700;
        color: rgba(26,26,26,0.6);
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }

    .badge-sin-reserva {
        padding: 4px 10px;
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .btn-eliminar {
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
        border: 1px solid rgba(239, 68, 68, 0.2);
        padding: 6px 12px;
        border-radius: 8px;
        cursor: pointer;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 16px;
        margin-bottom: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-group label {
        font-size: 0.85rem;
        font-weight: 700;
    }

    .form-group input {
        padding: 10px 14px;
        border: 1.5px solid rgba(26,26,26,0.12);
        border-radius: 10px;
        font-family: inherit;
    }

    .btn-guardar {
        background: #9e2a2b;
        color: #ffffff;
        padding: 10px 20px;
        border-radius: 10px;
        border: none;
        font-weight: 700;
        cursor: pointer;
    }

    .empty-td {
        text-align: center;
        padding: 24px;
        color: #9ca3af;
    }
</style>
