---
// src/pages/admin/dashboard.astro
// Dashboard con registro de asistencia totalmente funcional

import AdminLayout from '../../layouts/AdminLayout.astro';
import pool, { query } from '../../lib/db';
import { getEstadisticasCubiertos } from '../../lib/cubiertos';

// ============================================
// OBTENER DATOS DE CUBIERTOS EN TIEMPO REAL
// ============================================

const cubiertos = await getEstadisticasCubiertos();

// ============================================
// OBTENER RESERVAS EN CURSO / CONFIRMADAS (MESAS OCUPADAS)
// ============================================

const [reservasEnCursoRows] = await pool.query(`
    SELECT 
        r.id,
        r.nombre_cliente,
        r.telefono,
        r.telefono_completo,
        r.codigo_pais,
        r.fecha,
        r.hora,
        r.numero_personas,
        r.cantidad_ninos,
        r.cubiertos_reservados,
        r.personas_asistentes,
        r.estado,
        r.hora_llegada,
        s.nombre AS sucursal_nombre,
        s.id AS sucursal_id
    FROM reservas r
    JOIN sucursales s ON r.sucursal_id = s.id
    WHERE r.estado IN ('confirmada', 'en_curso')
    ORDER BY r.fecha ASC, r.hora ASC
`) as any[];
const reservasEnCurso = reservasEnCursoRows || [];

// ============================================
// CALCULAR ESTADÍSTICAS GLOBALES
// ============================================

const totalCubiertosOcupados = cubiertos.reduce((acc: number, s: any) => acc + (parseInt(s.cubiertos_ocupados) || 0), 0);
const totalCapacidad = cubiertos.reduce((acc: number, s: any) => acc + (parseInt(s.capacidad_total) || 0), 0);
const porcentajeGlobal = totalCapacidad > 0 ? Math.round((totalCubiertosOcupados / totalCapacidad) * 100) : 0;

// Obtener estadísticas generales
const [stats] = await pool.query(`
    SELECT 
        (SELECT COUNT(*) FROM reservas) AS total_reservas,
        (SELECT COUNT(*) FROM reservas WHERE estado = 'pendiente') AS pendientes,
        (SELECT COUNT(*) FROM reservas WHERE estado = 'confirmada') AS confirmadas,
        (SELECT COUNT(*) FROM reservas WHERE estado = 'rechazada') AS rechazadas,
        (SELECT COUNT(*) FROM clientes) AS total_clientes
`) as any[];

// Obtener reservas de hoy
const hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'America/La_Paz' });
const [reservasHoyRows] = await pool.query(`
    SELECT 
        r.id,
        r.numero_reserva,
        r.nombre_cliente,
        r.telefono,
        r.telefono_completo,
        r.codigo_pais,
        r.fecha,
        r.hora,
        r.numero_personas,
        r.cantidad_ninos,
        r.cubiertos_reservados,
        r.estado,
        s.nombre AS sucursal_nombre
    FROM reservas r
    JOIN sucursales s ON r.sucursal_id = s.id
    WHERE r.fecha = ?
    ORDER BY r.hora ASC
`, [hoy]) as any[];
const reservasHoy = reservasHoyRows || [];

// Calcular ventas estimadas del día (Precio base: 190 Bs Adultos, 80 Bs Niños)
const PRECIO_ADULTO_STD = 190;
const PRECIO_NINO_STD = 80;

let ventasTotalesHoy = 0;
let totalAdultosHoy = 0;
let totalNinosHoy = 0;
let reservasEfectivasHoy = 0;

reservasHoy.forEach((r: any) => {
    const adultos = parseInt(r.numero_personas) || 0;
    const ninos = parseInt(r.cantidad_ninos) || 0;
    const esValida = ['confirmada', 'en_curso', 'completada'].includes(r.estado);
    
    if (esValida) {
        totalAdultosHoy += adultos;
        totalNinosHoy += ninos;
        reservasEfectivasHoy += 1;
        r.monto_estimado = (adultos * PRECIO_ADULTO_STD) + (ninos * PRECIO_NINO_STD);
        ventasTotalesHoy += r.monto_estimado;
    } else {
        r.monto_estimado = 0;
    }
});

// Obtener estado del reinicio
const [controlRows] = await pool.query(
    `SELECT * FROM control_reinicio_diario WHERE fecha = ?`,
    [hoy]
) as any[];
const control = controlRows && controlRows.length > 0 ? controlRows[0] : null;

// Obtener última semana de reinicios
const [ultimaSemanaRows] = await pool.query(
    `SELECT * FROM control_reinicio_diario 
     ORDER BY fecha DESC 
     LIMIT 7`
) as any[];
const ultimaSemana = ultimaSemanaRows || [];
---

<AdminLayout title="Dashboard" description="Resumen de actividad y gestión de tu restaurante">
    <div class="dashboard-content">
        <!-- Header -->
        <div class="dashboard-header">
            <div>
                <h1>📊 Dashboard y Reportes</h1>
                <p>Resumen de actividad, ventas e ingresos del día</p>
            </div>
            <div class="header-actions">
                <button class="btn-reporte btn-imprimir" onclick="window.imprimirReporte()">
                    🖨️ Imprimir Reporte
                </button>
                <button class="btn-reporte btn-pdf" onclick="window.descargarPDF()">
                    📥 Descargar PDF
                </button>
                <button class="btn-reiniciar" onclick="reiniciarReservas()">
                    🔄 Reiniciar Reservas
                </button>
            </div>
        </div>

        <!-- Tarjetas de estadísticas generales -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">📋</div>
                <div class="stat-info">
                    <span class="stat-number">{stats[0]?.total_reservas || 0}</span>
                    <span class="stat-label">Total Reservas</span>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">⏳</div>
                <div class="stat-info">
                    <span class="stat-number">{stats[0]?.pendientes || 0}</span>
                    <span class="stat-label">Pendientes</span>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">✅</div>
                <div class="stat-info">
                    <span class="stat-number">{stats[0]?.confirmadas || 0}</span>
                    <span class="stat-label">Confirmadas</span>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">❌</div>
                <div class="stat-info">
                    <span class="stat-number">{stats[0]?.rechazadas || 0}</span>
                    <span class="stat-label">Rechazadas</span>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(158, 42, 43, 0.1); color: #9e2a2b;">👥</div>
                <div class="stat-info">
                    <span class="stat-number">{stats[0]?.total_clientes || 0}</span>
                    <span class="stat-label">Clientes Registrados</span>
                </div>
            </div>
        </div>

        <!-- 🔴 USO DE CUBIERTOS (RECUADRO PRINCIPAL) -->
        <div class="section-card cubiertos-section">
            <div class="section-header">
                <h2>🪑 Uso de Cubiertos</h2>
                <span class="badge-porcentaje" style={`background: ${porcentajeGlobal > 80 ? '#ef4444' : porcentajeGlobal > 60 ? '#f59e0b' : '#10b981'}20; color: ${porcentajeGlobal > 80 ? '#ef4444' : porcentajeGlobal > 60 ? '#f59e0b' : '#10b981'}`}>
                    {porcentajeGlobal}% ocupado
                </span>
            </div>

            <div class="cubiertos-grid">
                {cubiertos.map((sucursal: any) => {
                    const porcentaje = parseFloat(sucursal.porcentaje_ocupacion) || 0;
                    const color = porcentaje > 80 ? '#ef4444' : 
                                 porcentaje > 60 ? '#f59e0b' : '#10b981';
                    
                    return (
                        <div class="cubiertos-card" style={`border-left: 4px solid ${color}`}>
                            <div class="cubiertos-header">
                                <span class="cubiertos-icon">
                                    {sucursal.nombre === 'Churrasquería' ? '🔥' :
                                     sucursal.nombre === 'Fast Grill' ? '⚡' : '🥩'}
                                </span>
                                <strong>{sucursal.nombre}</strong>
                            </div>
                            
                            <div class="cubiertos-numeros">
                                <div>
                                    <span class="cubiertos-label">TOTAL</span>
                                    <span class="cubiertos-valor">{sucursal.capacidad_total}</span>
                                </div>
                                <div>
                                    <span class="cubiertos-label">OCUPADOS</span>
                                    <span class="cubiertos-valor ocupado" style="color: #3b82f6;">
                                        {sucursal.cubiertos_ocupados}
                                    </span>
                                </div>
                                <div>
                                    <span class="cubiertos-label">DISPONIBLES</span>
                                    <span class="cubiertos-valor disponible" style={`color: ${color}`}>
                                        {sucursal.cubiertos_disponibles}
                                    </span>
                                </div>
                            </div>
                            
                            <div class="cubiertos-bar">
                                <div class="cubiertos-progreso" style={`width: ${porcentaje}%; background: ${color}`}></div>
                            </div>
                            
                            <div class="cubiertos-footer">
                                <span style={`color: ${color}`}>{porcentaje}% ocupado</span>
                                <span class="cubiertos-libres">{sucursal.cubiertos_disponibles} cubiertos libres</span>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>

        <!-- 🔴 MESAS OCUPADAS (CON CONTROL DE ASISTENCIA FUNCIONAL) -->
        <div class="section-card mesas-section">
            <div class="section-header">
                <h2>🪑 Mesas Ocupadas ({reservasEnCurso.length})</h2>
                <span class="badge-total">🔴 {totalCubiertosOcupados} cubiertos ocupados</span>
            </div>

            {reservasEnCurso.length === 0 ? (
                <div class="empty-state">
                    <span class="empty-icon">🍽️</span>
                    <p>No hay mesas ocupadas actualmente</p>
                    <span class="empty-sub">Todas las mesas están disponibles</span>
                </div>
            ) : (
                <div class="mesas-grid">
                    {reservasEnCurso.map((reserva: any) => {
                        const maxAsistentes = reserva.cubiertos_reservados || 0;
                        const yaRegistrado = reserva.estado === 'en_curso';
                        
                        return (
                            <div class="mesa-card" id={`mesa-${reserva.id}`}>
                                <div class="mesa-header">
                                    <div class="mesa-info">
                                        <span class="mesa-icon">🪑</span>
                                        <div>
                                            <span class="mesa-cliente">{reserva.nombre_cliente}</span>
                                            <span class="mesa-sucursal">📍 {reserva.sucursal_nombre}</span>
                                        </div>
                                    </div>
                                    <span class="mesa-estado" style={`color: ${yaRegistrado ? '#10b981' : '#f59e0b'}`}>
                                        {yaRegistrado ? '🟢 En curso' : '⏳ Esperando'}
                                    </span>
                                </div>

                                <div class="mesa-detalles">
                                    <span>🕐 {reserva.hora} ({new Date(reserva.fecha).toLocaleDateString('es-ES')})</span>
                                    <span>👥 {reserva.numero_personas + (reserva.cantidad_ninos || 0)} reservados</span>
                                    <span>📞 {reserva.telefono}</span>
                                </div>

                                <div class="mesa-asistencia">
                                    <div class="asistencia-info">
                                        <span class="asistencia-label">Reservados:</span>
                                        <span class="asistencia-valor">{reserva.cubiertos_reservados || 0}</span>
                                        <span class="asistencia-label">Asistentes:</span>
                                        <span class="asistencia-valor" id={`asistentes-label-${reserva.id}`}>
                                            {reserva.personas_asistentes ? `${reserva.personas_asistentes}` : '--'}
                                        </span>
                                    </div>

                                    <div class="asistencia-control">
                                        <input 
                                            type="number" 
                                            id={`input-asistentes-${reserva.id}`}
                                            class="input-asistentes"
                                            placeholder="Cantidad"
                                            min="1"
                                            max={maxAsistentes}
                                            value={reserva.personas_asistentes || ''}
                                            disabled={yaRegistrado}
                                            onkeypress="return event.keyCode >= 48 && event.keyCode <= 57"
                                            oninput={`validarAsistentes(this, ${maxAsistentes})`}
                                            onclick="this.select()"
                                        />
                                        <button 
                                            class="btn-registrar-asistencia" 
                                            onclick={`registrarAsistencia(${reserva.id}, ${maxAsistentes})`}
                                            data-reserva-id={reserva.id}
                                            disabled={yaRegistrado}
                                        >
                                            {yaRegistrado ? '✅ Registrado' : '📋 Registrar'}
                                        </button>
                                        <button 
                                            class="btn-liberar-mesa" 
                                            onclick={`liberarMesa(${reserva.id})`}
                                            data-reserva-id={reserva.id}
                                        >
                                            ✅ Liberar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>
            )}
        </div>

        <!-- 🔴 RESERVAS DE HOY -->
        <div class="section-card">
            <div class="section-header">
                <h2>📋 Reservas de Hoy</h2>
                <span class="badge-total">{reservasHoy.length} reservas</span>
            </div>
            
            {reservasHoy.length === 0 ? (
                <div class="empty-state">
                    <span class="empty-icon">📭</span>
                    <p>No hay reservas de hoy</p>
                </div>
            ) : (
                <div class="table-wrapper">
                    <table class="tabla-reservas">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Teléfono</th>
                                <th>Sucursal</th>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Personas</th>
                                <th>Cubiertos</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {reservasHoy.map((reserva: any) => (
                                <tr class={`row-${reserva.estado}`}>
                                    <td><strong>{reserva.nombre_cliente}</strong></td>
                                    <td>
                                        <a href={`https://wa.me/${reserva.telefono_completo || '591' + reserva.telefono}`} target="_blank" class="whatsapp-link">
                                            💬 {reserva.codigo_pais || '591'} {reserva.telefono}
                                        </a>
                                    </td>
                                    <td>{reserva.sucursal_nombre}</td>
                                    <td>{new Date(reserva.fecha).toLocaleDateString('es-ES')}</td>
                                    <td>{reserva.hora}</td>
                                    <td>{reserva.numero_personas}</td>
                                    <td>{reserva.cubiertos_reservados || '-'}</td>
                                    <td>
                                        <span class={`badge badge-${reserva.estado}`}>
                                            {reserva.estado === 'confirmada' ? '✅ Confirmada' :
                                             reserva.estado === 'en_curso' ? '🟢 En curso' :
                                             reserva.estado === 'completada' ? '🏁 Completada' :
                                             reserva.estado === 'pendiente' ? '⏳ Pendiente' :
                                             reserva.estado === 'rechazada' ? '❌ Rechazada' : '⏰ Cancelada'}
                                        </span>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            )}
        </div>

        <!-- 📄 PLANTILLA OFICIAL DE REPORTE DE VENTAS (VISUAL Y PARA IMPRESIÓN/PDF) -->
        <div id="reporteImprimible" class="section-card reporte-imprimible-container">
            <div class="reporte-header-print">
                <div class="reporte-logo-title">
                    <span class="reporte-logo">🥩</span>
                    <div>
                        <h2>BRASARGENT - CHURRASQUERÍA & RODIZIO</h2>
                        <h3>Reporte Oficial de Ventas y Reservas Diarias</h3>
                    </div>
                </div>
                <div class="reporte-meta">
                    <p><strong>Fecha de Operaciones:</strong> {hoy}</p>
                    <p><strong>Total Venta Estimada:</strong> <span style="color: #10b981; font-weight: 700;">{ventasTotalesHoy.toLocaleString('es-BO')} Bs.</span></p>
                </div>
            </div>

            <!-- Resumen Estadístico de Ventas -->
            <div class="reporte-cards-grid">
                <div class="reporte-card-stat">
                    <span class="reporte-card-label">💰 Ingreso Total Estimado</span>
                    <span class="reporte-card-value" style="color: #10b981;">{ventasTotalesHoy.toLocaleString('es-BO')} Bs.</span>
                </div>
                <div class="reporte-card-stat">
                    <span class="reporte-card-label">✅ Reservas Efectivas</span>
                    <span class="reporte-card-value">{reservasEfectivasHoy}</span>
                </div>
                <div class="reporte-card-stat">
                    <span class="reporte-card-label">👥 Adultos Atendidos</span>
                    <span class="reporte-card-value">{totalAdultosHoy}</span>
                </div>
                <div class="reporte-card-stat">
                    <span class="reporte-card-label">👧 Niños Atendidos</span>
                    <span class="reporte-card-value">{totalNinosHoy}</span>
                </div>
            </div>

            <!-- Tabla Resumen por Sucursal -->
            <div class="reporte-tabla-section">
                <h4>🪑 Resumen de Ocupación por Sucursal</h4>
                <table class="reporte-tabla">
                    <thead>
                        <tr>
                            <th>Sucursal</th>
                            <th>Capacidad Total</th>
                            <th>Cubiertos Ocupados</th>
                            <th>Cubiertos Libres</th>
                            <th>% Ocupación</th>
                        </tr>
                    </thead>
                    <tbody>
                        {cubiertos.map((s: any) => (
                            <tr>
                                <td><strong>{s.nombre}</strong></td>
                                <td>{s.capacidad_total}</td>
                                <td>{s.cubiertos_ocupados}</td>
                                <td>{s.cubiertos_disponibles}</td>
                                <td><strong>{s.porcentaje_ocupacion}%</strong></td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>

            <!-- Detalle de Transacciones del Día -->
            <div class="reporte-tabla-section">
                <h4>📋 Detalle de Reservas y Ventas del Día ({reservasHoy.length})</h4>
                <table class="reporte-tabla">
                    <thead>
                        <tr>
                            <th>Nº Reserva</th>
                            <th>Cliente</th>
                            <th>Teléfono</th>
                            <th>Sucursal</th>
                            <th>Hora</th>
                            <th>Adultos</th>
                            <th>Niños</th>
                            <th>Estado</th>
                            <th>Monto Estimado</th>
                        </tr>
                    </thead>
                    <tbody>
                        {reservasHoy.length === 0 ? (
                            <tr><td colspan="9" style="text-align: center; color: #64748b; padding: 20px;">No hay reservas o ventas registradas para el día de hoy.</td></tr>
                        ) : (
                            reservasHoy.map((r: any) => (
                                <tr>
                                    <td><code style="font-family: monospace; font-weight: bold; color: #9e2a2b;">{r.numero_reserva || `BR-${r.id}`}</code></td>
                                    <td><strong>{r.nombre_cliente}</strong></td>
                                    <td>{r.codigo_pais || '591'} {r.telefono}</td>
                                    <td>{r.sucursal_nombre}</td>
                                    <td>{r.hora}</td>
                                    <td>{r.numero_personas}</td>
                                    <td>{r.cantidad_ninos || 0}</td>
                                    <td>
                                        <span class={`badge badge-${r.estado}`}>
                                            {r.estado === 'confirmada' ? 'Confirmada' :
                                             r.estado === 'en_curso' ? 'En Curso' :
                                             r.estado === 'completada' ? 'Completada' :
                                             r.estado === 'pendiente' ? 'Pendiente' :
                                             r.estado === 'rechazada' ? 'Rechazada' : 'Cancelada'}
                                        </span>
                                    </td>
                                    <td><strong>{r.monto_estimado > 0 ? `${r.monto_estimado.toLocaleString('es-BO')} Bs.` : '0 Bs.'}</strong></td>
                                </tr>
                            ))
                        )}
                    </tbody>
                </table>
            </div>

            <div class="reporte-footer-print">
                <p>Brasargent Churrasquería - Documento de Control Interno de Ventas y Reservas</p>
            </div>
        </div>
    </div>
</AdminLayout>

<script is:inline>
// ============================================
// FUNCIONES DE IMPRESIÓN Y DESCARGA DE PDF
// ============================================

window.imprimirReporte = function() {
    window.print();
};

window.descargarPDF = function() {
    if (typeof window.html2pdf === 'undefined') {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
        script.onload = () => window._ejecutarDescargaPDF();
        script.onerror = () => {
            alert('💡 Abriendo vista previa para guardar como PDF...');
            window.print();
        };
        document.head.appendChild(script);
    } else {
        window._ejecutarDescargaPDF();
    }
};

window._ejecutarDescargaPDF = function() {
    const element = document.getElementById('reporteImprimible');
    if (!element) return;

    const btnImprimir = document.querySelector('.btn-imprimir');
    const btnPdf = document.querySelector('.btn-pdf');
    if (btnPdf) btnPdf.textContent = '⏳ Generando PDF...';

    const opt = {
        margin:       [10, 10, 10, 10],
        filename:     `Reporte_Ventas_Brasargent_${new Date().toISOString().split('T')[0]}.pdf`,
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true },
        jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };

    window.html2pdf().set(opt).from(element).save().then(() => {
        if (btnPdf) btnPdf.textContent = '📥 Descargar PDF';
    }).catch((err) => {
        console.error('Error creando PDF:', err);
        if (btnPdf) btnPdf.textContent = '📥 Descargar PDF';
        window.print();
    });
};
// ============================================
// VALIDACIÓN DE ASISTENTES EN TIEMPO REAL
// ============================================

window.validarAsistentes = function(input, max) {
    const valor = parseInt(input.value);
    
    if (input.value === '') {
        return;
    }
    
    if (valor < 1) {
        input.value = 1;
    }
    
    if (valor > max) {
        input.value = max;
        alert(`⚠️ Solo hay ${max} cubiertos reservados`);
    }
};

// ============================================
// REGISTRAR ASISTENCIA
// ============================================

window.registrarAsistencia = async function(reservaId, maxAsistentes) {
    const input = document.getElementById(`input-asistentes-${reservaId}`);
    const personas = parseInt(input.value);
    
    // Validar entrada
    if (!personas || personas < 1) {
        alert('⚠️ Ingresa el número de personas que asistieron');
        if (input) input.focus();
        return;
    }
    
    if (personas > maxAsistentes) {
        alert(`⚠️ Solo hay ${maxAsistentes} cubiertos reservados`);
        if (input) input.value = maxAsistentes;
        return;
    }
    
    if (!confirm(`¿Registrar ${personas} asistentes para esta reserva?`)) return;

    const btn = document.querySelector(`.btn-registrar-asistencia[data-reserva-id="${reservaId}"]`);
    const originalText = btn ? btn.textContent : '📋 Registrar';
    if (btn) {
        btn.textContent = '⏳ Procesando...';
        btn.disabled = true;
    }

    try {
        const response = await fetch(`/api/reservas/${reservaId}/asistencia`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ personas_asistentes: personas })
        });

        const result = await response.json();

        if (result.success) {
            // Actualizar UI inmediatamente
            const label = document.getElementById(`asistentes-label-${reservaId}`);
            if (label) label.textContent = `${personas}`;
            
            if (input) input.disabled = true;
            if (btn) {
                btn.textContent = '✅ Registrado';
                btn.disabled = true;
            }
            
            const card = document.getElementById(`mesa-${reservaId}`);
            if (card) {
                const estado = card.querySelector('.mesa-estado');
                if (estado) {
                    estado.textContent = '🟢 En curso';
                    estado.style.color = '#10b981';
                }
            }
            
            alert(`✅ ${result.mensaje}`);
            setTimeout(() => location.reload(), 1500);
        } else {
            alert('❌ Error: ' + result.error);
            if (btn) {
                btn.textContent = originalText;
                btn.disabled = false;
            }
        }
    } catch (error) {
        alert('❌ Error de conexión');
        if (btn) {
            btn.textContent = originalText;
            btn.disabled = false;
        }
    }
};

// ============================================
// LIBERAR MESA
// ============================================

window.liberarMesa = async function(reservaId) {
    if (!confirm('¿Estás seguro de liberar esta mesa?')) return;
    if (!confirm('⚠️ El cliente ya terminó su comida y se retiró.')) return;

    const btn = document.querySelector(`.btn-liberar-mesa[data-reserva-id="${reservaId}"]`);
    const originalText = btn ? btn.textContent : '✅ Liberar';
    if (btn) {
        btn.textContent = '⏳ Liberando...';
        btn.disabled = true;
    }

    try {
        const response = await fetch(`/api/reservas/${reservaId}/liberar`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        const result = await response.json();

        if (result.success) {
            alert(`✅ ${result.mensaje}`);
            location.reload();
        } else {
            alert('❌ Error: ' + result.error);
            if (btn) {
                btn.textContent = originalText;
                btn.disabled = false;
            }
        }
    } catch (error) {
        alert('❌ Error de conexión');
        if (btn) {
            btn.textContent = originalText;
            btn.disabled = false;
        }
    }
};

// ============================================
// REINICIAR RESERVAS
// ============================================

window.reiniciarReservas = function() {
    if (!confirm('⚠️ ¿Estás seguro de reiniciar todas las reservas?\n\nSe eliminarán todas las reservas del día actual y se liberarán todos los cubiertos.')) {
        return;
    }
    
    if (!confirm('🔴 Esta acción NO se puede deshacer. ¿Continuar?')) {
        return;
    }
    
    const btn = document.querySelector('.btn-reiniciar');
    btn.textContent = '⏳ Procesando...';
    btn.disabled = true;
    
    fetch('/api/reservas/reiniciar', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            alert(`✅ Reservas reiniciadas exitosamente\n\n📋 ${result.reservas_eliminadas} reservas eliminadas\n🪑 ${result.cubiertos_liberados} cubiertos liberados`);
            location.reload();
        } else {
            alert('❌ Error: ' + result.error);
            btn.textContent = '🔄 Reiniciar Reservas';
            btn.disabled = false;
        }
    })
    .catch(() => {
        alert('❌ Error de conexión. Intenta de nuevo.');
        btn.textContent = '🔄 Reiniciar Reservas';
        btn.disabled = false;
    });
};
</script>

