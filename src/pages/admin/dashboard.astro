<script is:inline>
window.abrirModalFuturas = function() {
    let modal = document.getElementById('modalFuturas');
    if (modal) {
        if (modal.parentElement !== document.body) {
            document.body.appendChild(modal);
        }
        modal.style.display = 'flex';
        modal.style.zIndex = '9999999';
        document.body.style.overflow = 'hidden';
        if (typeof window.cargarReservasFuturas === 'function') {
            window.cargarReservasFuturas();
        }
    }
};

window.seleccionarFormato = function(fmt) {
    document.querySelectorAll('.formato-btn').forEach(btn => btn.classList.remove('active'));
    const btn = document.querySelector(`.formato-btn[data-formato="${fmt}"]`);
    if (btn) btn.classList.add('active');
    const inputFmt = document.getElementById('formatoReporte');
    if (inputFmt) inputFmt.value = fmt;
};

window.abrirModalReportes = function() {
    const m = document.getElementById('modalReportes');
    if (m) {
        m.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }
};

window.cerrarModalReportes = function() {
    const m = document.getElementById('modalReportes');
    if (m) {
        m.style.display = 'none';
        document.body.style.overflow = '';
    }
};

window.generarReporteConFormato = async function(fmt, fechaInicio, fechaFin, sucursalId) {
    const btnGenerar = document.querySelector('.btn-generar');
    const originalText = btnGenerar ? btnGenerar.textContent : 'Descargar Reporte';
    
    let url = `/api/reportes/reservas?formato=${fmt || 'excel'}`;
    if (fechaInicio) url += `&fecha_inicio=${fechaInicio}`;
    if (fechaFin) url += `&fecha_fin=${fechaFin}`;
    if (sucursalId) url += `&sucursal_id=${sucursalId}`;

    try {
        if (btnGenerar) {
            btnGenerar.disabled = true;
            btnGenerar.textContent = '⏳ Generando...';
        }

        const res = await fetch(url);

        if (!res.ok) {
            let errorMsg = 'No existen reservas actualmente para los filtros seleccionados.';
            try {
                const data = await res.json();
                if (data.error) errorMsg = data.error;
            } catch (e) {}

            alert(`⚠️ ${errorMsg}`);
            return;
        }

        const blob = await res.blob();
        const downloadUrl = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = downloadUrl;
        a.download = fmt === 'pdf' 
            ? `reservas_brasargent_${new Date().toISOString().split('T')[0]}.pdf`
            : `reservas_brasargent_${new Date().toISOString().split('T')[0]}.xlsx`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        window.URL.revokeObjectURL(downloadUrl);

        window.cerrarModalReportes();
    } catch (err) {
        alert('❌ Error de conexión al generar el reporte.');
    } finally {
        if (btnGenerar) {
            btnGenerar.disabled = false;
            btnGenerar.textContent = originalText;
        }
    }
};

window.generarReporte = function() {
    const fechaInicio = document.getElementById('fechaInicio')?.value;
    const fechaFin = document.getElementById('fechaFin')?.value;
    const sucursalId = document.getElementById('sucursalReporte')?.value;
    const formato = document.getElementById('formatoReporte')?.value || 'excel';

    if (fechaInicio && fechaFin && fechaInicio > fechaFin) {
        alert('⚠️ La fecha de inicio debe ser anterior o igual a la fecha fin.');
        return;
    }

    window.generarReporteConFormato(formato, fechaInicio, fechaFin, sucursalId);
};

window.imprimirReporte = function() {
    window.print();
};

window.descargarPDF = function() {
    window.generarReporteConFormato('pdf');
};

window.reiniciarReservas = async function() {
    if (!confirm('⚠️ ¿Estás seguro de que deseas reiniciar las reservas ocupadas del día?')) return;
    try {
        const res = await fetch('/api/reservas/reiniciar', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            alert('✅ Reservas reiniciadas con éxito.');
            window.location.reload();
        } else {
            alert('❌ Error: ' + (data.error || 'No se pudo reiniciar'));
        }
    } catch (e) {
        alert('❌ Error de conexión al reiniciar reservas.');
    }
};

// ============================================
// FUNCIONES DE CONTROL DE ASISTENCIA Y RECEPCIÓN
// ============================================

window.filtrarAsistenciaCards = function() {
    const q = (document.getElementById('searchAsistenciaInput')?.value || '').toLowerCase().trim();
    const cards = document.querySelectorAll('#asistenciaGrid .asistencia-card');
    cards.forEach(card => {
        const searchData = card.getAttribute('data-search') || '';
        if (!q || searchData.includes(q)) {
            card.style.display = 'flex';
        } else {
            card.style.display = 'none';
        }
    });
};

window.abrirModalAsistencia = function(id, nombreCliente, reservados) {
    const modal = document.getElementById('modalAsistenciaDashboard');
    const inputId = document.getElementById('asistenciaReservaId');
    const inputReservados = document.getElementById('asistenciaCubiertosReservados');
    const inputPersonas = document.getElementById('inputPersonasAsistentes');
    const labelInfo = document.getElementById('asistenciaModalClientInfo');

    if (!modal || !inputId || !inputPersonas) return;

    inputId.value = String(id);
    if (inputReservados) inputReservados.value = String(reservados || 1);
    inputPersonas.value = String(reservados || 1);
    if (labelInfo) labelInfo.textContent = `Cliente: ${nombreCliente} (${reservados} cubiertos reservados)`;

    window.actualizarPreviewCubiertos();

    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
};

window.cerrarModalAsistencia = function() {
    const modal = document.getElementById('modalAsistenciaDashboard');
    if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
    }
};

window.cambiarContadorAsistencia = function(delta) {
    const input = document.getElementById('inputPersonasAsistentes');
    if (!input) return;
    let val = parseInt(input.value || '1', 10) + delta;
    if (val < 1) val = 1;
    input.value = String(val);
    window.actualizarPreviewCubiertos();
};

window.actualizarPreviewCubiertos = function() {
    const inputReservados = document.getElementById('asistenciaCubiertosReservados');
    const inputPersonas = document.getElementById('inputPersonasAsistentes');
    const boxText = document.getElementById('previewCubiertosText');

    if (!inputReservados || !inputPersonas || !boxText) return;

    const reservados = parseInt(inputReservados.value || '0', 10);
    const asistentes = parseInt(inputPersonas.value || '0', 10);

    if (asistentes < reservados) {
        const liberados = reservados - asistentes;
        boxText.innerHTML = `Llegaron <strong>${asistentes}</strong> personas. ¡Se liberarán <strong>${liberados} cubierto(s)</strong> automáticamente en tiempo real!`;
    } else if (asistentes > reservados) {
        boxText.innerHTML = `Llegaron <strong>${asistentes}</strong> personas (más de las ${reservados} reservadas).`;
    } else {
        boxText.innerHTML = `Llegaron las <strong>${asistentes}</strong> personas esperadas.`;
    }
};

window.guardarAsistenciaDashboard = async function() {
    const inputId = document.getElementById('asistenciaReservaId');
    const inputPersonas = document.getElementById('inputPersonasAsistentes');
    const btnBtn = document.getElementById('btnConfirmarAsistenciaModal');

    if (!inputId || !inputPersonas) return;

    const id = parseInt(inputId.value || '0', 10);
    const personas = parseInt(inputPersonas.value || '1', 10);

    if (!id || personas < 1) {
        alert('⚠️ Ingresa una cantidad válida de personas.');
        return;
    }

    const originalText = btnBtn ? btnBtn.textContent : 'Confirmar Llegada';
    try {
        if (btnBtn) {
            btnBtn.disabled = true;
            btnBtn.textContent = '⏳ Guardando...';
        }

        const res = await fetch(`/api/reservas/${id}/asistencia`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ personas_asistentes: personas })
        });

        const data = await res.json();
        if (data.success) {
            alert(`✅ ${data.mensaje}`);
            window.cerrarModalAsistencia();
            window.location.reload();
        } else {
            alert(`❌ Error: ${data.error || 'No se pudo guardar la asistencia'}`);
        }
    } catch (e) {
        alert('❌ Error de conexión al registrar la asistencia.');
    } finally {
        if (btnBtn) {
            btnBtn.disabled = false;
            btnBtn.textContent = originalText;
        }
    }
};

window.liberarCubiertosMesa = async function(id, nombreCliente, cubiertos) {
    if (!confirm(`🔓 ¿Deseas liberar la mesa de ${nombreCliente}?\n\nEsta acción marcará el servicio como finalizado y devolverá los ${cubiertos} cubiertos al inventario disponible de tu sucursal.`)) {
        return;
    }

    try {
        const response = await fetch(`/api/reservas/${id}/liberar`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();
        if (data.success) {
            alert(`✅ ${data.mensaje || 'Mesa y cubiertos liberados exitosamente'}`);
            window.location.reload();
        } else {
            alert(`❌ Error: ${data.error || 'No se pudieron liberar los cubiertos'}`);
        }
    } catch (e) {
        alert('❌ Error de conexión al intentar liberar los cubiertos.');
    }
};
</script>
