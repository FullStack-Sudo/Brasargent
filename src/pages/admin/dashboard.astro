---
// src/pages/admin/dashboard.astro
// Dashboard rediseñado en columna sin scroll horizontal
import AdminLayout from '../../layouts/AdminLayout.astro';
import ModalAlertas from '../../components/admin/ModalAlertas.astro';
import BurbujaFuturas from '../../components/admin/BurbujaFuturas.astro';
import ModalFuturas from '../../components/admin/ModalFuturas.astro';
import pool, { query } from '../../lib/db';
import { getEstadisticasCubiertos } from '../../lib/cubiertos';
import { getReservasAceptables } from '../../lib/reservas';
import { verificarReservasParaLiberar } from '../../lib/liberacion-cubiertos';

// Fecha de HOY (para filtrar cubiertos y recepción en vivo estrictamente para hoy)
const hoy = new Date().toISOString().split('T')[0];

// Obtener usuario actual desde locals (seteado en middleware)
const usuario = Astro.locals.usuario;
const esSuperAdmin = usuario?.es_super_admin === true || usuario?.es_super_admin === 1;
const userSucursalId = usuario?.sucursal_id;

// Ejecutar liberación y obtener reservas dentro de 24h
await verificarReservasParaLiberar();
const reservasAceptablesAll = await getReservasAceptables();
const reservasAceptables = (!esSuperAdmin && userSucursalId)
    ? reservasAceptablesAll.filter((r: any) => r.sucursal_id === userSucursalId)
    : reservasAceptablesAll;

// Obtener estadísticas de cubiertos para HOY
const cubiertosAll = await getEstadisticasCubiertos(undefined, hoy);
const cubiertos = (!esSuperAdmin && userSucursalId)
    ? cubiertosAll.filter((s: any) => s.id === userSucursalId)
    : cubiertosAll;

// Obtener totales globales/por sucursal
let statsWhere = '';
const statsParams: any[] = [];
if (!esSuperAdmin && userSucursalId) {
    statsWhere = ' AND sucursal_id = ?';
    statsParams.push(userSucursalId, userSucursalId, userSucursalId, userSucursalId);
}

const [statsRows] = await pool.query(`
    SELECT 
        (SELECT COUNT(*) FROM reservas WHERE 1=1 ${!esSuperAdmin && userSucursalId ? 'AND sucursal_id = ?' : ''}) AS total_reservas,
        (SELECT COUNT(*) FROM reservas WHERE estado = 'pendiente' ${!esSuperAdmin && userSucursalId ? 'AND sucursal_id = ?' : ''}) AS pendientes,
        (SELECT COUNT(*) FROM reservas WHERE estado = 'confirmada' ${!esSuperAdmin && userSucursalId ? 'AND sucursal_id = ?' : ''}) AS confirmadas,
        (SELECT COUNT(*) FROM reservas WHERE estado = 'rechazada' ${!esSuperAdmin && userSucursalId ? 'AND sucursal_id = ?' : ''}) AS rechazadas,
        (SELECT COUNT(*) FROM clientes) AS total_clientes
`, statsParams) as any[];

const stats = Array.isArray(statsRows) && statsRows.length > 0 ? statsRows[0] : {
    total_reservas: 0,
    pendientes: 0,
    confirmadas: 0,
    rechazadas: 0,
    total_clientes: 0
};

// Obtener reservas recientes
let recWhere = '';
const recParams: any[] = [];
if (!esSuperAdmin && userSucursalId) {
    recWhere = ' WHERE r.sucursal_id = ?';
    recParams.push(userSucursalId);
}

const [reservasRecientesRows] = await pool.query(`
    SELECT 
        r.id,
        r.nombre_cliente,
        r.telefono,
        r.fecha,
        r.hora,
        r.numero_personas,
        r.cantidad_ninos,
        r.estado,
        s.nombre AS sucursal_nombre
    FROM reservas r
    JOIN sucursales s ON r.sucursal_id = s.id
    ${recWhere}
    ORDER BY r.created_at DESC
    LIMIT 6
`, recParams) as any[];

const reservasRecientes = Array.isArray(reservasRecientesRows) ? reservasRecientesRows : [];

// Obtener reservas confirmadas y en_curso para el modulo de Asistencia en Vivo (SOLO DE HOY)
let asisWhere = ` WHERE r.estado IN ('confirmada', 'en_curso') AND r.fecha = ?`;
const asisParams: any[] = [hoy];
if (!esSuperAdmin && userSucursalId) {
    asisWhere += ` AND r.sucursal_id = ?`;
    asisParams.push(userSucursalId);
}

const [asistenciaRows] = await pool.query(`
    SELECT 
        r.id,
        r.numero_reserva,
        r.nombre_cliente,
        r.telefono,
        r.telefono_completo,
        r.codigo_pais,
        r.fecha,
        r.hora,
        r.numero_personas,
        r.cantidad_ninos,
        r.cubiertos_reservados,
        r.personas_asistentes,
        r.hora_llegada,
        r.estado,
        s.nombre AS sucursal_nombre
    FROM reservas r
    JOIN sucursales s ON r.sucursal_id = s.id
    ${asisWhere}
    ORDER BY 
        FIELD(r.estado, 'confirmada', 'en_curso'),
        r.fecha ASC,
        r.hora ASC
`, asisParams) as any[];

const reservasAsistencia = Array.isArray(asistenciaRows) ? asistenciaRows : [];
const totalEnCurso = reservasAsistencia.filter((r: any) => r.estado === 'en_curso').length;
const totalConfirmadasAsistencia = reservasAsistencia.filter((r: any) => r.estado === 'confirmada').length;
---

<AdminLayout title="Dashboard" description="Resumen de actividad y gestión de tu restaurante" currentPage="dashboard">
    <div class="dashboard-column">
        
        <!-- HEADER Y ACCIONES -->
        <div class="dashboard-top-bar">
            <div class="dashboard-title-area">
                <h2>📊 Dashboard de Gestión</h2>
                <p>Monitoreo en tiempo real de reservas y cubiertos</p>
            </div>
            <div class="header-actions">
                <button type="button" class="btn-reporte btn-futuras-action" onclick="window.abrirModalFuturas()">
                    📅 Futuras <span id="btnFuturasBadge" class="badge-count-pill" style="display:none;">0</span>
                </button>
                <button type="button" class="btn-reporte btn-excel" onclick="window.abrirModalReportes()">
                    📊 Reportes
                </button>
                <button type="button" class="btn-reporte btn-imprimir" onclick="window.imprimirReporte()">
                    🖨️ Imprimir
                </button>
                <button type="button" class="btn-reporte btn-pdf" onclick="window.descargarPDF()">
                    📥 PDF
                </button>
                <a href="/admin/openwa" class="btn-reporte btn-openwa">
                    💬 WhatsApp
                </a>
                <button type="button" class="btn-reiniciar" onclick="window.reiniciarReservas()">
                    🔄 Reiniciar
                </button>
            </div>
        </div>

        <!-- 🔴 ALERTA DE RESERVAS DENTRO DE LAS 24 HORAS -->
        {reservasAceptables.length > 0 && (
            <div class="alerta-aceptables mb-6">
                <div class="flex items-center gap-3">
                    <span class="text-2xl">🔔</span>
                    <div>
                        <strong>{reservasAceptables.length} reservas listas para confirmar (Ventana 24h)</strong>
                        <p class="text-xs text-amber-800">Estas reservas están dentro de las 24 horas y esperan tu confirmación.</p>
                    </div>
                </div>
                <a href="/admin/reservas?estado=pendiente" class="btn-alerta-link">
                    Ver pendientes →
                </a>
            </div>
        )}

        <!-- ============================================
        SECCIÓN 1: ESTADÍSTICAS RÁPIDAS
        ============================================ -->
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-icon">📋</span>
                <div>
                    <span class="stat-number">{stats.total_reservas || 0}</span>
                    <span class="stat-label">Total Reservas</span>
                </div>
            </div>
            <div class="stat-card">
                <span class="stat-icon">⏳</span>
                <div>
                    <span class="stat-number">{stats.pendientes || 0}</span>
                    <span class="stat-label">Pendientes</span>
                </div>
            </div>
            <div class="stat-card">
                <span class="stat-icon">✅</span>
                <div>
                    <span class="stat-number">{stats.confirmadas || 0}</span>
                    <span class="stat-label">Confirmadas</span>
                </div>
            </div>
            <div class="stat-card stat-asistencia-card">
                <span class="stat-icon">🙋‍♂️</span>
                <div>
                    <span class="stat-number">{totalEnCurso} / {reservasAsistencia.length}</span>
                    <span class="stat-label">En Mesa / Total</span>
                </div>
            </div>
        </div>

        <!-- ============================================
        SECCIÓN: CONTROL DE ASISTENCIA Y RECEPCIÓN EN VIVO
        ============================================ -->
        <div class="section-card asistencia-section">
            <div class="section-header">
                <div>
                    <h3>🙋‍♂️ Control de Asistencia y Recepción en Vivo</h3>
                    <p class="section-subtitle">Marca la llegada de tus clientes en tiempo real y ajusta los cubiertos ocupados</p>
                </div>
                <div class="asistencia-header-actions">
                    <span class="badge-asistencia-summary">
                        🟢 <strong>{totalEnCurso}</strong> en mesa | ⏳ <strong>{totalConfirmadasAsistencia}</strong> por llegar
                    </span>
                </div>
            </div>

            <!-- Buscador rápido en vivo -->
            <div class="asistencia-search-bar">
                <input 
                    type="text" 
                    id="searchAsistenciaInput" 
                    placeholder="🔍 Buscar cliente por nombre, teléfono o #reserva..." 
                    oninput="window.filtrarAsistenciaCards()"
                />
            </div>

            {reservasAsistencia.length === 0 ? (
                <div class="empty-state">
                    <span class="empty-icon">🥂</span>
                    <p>No hay reservas confirmadas o en curso para mostrar</p>
                    <span class="empty-sub">Las reservas confirmadas aparecerán aquí para marcar su llegada cuando arriben a la sucursal</span>
                </div>
            ) : (
                <div class="asistencia-grid" id="asistenciaGrid">
                    {reservasAsistencia.map((r: any) => {
                        const esEnCurso = r.estado === 'en_curso';
                        const totalPersonas = (parseInt(r.numero_personas) || 0) + (parseInt(r.cantidad_ninos) || 0);
                        const cubiertos = r.cubiertos_reservados || totalPersonas;
                        const horaLlegada = r.hora_llegada ? new Date(r.hora_llegada).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) : null;
                        
                        return (
                            <div class={`asistencia-card ${esEnCurso ? 'card-en-curso' : 'card-confirmada'}`}
                                 data-search={`${r.nombre_cliente} ${r.telefono} ${r.numero_reserva} ${r.sucursal_nombre}`.toLowerCase()}>
                                <div class="asistencia-card-header">
                                    <div>
                                        <div class="client-title-row">
                                            <strong class="client-name">{r.nombre_cliente}</strong>
                                            <span class="reserva-code">{r.numero_reserva || 'BR-2026'}</span>
                                        </div>
                                        <span class="sucursal-badge">📍 {r.sucursal_nombre}</span>
                                    </div>
                                    <span class={`status-pill ${esEnCurso ? 'pill-en-curso' : 'pill-confirmada'}`}>
                                        {esEnCurso ? `🟢 En Mesa` : '⏳ Por Llegar'}
                                    </span>
                                </div>

                                <div class="asistencia-card-body">
                                    <div class="info-chips-grid">
                                        <span class="chip-item">📅 {r.fecha ? new Date(r.fecha).toLocaleDateString('es-ES') : 'Hoy'}</span>
                                        <span class="chip-item">🕐 Hora: <strong>{r.hora}</strong></span>
                                        <span class="chip-item">👥 Reservado: <strong>{totalPersonas} pers</strong></span>
                                        {r.cantidad_ninos > 0 && <span class="chip-item">🧒 {r.cantidad_ninos} niños</span>}
                                    </div>
                                    {esEnCurso && horaLlegada && (
                                        <div class="hora-llegada-info">
                                            ✅ Llegó a las <strong>{horaLlegada}</strong> con <strong>{r.personas_asistentes || cubiertos} personas presentes</strong>
                                        </div>
                                    )}
                                </div>

                                <div class="asistencia-card-footer">
                                    <button 
                                        type="button"
                                        class={`btn-llegada-action ${esEnCurso ? 'btn-modificar' : 'btn-registrar'}`}
                                        onclick={`window.abrirModalAsistencia(${r.id}, '${String(r.nombre_cliente).replace(/'/g, "\\'")}', ${cubiertos})`}>
                                        {esEnCurso ? '✏️ Modificar Asistencia' : '🙋‍♂️ Registrar Llegada del Cliente'}
                                    </button>
                                    
                                    <button 
                                        type="button"
                                        class="btn-liberar-action"
                                        onclick={`window.liberarCubiertosMesa(${r.id}, '${String(r.nombre_cliente).replace(/'/g, "\\'")}', ${cubiertos})`}
                                        title="Liberar cubiertos de la mesa al finalizar el servicio">
                                        🔓 Liberar Mesa
                                    </button>
                                    
                                    <a href={`https://wa.me/${r.telefono_completo || '591' + r.telefono}`} 
                                       target="_blank" 
                                       class="btn-wa-action" 
                                       title="Enviar mensaje por WhatsApp">
                                        💬
                                    </a>
                                </div>
                            </div>
                        );
                    })}
                </div>
            )}
        </div>

        <!-- ============================================
        SECCIÓN 2: USO DE CUBIERTOS
        ============================================ -->
        <div class="section-card">
            <div class="section-header">
                <h3>🪑 Uso de Cubiertos por Sucursal</h3>
                <span class="section-badge">Estado actual</span>
            </div>
            
            <div class="cubiertos-list">
                {cubiertos.map((sucursal: any) => {
                    const ocupados = Number(sucursal.cubiertos_ocupados) || 0;
                    const total = Number(sucursal.capacidad_total) || 120;
                    const disponibles = Number(sucursal.cubiertos_disponibles) || (total - ocupados);
                    const porcentaje = Math.min(100, Math.round((ocupados / total) * 100));
                    const color = porcentaje > 80 ? '#EF4444' : porcentaje > 60 ? '#F59E0B' : '#10B981';
                    const icono = sucursal.nombre.includes('Churrasquería') || sucursal.nombre.includes('Churrasqueria') ? '🔥' :
                                 sucursal.nombre.includes('Fast') ? '⚡' : '🥩';
                    
                    return (
                        <div class="cubiertos-item">
                            <div class="cubiertos-header">
                                <span class="cubiertos-icon">{icono}</span>
                                <span class="cubiertos-nombre">{sucursal.nombre}</span>
                                <span class="cubiertos-porcentaje" style={`color: ${color}`}>
                                    {porcentaje}%
                                </span>
                            </div>
                            
                            <div class="cubiertos-barra">
                                <div class="cubiertos-progreso" style={`width: ${porcentaje}%; background: ${color};`}></div>
                            </div>
                            
                            <div class="cubiertos-detalles">
                                <span>🪑 <strong>{ocupados}</strong> ocupados</span>
                                <span style="color: #10B981;">✅ <strong>{disponibles}</strong> disponibles</span>
                                <span style="color: #6B6B6B;">📋 Total: {total} cubiertos</span>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>

        <!-- ============================================
        SECCIÓN 3: RESERVAS RECIENTES
        ============================================ -->
        <div class="section-card">
            <div class="section-header">
                <h3>📋 Reservas Recientes</h3>
                <a href="/admin/reservas" class="btn-ver-todas">Ver todas →</a>
            </div>
            
            {reservasRecientes.length === 0 ? (
                <div class="empty-state">
                    <span class="empty-icon">📭</span>
                    <p>No hay reservas recientes registras en el sistema</p>
                </div>
            ) : (
                <div class="reservas-list">
                    {reservasRecientes.map((reserva: any) => (
                        <div class="reserva-item">
                            <div class="reserva-info">
                                <div>
                                    <span class="reserva-cliente">{reserva.nombre_cliente}</span>
                                    <span class="reserva-sucursal">📍 {reserva.sucursal_nombre}</span>
                                </div>
                                <span class={`estado-badge ${reserva.estado}`}>
                                    {reserva.estado === 'confirmada' ? '✅ Confirmada' :
                                     reserva.estado === 'pendiente' ? '⏳ Pendiente' :
                                     reserva.estado === 'rechazada' ? '❌ Rechazada' :
                                     '⏰ Cancelada'}
                                </span>
                            </div>
                            <div class="reserva-detalles">
                                <span>📅 {reserva.fecha ? new Date(reserva.fecha).toLocaleDateString('es-ES') : 'Hoy'}</span>
                                <span>🕐 {reserva.hora}</span>
                                <span>👥 {reserva.numero_personas} personas</span>
                                {reserva.telefono && <span>📞 {reserva.telefono}</span>}
                            </div>
                        </div>
                    ))}
                </div>
            )}
        </div>
    </div>

    <!-- Modal de Reportes Excel/PDF -->
    <div id="modalReportes" class="modal-reportes" style="display:none;">
        <div class="modal-reportes-content">
            <div class="modal-header">
                <div>
                    <h2>📊 Generar Reporte de Reservas</h2>
                    <p class="modal-subtext">Exporta todas las reservas en formato Excel o PDF</p>
                </div>
                <button type="button" class="modal-close" onclick="window.cerrarModalReportes()">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label for="fechaInicio">📅 Fecha Inicio</label>
                        <input type="date" id="fechaInicio" class="input-reporte" />
                    </div>
                    <div class="form-group">
                        <label for="fechaFin">📅 Fecha Fin</label>
                        <input type="date" id="fechaFin" class="input-reporte" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="sucursalReporte">📍 Sucursal</label>
                    <select id="sucursalReporte" class="input-reporte">
                        <option value="">Todas las sucursales</option>
                        <option value="1">🔥 Churrasquería</option>
                        <option value="2">⚡ Fast Grill</option>
                        <option value="3">🥩 Rodizio</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>📄 Formato de Exportación</label>
                    <div class="formato-options">
                        <button type="button" class="formato-btn active" data-formato="excel" onclick="window.seleccionarFormato('excel')">
                            📊 Excel (.xlsx)
                        </button>
                        <button type="button" class="formato-btn" data-formato="pdf" onclick="window.seleccionarFormato('pdf')">
                            📄 PDF (.pdf)
                        </button>
                    </div>
                    <input type="hidden" id="formatoReporte" value="excel" />
                </div>
                <div class="info-reporte">
                    <span class="info-icon">ℹ️</span>
                    <span class="info-text">El reporte incluirá todas las reservas del período seleccionado con todos los detalles.</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="window.cerrarModalReportes()">Cancelar</button>
                <button type="button" class="btn-generar" onclick="window.generarReporte()">📥 Descargar Reporte</button>
            </div>
        </div>
    <!-- Modal Didáctico para Registrar Asistencia -->
    <div id="modalAsistenciaDashboard" class="modal-reportes" style="display:none;">
        <div class="modal-reportes-content modal-asistencia-content">
            <div class="modal-header">
                <div>
                    <h2>🙋‍♂️ Registrar Asistencia del Cliente</h2>
                    <p class="modal-subtext" id="asistenciaModalClientInfo">Confirmar cuántas personas asistieron en total</p>
                </div>
                <button type="button" class="modal-close" onclick="window.cerrarModalAsistencia()">✕</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="asistenciaReservaId" />
                <input type="hidden" id="asistenciaCubiertosReservados" />
                
                <div class="counter-box">
                    <label style="font-size: 0.85rem; font-weight: 700; color: #1A1A1A;">👥 Personas Presentes / Asistentes:</label>
                    <div class="counter-control">
                        <button type="button" class="btn-count-step" onclick="window.cambiarContadorAsistencia(-1)">-</button>
                        <input type="number" id="inputPersonasAsistentes" value="1" min="1" max="100" oninput="window.actualizarPreviewCubiertos()" />
                        <button type="button" class="btn-count-step" onclick="window.cambiarContadorAsistencia(1)">+</button>
                    </div>
                </div>

                <div class="preview-cubiertos-box" id="previewCubiertosBox">
                    <span class="preview-icon">🪑</span>
                    <div class="preview-text" id="previewCubiertosText">
                        Confirmando asistencia...
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="window.cerrarModalAsistencia()">Cancelar</button>
                <button type="button" id="btnConfirmarAsistenciaModal" class="btn-generar btn-confirmar-asistencia" onclick="window.guardarAsistenciaDashboard()">
                    ✅ Confirmar Llegada
                </button>
            </div>
        </div>
    </div>

    <!-- 🔴 BURBUJA FLOTANTE DE RESERVAS FUTURAS -->
    <BurbujaFuturas />

    <!-- 🔴 MODAL DE RESERVAS FUTURAS -->
    <ModalFuturas />

    <!-- 🔴 MODAL DE ALERTAS (se muestra automáticamente si hay reservas mañana) -->
    <ModalAlertas />
</AdminLayout>

<style>
.btn-excel { background: #C9A87C; color: #1A1A1A; }

/* ============================================
   CONTROL DE ASISTENCIA Y RECEPCIÓN EN VIVO
   ============================================ */
.asistencia-section {
    border-top: 4px solid #10B981;
}

.section-subtitle {
    font-size: 0.8rem;
    color: #6B7280;
    margin: 2px 0 0;
}

.badge-asistencia-summary {
    font-size: 0.78rem;
    background: rgba(16, 185, 129, 0.1);
    color: #047857;
    padding: 6px 14px;
    border-radius: 50px;
    border: 1px solid rgba(16, 185, 129, 0.2);
    font-weight: 600;
}

.asistencia-search-bar {
    margin-bottom: 18px;
}

.asistencia-search-bar input {
    width: 100%;
    padding: 12px 18px;
    border: 1.5px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    font-size: 0.92rem;
    background: #F9FAFB;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s ease;
    box-sizing: border-box;
}

.asistencia-search-bar input:focus {
    outline: none;
    border-color: #10B981;
    background: white;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
}

.asistencia-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
}

.asistencia-card {
    background: white;
    border-radius: 16px;
    padding: 18px 20px;
    border: 1.5px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: all 0.25s ease;
}

.asistencia-card.card-confirmada {
    border-left: 5px solid #F59E0B;
}

.asistencia-card.card-en-curso {
    border-left: 5px solid #10B981;
    background: rgba(240, 253, 244, 0.4);
}

.asistencia-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
}

.client-title-row {
