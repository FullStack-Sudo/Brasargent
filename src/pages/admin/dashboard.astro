    gap: 16px;
    font-size: 0.8rem;
    color: #4B5563;
    flex-wrap: wrap;
}

/* ============================================
   RESERVAS LIST
   ============================================ */
.reservas-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.reserva-item {
    background: #F9FAFB;
    border-radius: 14px;
    padding: 14px 18px;
    border: 1px solid rgba(0, 0, 0, 0.04);
}

.reserva-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 8px;
}

.reserva-cliente {
    font-weight: 700;
    font-size: 0.95rem;
    color: #1A1A1A;
    display: block;
}

.reserva-sucursal {
    font-size: 0.75rem;
    color: #6B6B6B;
}

.reserva-detalles {
    display: flex;
    gap: 12px;
    font-size: 0.78rem;
    color: #4B5563;
    flex-wrap: wrap;
}

.estado-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 50px;
    white-space: nowrap;
}

.estado-badge.confirmada { background: rgba(16, 185, 129, 0.12); color: #10B981; }
.estado-badge.pendiente { background: rgba(245, 158, 11, 0.12); color: #F59E0B; }
.estado-badge.rechazada { background: rgba(239, 68, 68, 0.12); color: #EF4444; }
.estado-badge.cancelada { background: rgba(107, 114, 128, 0.12); color: #6B7280; }

.empty-state {
    text-align: center;
    padding: 32px 16px;
    word-break: break-word;
    overflow-wrap: break-word;
}

.empty-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 8px;
}

.empty-state p {
    font-size: 0.95rem;
    font-weight: 500;
    color: #4B5563;
    margin: 0;
    word-break: break-word;
    overflow-wrap: break-word;
}

/* ============================================
   RESPONSIVE MÓVIL
   ============================================ */
@media (max-width: 768px) {
    .dashboard-column {
        padding: 0 2px;
        width: 100%;
        max-width: 100%;
    }

    .dashboard-top-bar {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    .header-actions {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .btn-reporte, .btn-reiniciar {
        width: 100%;
        justify-content: center;
    }
}

@media (max-width: 580px) {
    .stats-grid {
        grid-template-columns: 1fr;
        gap: 10px;
    }
    
    .stat-card {
        padding: 14px 16px;
        flex-direction: row;
        text-align: left;
        gap: 14px;
        border-left: 4px solid #C9A87C;
        border-top: none;
    }
    
    .stat-icon { font-size: 1.6rem; }
    .stat-number { font-size: 1.3rem; }
    .stat-label { font-size: 0.65rem; }
    
    .section-card { padding: 16px 14px; }
}
</style>

<script is:inline>
window.seleccionarFormato = function(fmt) {
    document.querySelectorAll('.formato-btn').forEach(btn => btn.classList.remove('active'));
    const btn = document.querySelector(`.formato-btn[data-formato="${fmt}"]`);
    if (btn) btn.classList.add('active');
    const inputFmt = document.getElementById('formatoReporte');
    if (inputFmt) inputFmt.value = fmt;
};

window.abrirModalReportes = function() {
    const m = document.getElementById('modalReportes');
    if (m) {
        m.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }
};

window.cerrarModalReportes = function() {
    const m = document.getElementById('modalReportes');
    if (m) {
        m.style.display = 'none';
        document.body.style.overflow = '';
    }
};

window.generarReporteConFormato = async function(fmt, fechaInicio, fechaFin, sucursalId) {
    const btnGenerar = document.querySelector('.btn-generar');
    const originalText = btnGenerar ? btnGenerar.textContent : 'Descargar Reporte';
    
    let url = `/api/reportes/reservas?formato=${fmt || 'excel'}`;
    if (fechaInicio) url += `&fecha_inicio=${fechaInicio}`;
    if (fechaFin) url += `&fecha_fin=${fechaFin}`;
    if (sucursalId) url += `&sucursal_id=${sucursalId}`;

    try {
        if (btnGenerar) {
            btnGenerar.disabled = true;
            btnGenerar.textContent = '⏳ Generando...';
        }

        const res = await fetch(url);

        if (!res.ok) {
            let errorMsg = 'No existen reservas actualmente para los filtros seleccionados.';
            try {
                const data = await res.json();
                if (data.error) errorMsg = data.error;
            } catch (e) {}

            alert(`⚠️ ${errorMsg}`);
            return;
        }

        const blob = await res.blob();
        const downloadUrl = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = downloadUrl;
        a.download = fmt === 'pdf' 
            ? `reservas_brasargent_${new Date().toISOString().split('T')[0]}.pdf`
            : `reservas_brasargent_${new Date().toISOString().split('T')[0]}.xlsx`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        window.URL.revokeObjectURL(downloadUrl);

        window.cerrarModalReportes();
    } catch (err) {
        alert('❌ Error de conexión al generar el reporte.');
    } finally {
        if (btnGenerar) {
            btnGenerar.disabled = false;
            btnGenerar.textContent = originalText;
        }
    }
};

window.generarReporte = function() {
    const fechaInicio = document.getElementById('fechaInicio')?.value;
    const fechaFin = document.getElementById('fechaFin')?.value;
    const sucursalId = document.getElementById('sucursalReporte')?.value;
    const formato = document.getElementById('formatoReporte')?.value || 'excel';

    if (fechaInicio && fechaFin && fechaInicio > fechaFin) {
        alert('⚠️ La fecha de inicio debe ser anterior o igual a la fecha fin.');
        return;
    }

    window.generarReporteConFormato(formato, fechaInicio, fechaFin, sucursalId);
};

window.imprimirReporte = function() {
    window.print();
};

window.descargarPDF = function() {
    window.generarReporteConFormato('pdf');
};

window.reiniciarReservas = async function() {
    if (!confirm('⚠️ ¿Estás seguro de que deseas reiniciar las reservas ocupadas del día?')) return;
    try {
        const res = await fetch('/api/reservas/reiniciar', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            alert('✅ Reservas reiniciadas con éxito.');
            window.location.reload();
        } else {
            alert('❌ Error: ' + (data.error || 'No se pudo reiniciar'));
        }
    } catch (e) {
        alert('❌ Error de conexión al reiniciar reservas.');
    }
};
</script>
