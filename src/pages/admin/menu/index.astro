---
// src/pages/admin/menu/index.astro
// Gestión de menú por sucursal

import AdminLayout from '../../../layouts/AdminLayout.astro';
import pool from '../../../lib/db';

// Obtener todas las sucursales con sus platos
const sucursales = await pool.query(`
    SELECT 
        s.id,
        s.nombre,
        s.concepto,
        s.rating,
        s.resenas,
        s.direccion,
        s.horario,
        s.telefono,
        s.capacidad,
        s.capacidad_total,
        s.cubiertos_disponibles,
        s.cubiertos_ocupados,
        COUNT(DISTINCT ms.plato_id) AS total_platos,
        SUM(CASE WHEN ms.disponible = 1 THEN 1 ELSE 0 END) AS disponibles,
        SUM(CASE WHEN ms.disponible = 0 THEN 1 ELSE 0 END) AS agotados
    FROM sucursales s
    LEFT JOIN menu_sucursal ms ON s.id = ms.sucursal_id
    WHERE s.activo = 1
    GROUP BY s.id
    ORDER BY s.nombre
`) as any[];

const dataSucursales = sucursales[0] || [];

// Calcular totales
const totalSucursales = dataSucursales.length;
const totalPlatos = dataSucursales.reduce((acc: any, s: any) => acc + (s.total_platos || 0), 0);
const totalDisponibles = dataSucursales.reduce((acc: any, s: any) => acc + (s.disponibles || 0), 0);

const formatearRating = (rating: any) => {
    return rating ? Number(rating).toFixed(1) : '0';
};
---

<AdminLayout title="Menú" description="Administra los platos y disponibilidad por sucursal">
    <!-- Estadísticas -->


    <!-- Tarjetas de Sucursales -->
    <div class="sucursales-grid">
        {dataSucursales.map((sucursal: any) => {
            const color = sucursal.nombre === 'Churrasquería' ? '#9e2a2b' :
                         sucursal.nombre === 'Fast Grill' ? '#d4af37' : '#d4a574';
            const icono = sucursal.nombre === 'Churrasquería' ? '🔥' :
                         sucursal.nombre === 'Fast Grill' ? '⚡' : '🥩';
            
            return (
                <div class="sucursal-card" style={`border-top: 4px solid ${color}`}>
                    <div class="sucursal-header">
                        <div class="sucursal-info">
                            <span class="sucursal-icon" style={`color: ${color}`}>{icono}</span>
                            <div>
                                <h3>{sucursal.nombre}</h3>
                                <span class="sucursal-concepto">{sucursal.concepto || 'Restaurante'}</span>
                            </div>
                        </div>
                        <div class="sucursal-rating">
                            ★ {formatearRating(sucursal.rating)}
                            <span>({sucursal.resenas || 0})</span>
                        </div>
                    </div>
                    
                    <div class="sucursal-detalles">
                        <p>📍 {sucursal.direccion}</p>
                        <p>🕐 {sucursal.horario}</p>
                        <p>📞 <a href={`https://wa.me/${sucursal.telefono}`} target="_blank">{sucursal.telefono}</a></p>
                        <p>💺 Capacidad: {sucursal.capacidad_total || sucursal.capacidad || 0} cubiertos</p>
                    </div>
                    
                    <div class="sucursal-platos">
                        <div class="plato-stats">
                            <span>🍽️ {sucursal.total_platos || 0} Platos</span>
                            <span class="disponible">✅ {sucursal.disponibles || 0} Disp.</span>
                            <span class="agotado">❌ {sucursal.agotados || 0} Agot.</span>
                        </div>
                    </div>
                    
                    <div class="sucursal-actions">
                        <a href={`/admin/menu/sucursal/${sucursal.id}`} class="btn-ver-menu">
                            👁️ Ver Menú
                        </a>
                        <a href={`/admin/sucursales/editar/${sucursal.id}`} class="btn-editar">
                            ✏️ Editar
                        </a>
                    </div>
                </div>
            );
        })}
    </div>
</AdminLayout>

<style is:global>
/* ============================================
   ESTILOS DE MENÚ
   ============================================ */
.sucursales-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
    margin-top: 24px;
}

.sucursal-card {
    background: white;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    transition: all 0.3s ease;
    border-top: 4px solid #9e2a2b;
}

.sucursal-card:hover {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
    transform: translateY(-4px);
}

.sucursal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
}

.sucursal-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.sucursal-icon {
    font-size: 2rem;
}

.sucursal-info h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
}

.sucursal-concepto {
    font-size: 0.75rem;
    color: rgba(26, 26, 26, 0.4);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.sucursal-rating {
    font-size: 0.9rem;
    font-weight: 600;
    color: #d4af37;
}

.sucursal-rating span {
    font-weight: 400;
    color: rgba(26, 26, 26, 0.3);
}

.sucursal-detalles {
    background: rgba(255, 250, 240, 0.5);
    border-radius: 10px;
    padding: 12px 16px;
    margin: 12px 0 16px;
}

.sucursal-detalles p {
    margin: 4px 0;
    font-size: 0.85rem;
    color: #1a1a1a;
}

.sucursal-detalles a {
    color: #25d366;
    text-decoration: none;
}

.sucursal-platos {
    margin-bottom: 16px;
}

.plato-stats {
    display: flex;
    gap: 16px;
    font-size: 0.85rem;
    font-weight: 500;
}

.plato-stats .disponible {
    color: #10b981;
}

.plato-stats .agotado {
    color: #ef4444;
}

.sucursal-actions {
    display: flex;
    gap: 10px;
}

.btn-ver-menu,
.btn-editar {
    flex: 1;
    padding: 10px 16px;
    border: none;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
}

.btn-ver-menu {
    background: rgba(158, 42, 43, 0.08);
    color: #9e2a2b;
}

.btn-ver-menu:hover {
    background: rgba(158, 42, 43, 0.15);
    transform: scale(1.02);
}

.btn-editar {
    background: rgba(26, 26, 26, 0.04);
    color: #1a1a1a;
}

.btn-editar:hover {
    background: rgba(26, 26, 26, 0.08);
    transform: scale(1.02);
}

@media (max-width: 768px) {
    .sucursales-grid {
        grid-template-columns: 1fr;
    }
}
</style>
