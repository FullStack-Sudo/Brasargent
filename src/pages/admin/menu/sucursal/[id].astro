---
// src/pages/admin/menu/sucursal/[id].astro
// Gestión de menú — Premium Dashboard
import "../../../../styles/global.css";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import PlatoCard from "../../../../components/admin/PlatoCard.astro";
import ModalEditarPlato from "../../../../components/admin/ModalEditarPlato.astro";
import ModalCrearPlato from "../../../../components/admin/ModalCrearPlato.astro";
import ModalImagenPlato from "../../../../components/admin/ModalImagenPlato.astro";
import { getMenuSucursal } from "../../../../lib/queries/menu";

// Auth check
const session = Astro.cookies.get("session");
if (!session || session.value !== "authenticated") {
    return Astro.redirect("/admin/login");
}

const sucursalId = Number(Astro.params.id);
if (isNaN(sucursalId)) {
    return Astro.redirect("/admin/menu");
}

let data: any;
let error = "";

try {
    data = await getMenuSucursal(sucursalId);
    if (!data || !data.sucursal) {
        return Astro.redirect("/admin/menu");
    }
} catch (e) {
    error = "Error al cargar el menú de la sucursal.";
}

// Agrupar platos por categoría
const categorias: Record<string, any[]> = {};
if (data?.platos) {
    data.platos.forEach((plato: any) => {
        const cat = plato.categoria || 'General';
        if (!categorias[cat]) {
            categorias[cat] = [];
        }
        categorias[cat].push(plato);
    });
}

// Estadísticas rápidas
const totalPlatos = data?.platos?.length || 0;
const disponibles = data?.platos?.filter((p: any) => Boolean(p.disponible)).length || 0;
const agotados = totalPlatos - disponibles;
const destacados = data?.platos?.filter((p: any) => Boolean(p.destacado)).length || 0;

// Sucursal color/icon mapping
const sucursalStyles: Record<string, { color: string; icon: string }> = {
    'Churrasquería': { color: '#9e2a2b', icon: '🔥' },
    'Fast Grill': { color: '#d4af37', icon: '⚡' },
    'Rodizio': { color: '#d4a574', icon: '🥩' },
};
const style = sucursalStyles[data?.sucursal?.nombre] || { color: '#9e2a2b', icon: '🍽️' };
---

<AdminLayout title={`Menú: ${data?.sucursal?.nombre || 'Sucursal'}`} description="Gestión de platos y disponibilidad del menú" currentPage="menu">
    <div class="sp-container">
        {error ? (
            <div class="sp-error">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>{error}</span>
            </div>
        ) : (
            <>
                <!-- Breadcrumb -->
                <a href="/admin/menu" class="sp-back-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Volver a Menús por Sucursal
                </a>

                <!-- Hero Header -->
                <div class="sp-hero" style={`--accent: ${style.color}`}>
                    <div class="sp-hero-left">
                        <div class="sp-hero-icon" style={`background: ${style.color}`}>
                            <span>{style.icon}</span>
                        </div>
                        <div>
                            <h1 class="sp-hero-title">{data.sucursal.nombre}</h1>
                            <p class="sp-hero-address">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                {data.sucursal.direccion}
                            </p>
                        </div>
                    </div>
                    <div class="sp-hero-right">
                        <button id="btnAñadirPlato" class="sp-btn-add" style={`background: ${style.color}`} type="button">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Añadir Plato
                        </button>
                    </div>
                </div>

                <!-- Stats Row -->
                <div class="sp-stats-row">
                    <div class="sp-stat-card">
                        <div class="sp-stat-icon sp-stat-icon--total">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg>
                        </div>
                        <div class="sp-stat-info">
                            <span class="sp-stat-value">{totalPlatos}</span>
                            <span class="sp-stat-label">Platos totales</span>
                        </div>
                    </div>
                    <div class="sp-stat-card">
                        <div class="sp-stat-icon sp-stat-icon--available">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        </div>
                        <div class="sp-stat-info">
                            <span class="sp-stat-value" style="color:#059669;">{disponibles}</span>
                            <span class="sp-stat-label">Disponibles</span>
                        </div>
                    </div>
                    <div class="sp-stat-card">
                        <div class="sp-stat-icon sp-stat-icon--sold">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                        </div>
                        <div class="sp-stat-info">
                            <span class="sp-stat-value" style="color:#dc2626;">{agotados}</span>
                            <span class="sp-stat-label">Agotados</span>
                        </div>
                    </div>
                    <div class="sp-stat-card">
                        <div class="sp-stat-icon sp-stat-icon--featured">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        </div>
                        <div class="sp-stat-info">
                            <span class="sp-stat-value" style="color:#d97706;">{destacados}</span>
                            <span class="sp-stat-label">Destacados</span>
                        </div>
                    </div>
                </div>

                <!-- Menu by Category -->
                <div class="sp-categories">
                    {Object.keys(categorias).length === 0 ? (
                        <div class="sp-empty">
                            <div class="sp-empty-icon">🍽️</div>
                            <h3 class="sp-empty-title">No hay platos registrados</h3>
                            <p class="sp-empty-text">Esta sucursal aún no tiene elementos en su menú.</p>
                            <button id="btnAñadirPlatoEmpty" class="sp-btn-add sp-btn-add--outline" style={`color: ${style.color}; border-color: ${style.color}`} type="button">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                Añadir primer plato
                            </button>
                        </div>
                    ) : (
                        Object.entries(categorias).map(([categoria, platosArr]) => (
                            <section class="sp-category-section">
                                <div class="sp-category-header">
                                    <div class="sp-category-bar" style={`background: ${style.color}`}></div>
                                    <h2 class="sp-category-name">{categoria}</h2>
                                    <span class="sp-category-count">{platosArr.length} {platosArr.length === 1 ? 'plato' : 'platos'}</span>
                                </div>
                                
                                <div class="sp-platos-grid">
                                    {platosArr.map((plato: any) => (
                                        <PlatoCard plato={plato} sucursalId={sucursalId} />
                                    ))}
                                </div>
                            </section>
                        ))
                    )}
                </div>
            </>
        )}
    </div>

    <!-- Modales -->
    <ModalCrearPlato />
    <ModalEditarPlato />
    <ModalImagenPlato />
    
    <!-- Toast Container -->
    <div id="toastContainer" class="sp-toast-container"></div>

    <!-- Scripts de Interacción -->
    <script>
        function showToast(message: string, type: 'success' | 'error' = 'success') {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            
            const toast = document.createElement('div');
            toast.className = `sp-toast ${type === 'success' ? 'sp-toast--success' : 'sp-toast--error'}`;
            
            const icon = type === 'success' 
                ? `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`
                : `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`;
                
            toast.innerHTML = `${icon} <span>${message}</span>`;
            container.appendChild(toast);
            
            // Trigger animation
            requestAnimationFrame(() => toast.classList.add('sp-toast--visible'));
            
            setTimeout(() => {
                toast.classList.remove('sp-toast--visible');
                toast.addEventListener('transitionend', () => toast.remove());
            }, 3500);
        }

        // Make showToast available globally for ModalImagenPlato
        (window as any).showToast = showToast;

        document.addEventListener('DOMContentLoaded', () => {
            // Toggle Disponibilidad
            const toggleBtns = document.querySelectorAll('.btn-toggle-status');
            toggleBtns.forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const target = e.currentTarget as HTMLButtonElement;
                    const platoId = target.dataset.id;
                    const sucursalId = target.dataset.sucursal;
                    const currentStatus = target.dataset.status === '1';
                    const newStatus = !currentStatus;
                    
                    target.dataset.status = newStatus ? '1' : '0';
                    const card = target.closest('.plato-card');
                    const badge = card?.querySelector('.status-badge');
                    
                    if (badge) {
                        if (newStatus) {
                            badge.textContent = 'Disponible';
                            badge.className = 'pc-badge status-badge pc-badge--available';
                        } else {
                            badge.textContent = 'Agotado';
                            badge.className = 'pc-badge status-badge pc-badge--sold';
                        }
                    }

                    try {
                        const res = await fetch('/api/menu/plato/toggle', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                sucursal_id: Number(sucursalId),
                                plato_id: Number(platoId),
                                disponible: newStatus
                            })
                        });
                        
                        const data = await res.json();
                        if (!data.success) throw new Error(data.message);
                        showToast(newStatus ? 'Plato marcado como disponible' : 'Plato marcado como agotado');
                    } catch (error) {
                        showToast('Error al actualizar disponibilidad', 'error');
                        setTimeout(() => window.location.reload(), 1000);
                    }
                });
            });

            // Eliminar Plato
            const deleteBtns = document.querySelectorAll('.btn-delete-plato');
            deleteBtns.forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const target = e.currentTarget as HTMLButtonElement;
                    const platoId = target.dataset.id;
                    const nombre = target.dataset.nombre || 'este plato';
                    const sucursalId = target.dataset.sucursal;

                    if (!confirm(`🗑️ ¿Estás seguro de eliminar "${nombre}" del menú de esta sucursal?`)) {
                        return;
                    }

                    try {
                        target.disabled = true;
                        const res = await fetch('/api/menu/plato/delete', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                plato_id: Number(platoId),
                                sucursal_id: Number(sucursalId)
                            })
                        });

                        const data = await res.json();
                        if (!data.success) throw new Error(data.message);

                        showToast(`"${nombre}" eliminado del menú correctamente`);
                        setTimeout(() => window.location.reload(), 500);
                    } catch (error: any) {
                        showToast(error.message || 'Error al eliminar el plato', 'error');
                        target.disabled = false;
                    }
                });
            });

            // Modal Crear
            const modalCrear = document.getElementById('modalCrearPlato');
            const formCrear = document.getElementById('formCrearPlato') as HTMLFormElement;
            
            const openCrearModal = () => {
                if (!modalCrear) return;
                const inputSuc = document.getElementById('create_sucursal_id') as HTMLInputElement;
                if (inputSuc) inputSuc.value = window.location.pathname.split('/').pop() || '1';
                modalCrear.classList.add('modal-active');
            };

            document.getElementById('btnAñadirPlato')?.addEventListener('click', openCrearModal);
            document.getElementById('btnAñadirPlatoEmpty')?.addEventListener('click', openCrearModal);

            const closeCrearModal = () => {
                modalCrear?.classList.remove('modal-active');
                formCrear?.reset();
            };

            document.getElementById('btnCerrarModalCrear')?.addEventListener('click', closeCrearModal);
            document.getElementById('btnCancelarCrear')?.addEventListener('click', closeCrearModal);
            document.getElementById('modalCrearOverlay')?.addEventListener('click', closeCrearModal);

            formCrear?.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(formCrear);

                // Ensure sucursal_id is set
                const rawSucId = formData.get('sucursal_id');
                if (!rawSucId || rawSucId === '') {
                    formData.set('sucursal_id', window.location.pathname.split('/').pop() || '1');
                }

                // Ensure destacado value
                if (!formData.get('destacado')) {
                    formData.set('destacado', '0');
                }

                try {
                    // Send as FormData (multipart) so the image file is included
                    const res = await fetch('/api/menu/plato/create', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await res.json();
                    if (!result.success) throw new Error(result.message || 'Error al crear plato');

                    showToast('Plato creado exitosamente');
                    closeCrearModal();
                    setTimeout(() => window.location.reload(), 600);
                } catch (err: any) {
                    showToast(err.message || 'Error al crear plato', 'error');
                }
            });

            // Modal Editar
            const modalEditar = document.getElementById('modalEditarPlato');
            const formEditar = document.getElementById('formEditarPlato') as HTMLFormElement;
            const editBtns = document.querySelectorAll('.btn-edit-plato');

            editBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const target = e.currentTarget as HTMLButtonElement;
                    if (!modalEditar) return;
                    
                    const id = target.dataset.id || '';
                    const nombre = target.dataset.nombre || '';
                    const descripcion = target.dataset.descripcion || '';
                    const precio = target.dataset.precio || '';
                    const categoria = target.dataset.categoria || '';
                    const categoriaId = target.dataset.categoriaId || '';
                    const imagen = target.dataset.imagen || '';
                    const destacado = target.dataset.destacado === '1';

                    const inputId = document.getElementById('edit_plato_id') as HTMLInputElement;
                    const inputNombre = document.getElementById('edit_nombre') as HTMLInputElement;
                    const inputDesc = document.getElementById('edit_descripcion') as HTMLTextAreaElement;
                    const inputPrecio = document.getElementById('edit_precio') as HTMLInputElement;
                    const inputDestacado = document.getElementById('edit_destacado') as HTMLInputElement;

                    if (inputId) inputId.value = id;
                    if (inputNombre) inputNombre.value = nombre;
                    if (inputDesc) {
                        inputDesc.value = descripcion;
                        const charCounter = document.getElementById('edit_charCounter');
                        if (charCounter) charCounter.textContent = `${descripcion.length}/500`;
                    }
                    if (inputPrecio) inputPrecio.value = precio;
                    if (inputDestacado) inputDestacado.checked = destacado;

                    const catSelect = document.getElementById('edit_categoria') as HTMLSelectElement;
                    if (catSelect) {
                        const foundOpt = Array.from(catSelect.options).find(
                            opt => opt.value === String(categoriaId) ||
                                   opt.value === String(categoria) ||
                                   opt.text.trim().toLowerCase() === String(categoria).trim().toLowerCase()
                        );
                        if (foundOpt) {
                            catSelect.value = foundOpt.value;
                        } else if (catSelect.options.length > 1) {
                            catSelect.selectedIndex = 1;
                        }
                    }

                    // Previsualizar la imagen actual del plato
                    const previewContainer = document.getElementById('previewContainerEdit');
                    const previewImage = document.getElementById('previewImageEdit') as HTMLImageElement;
                    const uploadContent = document.getElementById('uploadContentEdit');
                    const fileInput = document.getElementById('edit_imagenInput') as HTMLInputElement;
                    if (fileInput) fileInput.value = '';

                    if (imagen && previewImage && previewContainer && uploadContent) {
                        previewImage.src = imagen;
                        previewContainer.style.display = 'flex';
                        uploadContent.style.display = 'none';
                    } else if (previewContainer && uploadContent) {
                        previewContainer.style.display = 'none';
                        uploadContent.style.display = 'flex';
                        if (previewImage) previewImage.removeAttribute('src');
                    }

                    modalEditar.classList.add('modal-active');
                });
            });

            const closeEditarModal = () => {
                modalEditar?.classList.remove('modal-active');
                formEditar?.reset();
            };

            document.getElementById('btnCerrarModalEditar')?.addEventListener('click', closeEditarModal);
            document.getElementById('btnCancelarEditar')?.addEventListener('click', closeEditarModal);
            document.getElementById('modalEditarOverlay')?.addEventListener('click', closeEditarModal);

            formEditar?.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(formEditar);

                try {
                    const res = await fetch('/api/menu/plato/update', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await res.json();
                    if (!result.success) throw new Error(result.message || 'Error al actualizar plato');

                    showToast('Plato actualizado correctamente');
                    closeEditarModal();
                    setTimeout(() => window.location.reload(), 600);
                } catch (err: any) {
                    showToast(err.message || 'Error al actualizar plato', 'error');
                }
            });

            // Modal Imagen
            const modalImagen = document.getElementById('modalImagenPlato');
            const uploadBtns = document.querySelectorAll('.btn-upload-img');
            
            uploadBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const target = e.currentTarget as HTMLButtonElement;
                    const platoId = target.dataset.id || '';
                    const inputPlato = document.getElementById('upload_plato_id') as HTMLInputElement;
                    if (inputPlato) inputPlato.value = platoId;
                    modalImagen?.classList.add('modal-active');
                });
            });

            const closeImagenModal = () => {
                modalImagen?.classList.remove('modal-active');
            };

            document.getElementById('btnCerrarModalImagen')?.addEventListener('click', closeImagenModal);
            document.getElementById('modalImagenOverlay')?.addEventListener('click', closeImagenModal);
        });
    </script>
</AdminLayout>

<style is:global>
    /* ===== CONTAINER ===== */
    .sp-container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ===== ERROR ===== */
    .sp-error {
        display: flex; align-items: center; gap: .75rem;
        padding: 1rem 1.25rem;
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        border-radius: 1rem;
        font-size: .875rem; font-weight: 500;
    }

    /* ===== BACK LINK ===== */
    .sp-back-link {
        display: inline-flex; align-items: center; gap: .4rem;
        color: #8b8b94; font-size: .82rem; font-weight: 600;
        text-decoration: none;
        margin-bottom: 1.25rem;
        transition: color .2s;
    }
    .sp-back-link:hover { color: #9e2a2b; }

    /* ===== HERO HEADER ===== */
    .sp-hero {
        display: flex; align-items: center;
        justify-content: space-between;
        flex-wrap: wrap; gap: 1rem;
        padding: 1.5rem 2rem;
        background: #fff;
        border-radius: 1.25rem;
        border: 1px solid #f0f0f2;
        box-shadow: 0 2px 12px rgba(0,0,0,.04);
        margin-bottom: 1.25rem;
    }
    .sp-hero-left {
        display: flex; align-items: center; gap: 1rem;
    }
    .sp-hero-icon {
        width: 52px; height: 52px;
        border-radius: 1rem;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(0,0,0,.15);
    }
    .sp-hero-title {
        font-family: 'Playfair Display', Georgia, serif !important;
        font-size: 1.6rem !important; font-weight: 700 !important;
        color: #1a1a1f !important;
        margin: 0 !important; line-height: 1.2 !important;
    }
    .sp-hero-address {
        display: flex; align-items: center; gap: .35rem;
        color: #8b8b94 !important;
        font-size: .82rem !important;
        margin: .25rem 0 0 !important;
    }
    .sp-hero-right { display: flex; align-items: center; }

    .sp-btn-add {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .65rem 1.4rem;
        color: #fff;
        border: none; border-radius: .75rem;
        font-size: .82rem; font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(0,0,0,.2);
        transition: all .25s;
        font-family: inherit;
    }
    .sp-btn-add:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(0,0,0,.25);
    }
    .sp-btn-add:active { transform: translateY(0) scale(.98); }
    .sp-btn-add--outline {
        background: transparent !important;
        border: 2px solid currentColor;
        box-shadow: none;
    }
    .sp-btn-add--outline:hover {
        box-shadow: 0 4px 14px rgba(0,0,0,.08);
    }

    /* ===== STATS ROW ===== */
    .sp-stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: .75rem;
        margin-bottom: 2rem;
    }
    @media (max-width: 768px) {
        .sp-stats-row { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 420px) {
        .sp-stats-row { grid-template-columns: 1fr 1fr; }
    }

    .sp-stat-card {
        display: flex; align-items: center; gap: .875rem;
        padding: 1rem 1.2rem;
        background: #fff;
        border-radius: 1rem;
        border: 1px solid #f0f0f2;
        box-shadow: 0 1px 4px rgba(0,0,0,.03);
        transition: box-shadow .2s, transform .2s;
    }
