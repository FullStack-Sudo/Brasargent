---
// src/pages/admin/openwa.astro
// Panel de gestión OpenWA por sucursal

import AdminLayout from '../../layouts/AdminLayout.astro';
import { inicializarSesiones, obtenerSesiones } from '../../lib/openwa-sesiones';

// ============================================
// OBTENER USUARIO
// ============================================
const usuario = Astro.locals.usuario;
const esSuperAdmin = usuario?.es_super_admin === true ||
    Astro.cookies.get('es_super_admin')?.value === 'true';
const userSucursal = usuario?.sucursal_id ||
    Astro.cookies.get('user_sucursal')?.value;

// ============================================
// INICIALIZAR Y OBTENER SESIONES
// ============================================
await inicializarSesiones();
const sesiones = await obtenerSesiones(esSuperAdmin, userSucursal);
---

<AdminLayout title="OpenWA WhatsApp" description="Gestión de sesiones de WhatsApp" currentPage="openwa">
    <div class="openwa-page">
        <!-- Header -->
        <div class="page-header">
            <div>
                <h1>💬 OpenWA - WhatsApp Independiente</h1>
                <p>Gestiona las sesiones de WhatsApp independientes por sucursal</p>
            </div>
            {esSuperAdmin && (
                <div class="super-admin-badge">
                    👑 Super Admin - Control Total
                </div>
            )}
        </div>

        <!-- Grid de sesiones -->
        <div class="sesiones-grid">
            {sesiones.map((sesion: any) => (
                <div class="sesion-card" data-sucursal={sesion.sucursal_id}>
                    <div class="sesion-header">
                        <div class="sesion-info">
                            <span class="sesion-icono">{sesion.sucursal_icono || '🏪'}</span>
                            <div>
                                <h3>{sesion.sucursal_nombre}</h3>
                                <span class="sesion-name">Sesión: {sesion.session_name}</span>
                            </div>
                        </div>
                        <span class={`sesion-status ${sesion.status}`}>
                            {sesion.status === 'connected' ? '🟢 Conectado' :
                             sesion.status === 'connecting' ? '🟡 Conectando' :
                             sesion.status === 'qr_pending' ? '🟠 Esperando QR' :
                             '🔴 Desconectado'}
                        </span>
                    </div>

                    {sesion.telefono && (
                        <div class="sesion-telefono">
                            📱 <strong>{sesion.telefono}</strong>
                            {sesion.push_name && (
                                <span class="sesion-nombre">({sesion.push_name})</span>
                            )}
                        </div>
                    )}

                    <div class="sesion-acciones">
                        {sesion.status === 'connected' ? (
                            <>
                                <button class="btn-accion btn-desconectar" data-action="desconectar" data-sucursal={sesion.sucursal_id}>
                                    🔴 Desconectar
                                </button>
                                <button class="btn-accion btn-test" data-action="test" data-sucursal={sesion.sucursal_id}>
                                    📤 Enviar Test
                                </button>
                            </>
                        ) : sesion.status === 'qr_pending' ? (
                            <>
                                <button class="btn-accion btn-conectar" data-action="conectar" data-sucursal={sesion.sucursal_id}>
                                    🔄 Ver QR
                                </button>
                                <button class="btn-accion btn-desconectar" data-action="desconectar" data-sucursal={sesion.sucursal_id}>
                                    🔴 Cancelar
                                </button>
                            </>
                        ) : (
                            <button class="btn-accion btn-conectar" data-action="conectar" data-sucursal={sesion.sucursal_id}>
                                📱 Conectar WhatsApp
                            </button>
                        )}
                    </div>
                </div>
            ))}
        </div>
    </div>

    <!-- Modal QR -->
    <div id="modalQR" class="modal-overlay" style="display: none;">
        <div class="modal-container">
            <div class="modal-header">
                <h2>📱 Escanear Código QR</h2>
                <button class="modal-close" data-action="cerrar-qr">✕</button>
            </div>
            <div class="modal-body">
                <div class="qr-container">
                    <img id="qrImage" src="" alt="Código QR" />
                </div>
                <div class="qr-instrucciones">
                    <p>1. Abre WhatsApp en tu teléfono de la sucursal</p>
                    <p>2. Ve a <strong>Dispositivos vinculados → Vincular un dispositivo</strong></p>
                    <p>3. Apunta la cámara y escanea este código QR</p>
                </div>
                <div class="qr-status" id="qrStatus">
                    ⏳ Esperando escaneo...
                </div>
            </div>
        </div>
    </div>
</AdminLayout>

<script>
// ============================================
// VARIABLES GLOBALES
// ============================================
let intervaloVerificacion = null;

// ============================================
// CONECTAR WHATSAPP
// ============================================
async function conectar(sucursalId) {
    const btn = document.querySelector(
        '.sesion-card[data-sucursal="' + sucursalId + '"] .btn-conectar'
    );
    
    if (btn) {
        btn.textContent = '⏳ Iniciando...';
        btn.disabled = true;
    }

    try {
        const response = await fetch('/api/openwa/sesion', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                sucursal_id: sucursalId,
                accion: 'conectar'
            })
        });

        const result = await response.json();

        if (result.success) {
            if (result.already_connected) {
                alert('✅ Sesión conectada exitosamente');
                window.location.reload();
            } else {
                mostrarQR(result.qr || 'cargando');
                iniciarVerificacion(sucursalId);
            }
        } else {
            alert('❌ Error: ' + (result.error || 'No se pudo iniciar sesión'));
        }
    } catch (error) {
        alert('❌ Error de conexión con el servidor');
    } finally {
        if (btn) {
            btn.textContent = '📱 Conectar WhatsApp';
            btn.disabled = false;
        }
    }
}

// ============================================
// MOSTRAR QR
// ============================================
function mostrarQR(qrData) {
    const modal = document.getElementById('modalQR');
    const img = document.getElementById('qrImage');
    if (!modal || !img) return;

    if (qrData === 'cargando') {
        img.src = 'https://via.placeholder.com/250x250.png?text=Generando+QR...';
    } else if (qrData.startsWith('data:') || qrData.startsWith('http')) {
        img.src = qrData;
    } else {
        img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=' + encodeURIComponent(qrData);
    }
    
    modal.style.display = 'flex';
}

// ============================================
// VERIFICAR ESTADO CADA 4 SEGUNDOS
// ============================================
function iniciarVerificacion(sucursalId) {
    if (intervaloVerificacion) clearInterval(intervaloVerificacion);
    
    intervaloVerificacion = setInterval(async () => {
        try {
            const response = await fetch('/api/openwa/sesion?sucursal_id=' + sucursalId);
            const data = await response.json();
            
            if (data.status === 'connected') {
                clearInterval(intervaloVerificacion);
                const elStatus = document.getElementById('qrStatus');
                if (elStatus) {
                    elStatus.innerHTML = '<span style="color: #10B981; font-weight: bold;">✅ ¡Conectado exitosamente!</span>';
                }
                
                setTimeout(() => {
                    cerrarQR();
                    window.location.reload();
                }, 1800);
            } else if (data.qr) {
                const img = document.getElementById('qrImage');
                if (img && img.src.includes('Generando')) {
                    if (data.qr.startsWith('data:') || data.qr.startsWith('http')) {
                        img.src = data.qr;
                    } else {
                        img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=' + encodeURIComponent(data.qr);
                    }
                }
            }
        } catch (error) {
            console.error('Error verificando estado:', error);
        }
    }, 4000);
}

// ============================================
// DESCONECTAR
// ============================================
async function desconectar(sucursalId) {
    if (!confirm('¿Desconectar el WhatsApp de esta sucursal?')) return;

    try {
        const response = await fetch('/api/openwa/sesion', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                sucursal_id: sucursalId,
                accion: 'desconectar'
            })
        });

        const result = await response.json();
        
        if (result.success) {
            alert('✅ Sesión desconectada');
            window.location.reload();
        } else {
            alert('❌ Error: ' + (result.error || 'No se pudo desconectar'));
        }
    } catch (error) {
        alert('❌ Error de conexión');
    }
}

// ============================================
// ENVIAR TEST
// ============================================
async function enviarTest(sucursalId) {
    const telefono = prompt('Ingresa el número de teléfono para probar (ej: 59178007700):');
    if (!telefono) return;

    try {
        const response = await fetch('/api/openwa/test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                sucursal_id: sucursalId,
                telefono: telefono,
                mensaje: '🧪 Prueba de conexión WhatsApp BRASARGENT'
            })
        });

        const result = await response.json();
        
        if (result.success) {
            alert('✅ Mensaje de prueba enviado correctamente');
        } else {
            alert('❌ Error: ' + (result.error || 'No se pudo enviar el mensaje'));
        }
    } catch (error) {
        alert('❌ Error de conexión');
    }
}

// ============================================
// CERRAR MODAL QR
// ============================================
function cerrarQR() {
    const modal = document.getElementById('modalQR');
    if (modal) modal.style.display = 'none';
    if (intervaloVerificacion) {
        clearInterval(intervaloVerificacion);
        intervaloVerificacion = null;
    }
}

// ============================================
// EVENT LISTENERS
// ============================================
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-action]').forEach(el => {
        el.addEventListener('click', (e) => {
            const target = e.currentTarget;
            const action = target.dataset.action;
            const sucursalId = parseInt(target.dataset.sucursal || '0');

            switch (action) {
                case 'conectar':
                    conectar(sucursalId);
                    break;
                case 'desconectar':
                    desconectar(sucursalId);
                    break;
                case 'test':
                    enviarTest(sucursalId);
                    break;
                case 'cerrar-qr':
                    cerrarQR();
                    break;
            }
        });
    });
});
</script>

<style>
.openwa-page {
    max-width: 1050px;
    margin: 0 auto;
    padding: 24px 16px;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
}

.page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    margin: 0;
    color: #1A1A1A;
}

.page-header p {
    color: #6B6B6B;
    font-size: 0.88rem;
    margin: 4px 0 0;
}

.super-admin-badge {
    background: rgba(139, 26, 26, 0.08);
    color: #8B1A1A;
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 600;
    border: 1px solid rgba(139, 26, 26, 0.15);
}

.sesiones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 22px;
}

.sesion-card {
    background: white;
    border-radius: 16px;
    padding: 22px 26px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    border-left: 5px solid #C9A87C;
    transition: transform 0.2s, box-shadow 0.2s;
}

.sesion-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

.sesion-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}

.sesion-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.sesion-icono {
    font-size: 1.9rem;
}

.sesion-info h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    margin: 0;
    color: #1A1A1A;
}

.sesion-name {
    font-size: 0.75rem;
    color: #888888;
}

.sesion-status {
    padding: 5px 14px;
    border-radius: 50px;
    font-size: 0.72rem;
    font-weight: 600;
}

.sesion-status.connected {
    background: rgba(16, 185, 129, 0.1);
    color: #10B981;
}

.sesion-status.disconnected {
    background: rgba(239, 68, 68, 0.1);
    color: #EF4444;
}

.sesion-status.qr_pending {
    background: rgba(245, 158, 11, 0.1);
    color: #F59E0B;
}

.sesion-telefono {
    font-size: 0.88rem;
    color: #4A4A4A;
    margin-bottom: 16px;
    background: #F8F9FA;
    padding: 8px 12px;
    border-radius: 8px;
}

.sesion-nombre {
    color: #C9A87C;
    margin-left: 6px;
    font-weight: 500;
}

.sesion-acciones {
    display: flex;
    gap: 10px;
}

.btn-accion {
    flex: 1;
    padding: 10px 16px;
    border: none;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-conectar {
    background: #8B1A1A;
    color: white;
}

.btn-conectar:hover {
    background: #6B1414;
    box-shadow: 0 4px 12px rgba(139, 26, 26, 0.25);
}

.btn-desconectar {
    background: rgba(239, 68, 68, 0.1);
    color: #EF4444;
}

.btn-desconectar:hover {
    background: rgba(239, 68, 68, 0.2);
}

.btn-test {
    background: rgba(16, 185, 129, 0.1);
    color: #10B981;
}

.btn-test:hover {
    background: rgba(16, 185, 129, 0.2);
}

/* Modal QR */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
}

.modal-container {
    background: white;
    border-radius: 20px;
    max-width: 460px;
    width: 100%;
    padding: 32px;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.modal-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    margin: 0;
}

.modal-close {
    background: transparent;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    color: #6B6B6B;
}

.modal-close:hover {
    color: #8B1A1A;
}

.qr-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background: #F5EDE3;
    border-radius: 16px;
    margin-bottom: 20px;
    min-height: 250px;
}

.qr-container img {
    max-width: 250px;
    width: 100%;
    height: auto;
    border-radius: 8px;
}

.qr-instrucciones {
    text-align: left;
    margin-bottom: 16px;
    background: #F8F9FA;
    padding: 12px 16px;
    border-radius: 10px;
}

.qr-instrucciones p {
    font-size: 0.85rem;
    color: #4A4A4A;
    margin: 6px 0;
}

.qr-status {
    padding: 12px;
    background: rgba(245, 158, 11, 0.1);
    color: #F59E0B;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
}

@media (max-width: 640px) {
    .sesiones-grid {
        grid-template-columns: 1fr;
    }

    .page-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
}
</style>
