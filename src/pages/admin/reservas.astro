---
// src/pages/admin/reservas.astro
// Página completa de gestión de reservas
import AdminLayout from '../../layouts/AdminLayout.astro';
import pool from '../../lib/db';
import { esAceptable } from '../../lib/reservas';

// Obtener usuario actual desde locals (seteado en middleware)
const usuario = Astro.locals.usuario;
const esSuperAdmin = usuario?.es_super_admin === true || usuario?.es_super_admin === 1;
const userSucursalId = usuario?.sucursal_id;

// Obtener parámetros de filtro
const url = new URL(Astro.request.url);
let sucursalId = url.searchParams.get('sucursal') || '';
const estado = url.searchParams.get('estado') || '';
const fechaParam = url.searchParams.get('fecha') || '';
const fechaInicio = url.searchParams.get('fecha_inicio') || fechaParam || '';
const fechaFin = url.searchParams.get('fecha_fin') || fechaParam || '';

// Si NO es Super Admin, forzar sucursal asignada
if (!esSuperAdmin && userSucursalId) {
    sucursalId = String(userSucursalId);
}

// Construir query de reservas
let sql = `
    SELECT 
        r.id,
        r.numero_reserva,
        r.nombre_cliente,
        r.telefono,
        r.telefono_completo,
        r.codigo_pais,
        r.fecha,
        r.hora,
        r.numero_personas,
        r.cantidad_ninos,
        r.necesita_silla_bebe,
        r.necesita_menu_infantil,
        r.estado,
        r.personas_asistentes,
        r.observaciones,
        r.created_at,
        r.fecha_confirmacion,
        r.fecha_rechazo,
        r.mensaje_admin,
        r.cubiertos_reservados,
        s.nombre AS sucursal_nombre,
        s.id AS sucursal_id,
        s.cubiertos_disponibles
    FROM reservas r
    JOIN sucursales s ON r.sucursal_id = s.id
    WHERE 1=1
`;

const params: any[] = [];

if (sucursalId) {
    sql += ` AND r.sucursal_id = ?`;
    params.push(parseInt(sucursalId, 10));
}

if (estado) {
    sql += ` AND r.estado = ?`;
    params.push(estado);
}

if (fechaInicio) {
    sql += ` AND r.fecha >= ?`;
    params.push(fechaInicio);
}

if (fechaFin) {
    sql += ` AND r.fecha <= ?`;
    params.push(fechaFin);
}

sql += ` ORDER BY r.fecha DESC, r.hora DESC`;

const [reservasRows] = await pool.query(sql, params) as any[];
const reservas = reservasRows;

// Obtener sucursales para el filtro
let sucursalesQuery = `SELECT id, nombre FROM sucursales WHERE activo = 1`;
const sucursalesParams: any[] = [];
if (!esSuperAdmin && userSucursalId) {
    sucursalesQuery += ` AND id = ?`;
    sucursalesParams.push(userSucursalId);
}
sucursalesQuery += ` ORDER BY nombre`;

const [sucursalesRows] = await pool.query(sucursalesQuery, sucursalesParams) as any[];
const sucursales = sucursalesRows;

// Estadísticas
const estadisticas = {
    total: reservas.length,
    pendientes: reservas.filter((r: any) => r.estado === 'pendiente').length,
    confirmadas: reservas.filter((r: any) => r.estado === 'confirmada').length,
    rechazadas: reservas.filter((r: any) => r.estado === 'rechazada').length,
    canceladas: reservas.filter((r: any) => r.estado === 'cancelada').length
};

// Formatear fecha
const formatearFecha = (fecha: string) => {
    return new Date(fecha).toLocaleDateString('es-ES', {
        weekday: 'short',
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    });
};

// Estado badge
const estadoBadge = (estado: string) => {
    const clases = {
        'pendiente': 'badge-pendiente',
        'confirmada': 'badge-confirmada',
        'en_curso': 'badge-en-curso',
        'rechazada': 'badge-rechazada',
        'cancelada': 'badge-cancelada'
    };
    return clases[estado as keyof typeof clases] || 'badge-pendiente';
};

const estadoTexto = (estado: string) => {
    const textos = {
        'pendiente': '⏳ Pendiente',
        'confirmada': '✅ Confirmada',
        'en_curso': '🟢 En Curso',
        'rechazada': '❌ Rechazada',
        'cancelada': '⏰ Cancelada'
    };
    return textos[estado as keyof typeof textos] || estado;
};

const getColorSucursal = (nombre: string): string => {
    if (!nombre) return '#6b7280';
    if (nombre.includes('Churrasquería') || nombre.includes('Churrasqueria')) return '#9e2a2b';
    if (nombre.includes('Fast Grill')) return '#d4af37';
    if (nombre.includes('Rodizio')) return '#d4a574';
    return '#6b7280';
};
---

<AdminLayout title="Reservas" description="Gestión completa de todas las reservas">
    <!-- Estadísticas -->
        <div class="estadisticas-grid">
            <div class="stat-card">
                <span class="stat-icon">📋</span>
                <div>
                    <span class="stat-number">{estadisticas.total}</span>
                    <span class="stat-label">Total Reservas</span>
                </div>
            </div>
            <div class="stat-card stat-pendiente">
                <span class="stat-icon">⏳</span>
                <div>
                    <span class="stat-number">{estadisticas.pendientes}</span>
                    <span class="stat-label">Pendientes</span>
                </div>
            </div>
            <div class="stat-card stat-confirmada">
                <span class="stat-icon">✅</span>
                <div>
                    <span class="stat-number">{estadisticas.confirmadas}</span>
                    <span class="stat-label">Confirmadas</span>
                </div>
            </div>
            <div class="stat-card stat-rechazada">
                <span class="stat-icon">❌</span>
                <div>
                    <span class="stat-number">{estadisticas.rechazadas}</span>
                    <span class="stat-label">Rechazadas</span>
                </div>
            </div>
        </div>
        
        <!-- Filtros -->
        <div class="filtros-container">
            <form method="GET" class="filtros-form">
                <div class="filtro-group">
                    <label>Sucursal</label>
                    <select name="sucursal">
                        <option value="">Todas</option>
                        {sucursales.map((s: any) => (
                            <option value={s.id} selected={sucursalId === String(s.id)}>
                                {s.nombre}
                            </option>
                        ))}
                    </select>
                </div>
                
                <div class="filtro-group">
                    <label>Estado</label>
                    <select name="estado">
                        <option value="">Todos</option>
                        <option value="pendiente" selected={estado === 'pendiente'}>Pendiente</option>
                        <option value="confirmada" selected={estado === 'confirmada'}>Confirmada</option>
                        <option value="en_curso" selected={estado === 'en_curso'}>En Curso (Llegaron)</option>
                        <option value="rechazada" selected={estado === 'rechazada'}>Rechazada</option>
                        <option value="cancelada" selected={estado === 'cancelada'}>Cancelada</option>
                    </select>
                </div>
                
                <div class="filtro-group">
                    <label>Fecha Inicio</label>
                    <input type="date" name="fecha_inicio" value={fechaInicio} />
                </div>
                
                <div class="filtro-group">
                    <label>Fecha Fin</label>
                    <input type="date" name="fecha_fin" value={fechaFin} />
                </div>
                
                <div class="filtro-actions">
                    <button type="submit" class="btn-filtrar">🔍 Filtrar</button>
                    <a href="/admin/reservas" class="btn-limpiar">✕ Limpiar</a>
                </div>
            </form>
        </div>
        
        <!-- Tabla de Reservas -->
        <div class="section-card">
            {reservas.length === 0 ? (
                <div class="empty-state">
                    <span class="empty-icon">📭</span>
                    <p>No hay reservas</p>
                    <span class="empty-sub">Ajusta los filtros para ver más resultados</span>
                </div>
            ) : (
                <div class="table-wrapper">
                    <table class="tabla-reservas">
                        <thead>
                            <tr>
                                <th>Nº Reserva</th>
                                <th>Cliente</th>
                                <th>Teléfono</th>
                                <th>Sucursal</th>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Adultos</th>
                                <th>🧒 Niños</th>
                                <th>Cubiertos</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {reservas.map((reserva: any) => (
                                <tr class={`row-estado-${reserva.estado}`}>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap;">
                                            <code class="px-2 py-1 bg-gray-100 rounded text-xs font-mono font-bold text-[#9e2a2b]">
                                                {reserva.numero_reserva || 'BR-2026-0000'}
                                            </code>
                                            <span class="badge-sucursal" style={`background: ${getColorSucursal(reserva.sucursal_nombre)}; color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: 600;`}>
                                                {(reserva.sucursal_nombre || 'BR').substring(0, 3).toUpperCase()}
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <strong>{reserva.nombre_cliente}</strong>
                                    </td>
                                    <td>
                                        <a href={`https://wa.me/${reserva.telefono_completo || '591' + reserva.telefono}`} 
                                           target="_blank" 
                                           class="whatsapp-link">
                                            💬 {reserva.codigo_pais || '591'} {reserva.telefono}
                                        </a>
                                    </td>
                                    <td>{reserva.sucursal_nombre}</td>
                                    <td>{formatearFecha(reserva.fecha)}</td>
                                    <td>{reserva.hora}</td>
                                    <td>{reserva.numero_personas}</td>
                                    <td>{reserva.cantidad_ninos || 0}</td>
                                    <td>{reserva.cubiertos_reservados || '-'}</td>
                                    <td>
                                        <span class={`badge ${estadoBadge(reserva.estado)}`}>
                                            {estadoTexto(reserva.estado)}
                                        </span>
                                        {reserva.estado === 'pendiente' && !esAceptable(reserva.fecha, reserva.hora) && (
                                            <span style="display: block; font-size: 0.7rem; color: #d97706; margin-top: 3px; font-weight: 600;">
                                                ⏳ Esperando ventana (24h)
                                            </span>
                                        )}
                                        {reserva.personas_asistentes && (
                                            <span style="display: block; font-size: 0.7rem; color: #059669; margin-top: 3px; font-weight: 600;">
                                                🙋‍♂️ {reserva.personas_asistentes} presentes
                                            </span>
                                        )}
                                    </td>
                                    <td>
                                        <div class="acciones-btns">
                                            {reserva.estado === 'pendiente' && (
                                                <>
                                                    <button class="btn-aprobar" 
                                                            data-reserva-id={reserva.id}
                                                            onclick={`aprobarReserva(${reserva.id}, ${reserva.sucursal_id}, ${reserva.numero_personas}, ${reserva.cubiertos_disponibles})`}>
                                                        ✅
                                                    </button>
                                                    <button class="btn-rechazar" 
                                                            onclick={`rechazarReserva(${reserva.id})`}>
                                                        ❌
                                                    </button>
                                                </>
                                            )}
                                            {(reserva.estado === 'confirmada' || reserva.estado === 'en_curso') && (
                                                <>
                                                    <button class={`btn-asistencia ${reserva.estado === 'en_curso' ? 'btn-en-curso' : ''}`}
                                                            onclick={`registrarAsistencia(${reserva.id}, '${String(reserva.nombre_cliente).replace(/'/g, "\\'")}', ${reserva.cubiertos_reservados || (parseInt(reserva.numero_personas) + parseInt(reserva.cantidad_ninos || 0))})`}
                                                            title={reserva.estado === 'en_curso' ? 'Llegada registrada. Clic para modificar asistencia' : 'Registrar llegada del cliente (Asistencia)'}>
                                                        🙋‍♂️
                                                    </button>
                                                    <button class="btn-liberar-mesa"
                                                            onclick={`liberarMesa(${reserva.id}, '${String(reserva.nombre_cliente).replace(/'/g, "\\'")}', ${reserva.cubiertos_reservados || 0})`}
                                                            title="Liberar cubiertos de la mesa (Finalizar servicio)">
                                                        🔓
                                                    </button>
                                                </>
                                            )}
                                            <button class="btn-whatsapp" 
                                                    onclick={`enviarWhatsAppAdmin(${reserva.id})`}
                                                    title="Enviar WhatsApp de confirmación">
                                                💬
                                            </button>
                                            <button class="btn-detalle" 
                                                    onclick={`verDetalle(${reserva.id})`} title="Ver detalle">
                                                📋
                                            </button>
                                            <button class="btn-eliminar" 
                                                    onclick={`borrarReserva(${reserva.id})`} title="Eliminar reserva">
                                                🗑️
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            )}
        </div>
</AdminLayout>

<script>
// ============================================
// FUNCIONES DE ACCIÓN
// ============================================

window.aprobarReserva = async function(id, sucursalId, personas, disponibles) {
    if (personas > disponibles) {
        alert(`❌ No hay suficientes cubiertos. Disponibles: ${disponibles}`);
        return;
    }

    if (!confirm(`¿Aprobar reserva de ${personas} personas?\nSe enviará la confirmación por WhatsApp.`)) {
        return;
    }

    const btn = document.querySelector(`.btn-aprobar[data-reserva-id="${id}"]`) || document.querySelector(`.btn-aprobar[onclick*="${id}"]`);
    const originalText = btn ? btn.textContent : '✅';
    if (btn) {
        btn.textContent = '⏳';
        btn.disabled = true;
    }

    try {
        const response = await fetch(`/api/reservas/${id}/aprobar`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ accion: 'aprobar' })
        });

        const result = await response.json();

        if (result.success) {
            if (result.whatsapp && result.whatsapp.success) {
                alert(`✅ Reserva aprobada exitosamente.\n📱 Mensaje enviado automáticamente por WhatsApp al ${result.telefono || 'cliente'}.`);
            } else {
                const errorWa = result.whatsapp?.error || 'OpenWA desconectado';
                alert(`✅ Reserva aprobada exitosamente.\n⚠️ WhatsApp no enviado: ${errorWa}`);
            }
            
            setTimeout(() => location.reload(), 1500);
        } else {
            alert('❌ Error: ' + result.error);
            if (btn) {
                btn.textContent = originalText;
                btn.disabled = false;
            }
        }
    } catch (error) {
        alert('❌ Error de conexión. Intenta de nuevo.');
        if (btn) {
            btn.textContent = originalText;
            btn.disabled = false;
        }
    }
}

window.rechazarReserva = async function(id) {
    const motivo = prompt('Motivo del rechazo:', 'No hay disponibilidad');
    if (motivo === null) return;

    if (!confirm('¿Rechazar esta reserva?')) return;

    const btn = document.querySelector(`.btn-rechazar[onclick*="${id}"]`);
    const originalText = btn ? btn.textContent : '❌';
    if (btn) {
        btn.textContent = '⏳';
        btn.disabled = true;
    }

    try {
        const response = await fetch(`/api/reservas/${id}/aprobar`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                accion: 'rechazar',
                mensaje: motivo
            })
        });

        const result = await response.json();

        if (result.success) {
            alert('❌ Reserva rechazada');
            location.reload();
        } else {
            alert('❌ Error: ' + result.error);
            if (btn) {
                btn.textContent = originalText;
                btn.disabled = false;
            }
        }
    } catch (error) {
        alert('❌ Error de conexión');
        if (btn) {
            btn.textContent = originalText;
            btn.disabled = false;
        }
    }
}

window.enviarWhatsAppManual = function(telefono, mensaje) {
    const telefonoLimpio = String(telefono).replace(/\D/g, '');
    const numeroFinal = telefonoLimpio.startsWith('591') ? telefonoLimpio : `591${telefonoLimpio}`;
    const url = `https://wa.me/${numeroFinal}?text=${encodeURIComponent(mensaje)}`;
    window.open(url, '_blank');
}

window.enviarWhatsAppAdmin = async function(id) {
    try {
        const response = await fetch(`/api/reservas/${id}/confirmar`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        
        const result = await response.json();
        
        if (result.success && result.url_whatsapp) {
            window.open(result.url_whatsapp, '_blank');
        } else {
            alert('❌ Error al generar mensaje: ' + (result.error || 'Desconocido'));
        }
    } catch (error) {
        alert('❌ Error de conexión al generar mensaje de WhatsApp');
    }
}

window.verDetalle = async function(id) {
    try {
        const response = await fetch(`/api/reservas/${id}`);
        const result = await response.json();
        
        if (!response.ok || !result.data) {
            alert(result.error || 'Error al obtener los detalles de la reserva.');
            return;
        }

        const reserva = result.data;
        
        const existente = document.getElementById('modalReservaIndividual');
        if (existente) existente.remove();

        const formatFecha = (f) => new Date(f).toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        
        const modalHTML = `
            <div class="modal-overlay" id="modalReservaIndividual" onclick="window.cerrarModalDetalleIndividual()">
                <div class="modal-container" onclick="event.stopPropagation()">
                    <div class="modal-header">
                        <h2>Detalles de la Reserva</h2>
                        <button class="modal-close" onclick="window.cerrarModalDetalleIndividual()">✕</button>
                    </div>
                    <div class="modal-body">
                        <div class="detalle-grid">
                            <div class="detalle-item">
                                <span class="detalle-label">Cliente</span>
                                <span class="detalle-valor"><strong>${reserva.nombre_cliente}</strong></span>
                            </div>
                            <div class="detalle-item">
                                <span class="detalle-label">Teléfono</span>
                                <span class="detalle-valor"> ${reserva.codigo_pais || '591'} ${reserva.telefono}</span>
                            </div>
                            <div class="detalle-item">
                                <span class="detalle-label">Sucursal</span>
                                <span class="detalle-valor"> ${reserva.sucursal || 'Desconocida'}</span>
                            </div>
                            <div class="detalle-item">
                                <span class="detalle-label">Fecha y Hora</span>
                                <span class="detalle-valor"> ${formatFecha(reserva.fecha)} a las  ${reserva.hora}</span>
                            </div>
                            <div class="detalle-item">
                                <span class="detalle-label">Personas</span>
                                <span class="detalle-valor"> ${reserva.numero_personas} personas</span>
                            </div>
                            <div class="detalle-item">
                                <span class="detalle-label">Estado</span>
                                <span class="detalle-valor"> ${reserva.estado.toUpperCase()}</span>
                            </div>
                        </div>
                        
                        <div class="observaciones-box">
                            <span class="detalle-label">Mensaje / Observaciones del comensal:</span>
                            <div class="mensaje-texto">
                                ${reserva.observaciones ? reserva.observaciones : '<em>El cliente no dejó ningún mensaje u observación.</em>'}
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn-cancel" onclick="window.cerrarModalDetalleIndividual()">Cerrar</button>
                    </div>
                </div>
            </div>
        `;
        
        document.body.insertAdjacentHTML('beforeend', modalHTML);
        document.body.classList.add('modal-open');
        
    } catch (error) {
        console.error('Error fetching reservation details:', error);
        alert('Error de conexión al obtener detalles.');
    }
}

window.cerrarModalDetalleIndividual = function() {
    const modal = document.getElementById('modalReservaIndividual');
    if (modal) {
        modal.style.opacity = '0';
        setTimeout(() => {
            modal.remove();
            document.body.classList.remove('modal-open');
        }, 300);
    }
}

window.borrarReserva = async function(id) {
    if (confirm(`¿Estás seguro de que deseas eliminar esta reserva?\n\nEsta acción no se puede deshacer.`)) {
        try {
            const response = await fetch(`/api/reservas/${id}`, {
                method: 'DELETE'
            });
            const result = await response.json();
            
            if (result.success) {
                location.reload();
            } else {
                alert(result.error || 'Hubo un error al eliminar la reserva.');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error de conexión al intentar eliminar.');
        }
    }
}

window.registrarAsistencia = async function(id, nombreCliente, cubiertosReservados) {
    const numInput = prompt(
        `📍 Registrar llegada del cliente:\n${nombreCliente}\n\n` +
        `¿Cuántas personas asistieron en total?\n` +
        `(Cubiertos reservados: ${cubiertosReservados})`,
        cubiertosReservados
    );
    
    if (numInput === null) return;
    const personas = parseInt(numInput, 10);
    if (isNaN(personas) || personas < 1) {
        alert('⚠️ Por favor ingresa un número de personas válido (mínimo 1).');
        return;
    }
    
    try {
        const response = await fetch(`/api/reservas/${id}/asistencia`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ personas_asistentes: personas })
        });
        
        const result = await response.json();
        if (result.success) {
            alert(`✅ ${result.mensaje}`);
            location.reload();
        } else {
            alert(`❌ Error: ${result.error}`);
        }
    } catch (error) {
        alert('❌ Error de conexión al registrar la asistencia.');
    }
}

window.liberarMesa = async function(id, nombreCliente, cubiertos) {
    if (!confirm(`🔓 ¿Deseas liberar la mesa de ${nombreCliente}?\n\nEsta acción marcará el servicio como completado y liberará los cubiertos en tu sucursal.`)) {
        return;
    }

    try {
        const response = await fetch(`/api/reservas/${id}/liberar`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        const result = await response.json();
        if (result.success) {
            alert(`✅ ${result.mensaje || 'Mesa liberada exitosamente.'}`);
            location.reload();
        } else {
            alert(`❌ Error: ${result.error}`);
        }
    } catch (error) {
        alert('❌ Error de conexión al intentar liberar la mesa.');
    }
}
</script>

<style is:global>
.badge-en-curso { background: rgba(16, 185, 129, 0.15); color: #059669; }
.row-estado-en_curso { border-left: 3px solid #059669; }
.btn-liberar-mesa {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
}
.btn-liberar-mesa:hover {
    background: rgba(239, 68, 68, 0.2);
