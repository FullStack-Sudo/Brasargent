        color: #1a1a1a;
    }

    .btn-cubiertos:hover {
        background: rgba(16, 185, 129, 0.15);
        color: #047857;
    }

    .btn-editar:hover {
        background: rgba(59, 130, 246, 0.1);
        color: #3b82f6;
    }

    .btn-toggle:hover {
        background: rgba(245, 158, 11, 0.1);
        color: #f59e0b;
    }

    .btn-ver:hover {
