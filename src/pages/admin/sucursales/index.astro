        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 500;
    }

    .badge-activo {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
    }

    .badge-inactivo {
        background: rgba(107, 114, 128, 0.1);
        color: #6b7280;
    }

