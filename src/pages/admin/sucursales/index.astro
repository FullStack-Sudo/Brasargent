---
// src/pages/admin/sucursales/index.astro
// Lista de sucursales con opciones de edición

import AdminLayout from '../../../layouts/AdminLayout.astro';
import pool from '../../../lib/db';

// Obtener todas las sucursales
const [sucursalesRows] = await pool.query(`
    SELECT 
        s.id,
        s.nombre,
        s.concepto,
        s.direccion,
        s.telefono,
        s.capacidad_total,
        COALESCE(
            (SELECT SUM(cubiertos_reservados) 
             FROM reservas 
             WHERE sucursal_id = s.id AND estado = 'confirmada' AND fecha = CURRENT_DATE()), 
            0
        ) AS cubiertos_ocupados,
        s.rating,
        s.resenas,
        s.permite_reservas,
        s.permite_cubiertos,
        s.activo,
        COUNT(DISTINCT ms.plato_id) AS total_platos
    FROM sucursales s
    LEFT JOIN menu_sucursal ms ON s.id = ms.sucursal_id
    GROUP BY s.id
    ORDER BY s.nombre
`) as any[];

const sucursales = sucursalesRows.map((s: any) => ({
    ...s,
    cubiertos_ocupados: Number(s.cubiertos_ocupados) || 0,
    cubiertos_disponibles: (s.capacidad_total || 120) - (Number(s.cubiertos_ocupados) || 0)
}));

// Estadísticas
const totalActivas = sucursales.filter((s: any) => s.activo === 1).length;
const totalCubiertos = sucursales.reduce((acc: number, s: any) => acc + (s.capacidad_total || 120), 0);
const totalOcupados = sucursales.reduce((acc: number, s: any) => acc + (s.cubiertos_ocupados || 0), 0);
const totalDisponibles = totalCubiertos - totalOcupados;

// Función para formatear porcentaje
const getPorcentaje = (ocupados: number, total: number) => {
    if (total === 0) return 0;
    return Math.round((ocupados / total) * 100);
};
---

<AdminLayout title="Sucursales" description="Gestión de sucursales y cubiertos">
    <div class="sucursales-admin">
        <!-- Header -->
        <div class="admin-header">
            <div>
                <h1>🏢 Sucursales</h1>
                <p>Gestión de todas las sucursales del restaurante</p>
            </div>
            <a href="/admin/sucursales/nueva" class="btn-nueva">
                ➕ Nueva Sucursal
            </a>
        </div>

        <!-- Estadísticas -->
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-icon">🏢</span>
                <div>
                    <span class="stat-number">{sucursales.length}</span>
                    <span class="stat-label">Total Sucursales</span>
                </div>
            </div>
            <div class="stat-card">
                <span class="stat-icon">✅</span>
                <div>
                    <span class="stat-number">{totalActivas}</span>
                    <span class="stat-label">Activas</span>
                </div>
            </div>
            <div class="stat-card">
                <span class="stat-icon">🪑</span>
                <div>
                    <span class="stat-number">{totalCubiertos}</span>
                    <span class="stat-label">Cubiertos Totales</span>
                </div>
            </div>
            <div class="stat-card">
                <span class="stat-icon">🔴</span>
                <div>
                    <span class="stat-number">{totalOcupados}</span>
                    <span class="stat-label">Ocupados</span>
                </div>
            </div>
            <div class="stat-card">
                <span class="stat-icon">🟢</span>
                <div>
                    <span class="stat-number">{totalDisponibles}</span>
                    <span class="stat-label">Disponibles</span>
                </div>
            </div>
        </div>

        <!-- Tabla de Sucursales -->
        <div class="table-container">
            <table class="tabla-sucursales">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Sucursal</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Cubiertos</th>
                        <th>Ocupación</th>
                        <th>Reservas</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {sucursales.map((sucursal: any, index: number) => {
                        const porcentaje = getPorcentaje(sucursal.cubiertos_ocupados || 0, sucursal.capacidad_total || 120);
                        const colorBarra = porcentaje > 80 ? '#ef4444' : porcentaje > 60 ? '#f59e0b' : '#10b981';
                        
                        return (
                            <tr>
                                <td>{index + 1}</td>
                                <td>
                                    <strong>{sucursal.nombre}</strong>
                                    <span class="concepto-badge">{sucursal.concepto || 'Restaurante'}</span>
                                </td>
                                <td>{sucursal.direccion}</td>
                                <td>{sucursal.telefono}</td>
                                <td>
                                    <div class="cubiertos-info">
                                        <span class="cubiertos-total">{sucursal.capacidad_total || 120}</span>
                                        <span class="cubiertos-disponibles">({sucursal.cubiertos_disponibles || 0} disp.)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="ocupacion-container">
                                        <div class="barra-ocupacion" style="width: 100px; height: 6px; background: #eee; border-radius: 3px; overflow: hidden;">
                                            <div class="barra-fill" style={`width: ${porcentaje}%; background: ${colorBarra}; height: 100%; transition: width 0.5s ease;`}></div>
                                        </div>
                                        <span class="porcentaje" style={`color: ${colorBarra}; font-weight: 500;`}>{porcentaje}%</span>
                                    </div>
                                </td>
                                <td>
                                    <span class={`badge ${sucursal.permite_reservas ? 'badge-si' : 'badge-no'}`}>
                                        {sucursal.permite_reservas ? '✅ Sí' : '❌ No'}
                                    </span>
                                </td>
                                <td>
                                    <span class={`badge ${sucursal.activo ? 'badge-activo' : 'badge-inactivo'}`}>
                                        {sucursal.activo ? '✅ Activa' : '❌ Inactiva'}
                                    </span>
                                </td>
                                <td>
                                    <div class="acciones">
                                        <a href={`/admin/sucursales/editar/${sucursal.id}`} class="btn-editar" title="Editar">
                                            ✏️
                                        </a>
                                        <button class="btn-toggle" onclick={`toggleSucursal(${sucursal.id}, ${sucursal.activo})`} title="Activar/Desactivar">
                                            🔄
                                        </button>
                                        <a href={`/sucursales?id=${sucursal.id}`} class="btn-ver" title="Ver en página principal">
                                            👁️
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        );
                    })}
                </tbody>
            </table>
        </div>
    </div>
</AdminLayout>

<style is:global>
/* ============================================
   SUCURSALES ADMIN - ESTILOS
   ============================================ */
.sucursales-admin {
    padding: 20px;
    max-width: 1400px;
    margin: 0 auto;
}

.admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.admin-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    color: #1a1a1a;
    margin: 0;
}

.admin-header p {
    color: rgba(26, 26, 26, 0.5);
    margin: 4px 0 0;
}

.btn-nueva {
    padding: 10px 24px;
    background: #9e2a2b;
    color: #fffaf0;
    border: none;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
}

.btn-nueva:hover {
    background: #7a2021;
    transform: scale(1.02);
}

/* Estadísticas */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}

.stat-card {
    background: white;
    border-radius: 12px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.stat-icon {
    font-size: 1.8rem;
}

.stat-number {
    display: block;
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
}

.stat-label {
    font-size: 0.75rem;
    color: rgba(26, 26, 26, 0.4);
}

/* Tabla */
.table-container {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.tabla-sucursales {
    width: 100%;
    border-collapse: collapse;
}

.tabla-sucursales thead {
    background: #f8f5f0;
}

.tabla-sucursales th {
    padding: 12px 16px;
    text-align: left;
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(26, 26, 26, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid rgba(26, 26, 26, 0.06);
}

.tabla-sucursales td {
    padding: 12px 16px;
    font-size: 0.85rem;
    color: #1a1a1a;
    border-bottom: 1px solid rgba(26, 26, 26, 0.04);
    vertical-align: middle;
}

.tabla-sucursales tr:hover td {
    background: rgba(255, 250, 240, 0.3);
}

.concepto-badge {
    display: block;
    font-size: 0.6rem;
    color: rgba(26, 26, 26, 0.3);
    font-weight: 400;
}

.cubiertos-info {
    display: flex;
    align-items: center;
    gap: 4px;
}

.cubiertos-total {
    font-weight: 600;
}

.cubiertos-disponibles {
    font-size: 0.75rem;
    color: #10b981;
}

.ocupacion-container {
    display: flex;
    align-items: center;
    gap: 8px;
}

.porcentaje {
    font-size: 0.75rem;
    min-width: 36px;
}

.badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 500;
}

.badge-si {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
}

.badge-no {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
}

.badge-activo {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
}

.badge-inactivo {
    background: rgba(107, 114, 128, 0.1);
    color: #6b7280;
}

.acciones {
    display: flex;
    gap: 8px;
}

.btn-editar,
.btn-toggle,
.btn-ver {
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    background: rgba(26, 26, 26, 0.04);
    color: #1a1a1a;
}

.btn-editar:hover {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
}

.btn-toggle:hover {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
}

.btn-ver:hover {
    background: rgba(158, 42, 43, 0.1);
    color: #9e2a2b;
}

/* Responsive */
@media (max-width: 1200px) {
    .stats-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 768px) {
    .stats-grid {
        grid-template-columns: 1fr 1fr;
    }
    
    .admin-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
    
    .btn-nueva {
        width: 100%;
        text-align: center;
    }
    
    .tabla-sucursales {
        font-size: 0.75rem;
    }
    
    .tabla-sucursales th,
    .tabla-sucursales td {
        padding: 8px 10px;
    }
}

@media (max-width: 480px) {
    .stats-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<script is:inline>
// ============================================
// TOGGLE SUCURSAL
// ============================================

async function toggleSucursal(id, activo) {
    const nuevoEstado = activo === 1 ? 0 : 1;
    const mensaje = activo === 1 ? 'desactivar' : 'activar';
    
    if (!confirm(`¿Estás seguro de ${mensaje} esta sucursal?`)) return;
    
    try {
        const response = await fetch(`/api/sucursales/${id}/toggle`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ activo: nuevoEstado })
        });
        
        const result = await response.json();
        
        if (result.success) {
            alert(`✅ Sucursal ${mensaje}da exitosamente`);
            location.reload();
        } else {
            alert(`❌ Error: ${result.error}`);
        }
    } catch (error) {
        alert('❌ Error de conexión');
    }
}
</script>
