    @media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }

        .admin-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

        .btn-nueva {
            width: 100%;
            text-align: center;
        }

        .tabla-sucursales {
            font-size: 0.75rem;
        }

        .tabla-sucursales th,
        .tabla-sucursales td {
            padding: 8px 10px;
        }
    }

    @media (max-width: 480px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script is:inline>
    // ============================================
    // TOGGLE SUCURSAL
    // ============================================

    async function toggleSucursal(id, activo) {
        const nuevoEstado = activo === 1 ? 0 : 1;
        const mensaje = activo === 1 ? "desactivar" : "activar";

        if (!confirm(`¿Estás seguro de ${mensaje} esta sucursal?`)) return;

        try {
            const response = await fetch(`/api/sucursales/${id}/toggle`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({ activo: nuevoEstado }),
            });

            const result = await response.json();

            if (result.success) {
                alert(`✅ Sucursal ${mensaje}da exitosamente`);
                location.reload();
            } else {
                alert(`❌ Error: ${result.error}`);
            }
        } catch (error) {
            alert("❌ Error de conexión");
        }
    }
</script>
