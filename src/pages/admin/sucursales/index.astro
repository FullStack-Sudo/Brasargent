---
// src/pages/admin/sucursales/index.astro
// Lista de sucursales con opciones de edición, capacidad y reservas confirmadas en tiempo real
import AdminLayout from "../../../layouts/AdminLayout.astro";
import pool from "../../../lib/db";
import { getEstadisticasCubiertos } from "../../../lib/cubiertos";

// Sincronizar y recalcular cubiertos en tiempo real
await getEstadisticasCubiertos();

// Obtener todas las sucursales con detalle real sin producto cartesiano
const [sucursalesRows] = (await pool.query(`
    SELECT 
        s.id,
        s.nombre,
        s.concepto,
        s.direccion,
        s.telefono,
        s.capacidad_total,
        s.cubiertos_ocupados,
        s.cubiertos_disponibles,
        s.rating,
        s.resenas,
        s.permite_reservas,
        s.permite_cubiertos,
        s.activo,
        (SELECT COUNT(*) FROM menu_sucursal WHERE sucursal_id = s.id) AS total_platos,
        (SELECT COUNT(*) FROM reservas WHERE sucursal_id = s.id AND estado = 'confirmada') AS total_confirmadas,
        (SELECT COUNT(*) FROM reservas WHERE sucursal_id = s.id AND estado = 'en_curso') AS total_en_curso,
        (SELECT COUNT(*) FROM reservas WHERE sucursal_id = s.id AND estado = 'pendiente') AS total_pendientes,
        COALESCE((SELECT SUM(COALESCE(personas_asistentes, cubiertos_reservados)) FROM reservas WHERE sucursal_id = s.id AND estado = 'en_curso'), 0) AS personas_en_mesa,
        COALESCE((SELECT SUM(cubiertos_reservados) FROM reservas WHERE sucursal_id = s.id AND estado IN ('confirmada', 'en_curso')), 0) AS cubiertos_ocupados_reales
    FROM sucursales s
    ORDER BY s.nombre
`)) as any[];

const sucursales = sucursalesRows.map((s: any) => {
    const capTotal = Number(s.capacidad_total) || 120;
    const ocupados =
        Number(s.cubiertos_ocupados_reales) ||
        Number(s.cubiertos_ocupados) ||
        0;
    const disponibles = Math.max(0, capTotal - ocupados);
    return {
        ...s,
        capacidad_total: capTotal,
        cubiertos_ocupados: ocupados,
        cubiertos_disponibles: disponibles,
        total_confirmadas: Number(s.total_confirmadas) || 0,
        total_en_curso: Number(s.total_en_curso) || 0,
        total_pendientes: Number(s.total_pendientes) || 0,
        personas_en_mesa: Number(s.personas_en_mesa) || 0,
    };
});

// Estadísticas globales
const totalSucursales = sucursales.length;
const totalActivas = sucursales.filter((s: any) => s.activo === 1).length;
const totalCapacidad = sucursales.reduce(
    (acc: number, s: any) => acc + s.capacidad_total,
    0,
);
const totalOcupados = sucursales.reduce(
    (acc: number, s: any) => acc + s.cubiertos_ocupados,
    0,
);
const totalDisponibles = sucursales.reduce(
    (acc: number, s: any) => acc + s.cubiertos_disponibles,
    0,
);
const totalReservasConfirmadas = sucursales.reduce(
    (acc: number, s: any) => acc + (s.total_confirmadas + s.total_en_curso),
    0,
);

// Función para formatear porcentaje
const getPorcentaje = (ocupados: number, total: number) => {
    if (total === 0) return 0;
    return Math.min(100, Math.round((ocupados / total) * 100));
};
---

<AdminLayout
    title="Sucursales"
    description="Gestión de sucursales, capacidad de cubiertos y reservas confirmadas"
>
    <div class="sucursales-admin">
        <!-- Header -->
        <div class="admin-header">
            <div>
                <h1>🏢 Sucursales y Capacidad</h1>
                <p>
                    Monitoreo de capacidad total, cubiertos ocupados y reservas
                    confirmadas por sucursal
                </p>
            </div>
            <a href="/admin/sucursales/nueva" class="btn-nueva">
                ➕ Nueva Sucursal
            </a>
        </div>

        <!-- Estadísticas -->
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-icon">🏢</span>
                <div>
                    <span class="stat-number">{totalSucursales}</span>
                    <span class="stat-label"
                        >Total ({totalActivas} Activas)</span
                    >
                </div>
            </div>
            <div class="stat-card">
                <span class="stat-icon">🪑</span>
                <div>
                    <span class="stat-number">{totalCapacidad}</span>
                    <span class="stat-label">Capacidad Total</span>
                </div>
            </div>
            <div class="stat-card">
                <span class="stat-icon">🔴</span>
                <div>
                    <span class="stat-number">{totalOcupados}</span>
                    <span class="stat-label">Cubiertos Ocupados</span>
                </div>
            </div>
            <div class="stat-card">
                <span class="stat-icon">🟢</span>
                <div>
                    <span class="stat-number">{totalDisponibles}</span>
                    <span class="stat-label">Cubiertos Disponibles</span>
                </div>
            </div>
            <div class="stat-card">
                <span class="stat-icon">✅</span>
                <div>
                    <span class="stat-number">{totalReservasConfirmadas}</span>
                    <span class="stat-label">Reservas Confirmadas</span>
                </div>
            </div>
        </div>

        <!-- Indicador de desplazamiento en pantallas pequeñas -->
        <div class="scroll-hint">
            <span>👈 Desliza a los lados para ver todas las columnas y acciones 👉</span>
        </div>

        <!-- Tabla de Sucursales -->
        <div class="table-container">
            <table class="tabla-sucursales">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Sucursal</th>
                        <th>Contacto</th>
                        <th>Capacidad y Cubiertos</th>
                        <th>Reservas Confirmadas</th>
                        <th>Ocupación %</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        sucursales.map((sucursal: any, index: number) => {
                            const porcentaje = getPorcentaje(
                                sucursal.cubiertos_ocupados || 0,
                                sucursal.capacidad_total || 120,
                            );
                            const colorBarra =
                                porcentaje > 80
                                    ? "#ef4444"
                                    : porcentaje > 60
                                      ? "#f59e0b"
                                      : "#10b981";

                            return (
                                <tr>
                                    <td>{index + 1}</td>
                                    <td>
                                        <strong>{sucursal.nombre}</strong>
                                        <span class="concepto-badge">
                                            {sucursal.concepto || "Restaurante"}
                                        </span>
                                    </td>
                                    <td>
                                        <span style="display: block; font-weight: 500;">
                                            📍 {sucursal.direccion}
                                        </span>
                                        <span style="font-size: 0.78rem; color: #6b7280;">
                                            📞 {sucursal.telefono}
                                        </span>
                                    </td>
                                    <td>
                                        <div class="cubiertos-box">
                                            <div class="capacidad-line">
                                                <strong>
                                                    {sucursal.capacidad_total}
                                                </strong>{" "}
                                                <span class="cap-text">
                                                    capacidad total
                                                </span>
                                            </div>
                                            <div class="cubiertos-details-grid">
                                                <span class="cubiertos-disp-pill">
                                                    🟢{" "}
                                                    {
                                                        sucursal.cubiertos_disponibles
                                                    }{" "}
                                                    disp.
                                                </span>
                                                <span class="cubiertos-ocup-pill">
                                                    🔴{" "}
                                                    {
                                                        sucursal.cubiertos_ocupados
                                                    }{" "}
                                                    ocup.
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="reservas-info-cell">
                                            {sucursal.total_confirmadas > 0 ? (
                                                <a
                                                    href={`/admin/reservas?sucursal=${sucursal.id}&estado=confirmada`}
                                                    class="reserva-tag tag-confirmadas"
                                                    title="Ver reservas confirmadas por llegar"
                                                >
                                                    ✅{" "}
                                                    <strong>
                                                        {
                                                            sucursal.total_confirmadas
                                                        }
                                                    </strong>{" "}
                                                    por llegar
                                                </a>
                                            ) : (
                                                <span class="reserva-tag tag-vacio">
                                                    0 por llegar
                                                </span>
                                            )}

                                            {sucursal.total_en_curso > 0 ? (
                                                <a
                                                    href={`/admin/reservas?sucursal=${sucursal.id}&estado=en_curso`}
                                                    class="reserva-tag tag-en-curso"
                                                    title="Ver reservas en mesa"
                                                >
                                                    🟢{" "}
                                                    <strong>
                                                        {
                                                            sucursal.total_en_curso
                                                        }{" "}
                                                        res. en mesa
                                                    </strong>{" "}
                                                    ({sucursal.personas_en_mesa}{" "}
                                                    pers.)
                                                </a>
                                            ) : (
                                                <span class="reserva-tag tag-vacio">
                                                    0 en mesa
                                                </span>
                                            )}

                                            {sucursal.total_pendientes > 0 && (
                                                <a
                                                    href={`/admin/reservas?sucursal=${sucursal.id}&estado=pendiente`}
                                                    class="reserva-tag tag-pendientes"
                                                    title="Ver pendientes por aprobar"
                                                >
                                                    ⏳{" "}
                                                    <strong>
                                                        {
                                                            sucursal.total_pendientes
                                                        }
                                                    </strong>{" "}
                                                    pendientes
                                                </a>
                                            )}
                                        </div>
                                    </td>
                                    <td>
                                        <div class="ocupacion-container">
                                            <div
                                                class="barra-ocupacion"
                                                style="width: 90px; height: 8px; background: #eee; border-radius: 4px; overflow: hidden;"
                                            >
                                                <div
                                                    class="barra-fill"
                                                    style={`width: ${porcentaje}%; background: ${colorBarra}; height: 100%; transition: width 0.5s ease;`}
                                                />
                                            </div>
                                            <span
                                                class="porcentaje"
                                                style={`color: ${colorBarra}; font-weight: 700;`}
                                            >
                                                {porcentaje}%
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span
                                            class={`badge ${sucursal.activo ? "badge-activo" : "badge-inactivo"}`}
                                        >
                                            {sucursal.activo
                                                ? "✅ Activa"
                                                : "❌ Inactiva"}
                                        </span>
                                    </td>
                                    <td>
                                        <div class="acciones">
                                            <a
                                                href={`/admin/sucursales/cubiertos/${sucursal.id}`}
                                                class="btn-action btn-cubiertos"
                                                title="Ajustar Capacidad de Cubiertos"
                                            >
                                                🪑
                                            </a>
                                            <a
                                                href={`/admin/sucursales/editar/${sucursal.id}`}
                                                class="btn-action btn-editar"
                                                title="Editar Sucursal"
                                            >
                                                ✏️
                                            </a>
                                            <button
                                                class="btn-action btn-toggle"
                                                onclick={`toggleSucursal(${sucursal.id}, ${sucursal.activo})`}
                                                title="Activar/Desactivar"
                                            >
                                                🔄
                                            </button>
                                            <a
                                                href={`/sucursales?id=${sucursal.id}`}
                                                class="btn-action btn-ver"
                                                target="_blank"
                                                title="Ver en Web"
                                            >
                                                👁️
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            );
                        })
                    }
                </tbody>
            </table>
        </div>
    </div>
</AdminLayout>

<style is:global>
