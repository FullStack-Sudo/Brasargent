---
// src/pages/admin/sucursales/nueva.astro
// Creación de nueva sucursal

import AdminLayout from '../../../layouts/AdminLayout.astro';

// Días de la semana
const diasSemana = [
    { id: 'lunes', label: 'Lunes' },
    { id: 'martes', label: 'Martes' },
    { id: 'miercoles', label: 'Miércoles' },
    { id: 'jueves', label: 'Jueves' },
    { id: 'viernes', label: 'Viernes' },
    { id: 'sabado', label: 'Sábado' },
    { id: 'domingo', label: 'Domingo' }
];

// Conceptos
const conceptos = [
    { value: 'Churrasquería', label: '🔥 Churrasquería' },
    { value: 'Rodizio Tradicional', label: '🥩 Rodizio Tradicional' },
    { value: 'Restaurante', label: '🍽️ Restaurante' },
    { value: 'Fast Grill', label: '⚡ Fast Grill' },
    { value: 'Parrilla', label: '🔥 Parrilla' }
];
---

<AdminLayout title="Nueva Sucursal" description="Agrega una nueva sucursal al sistema">
    <div class="editar-sucursal">
        <!-- Header -->
        <div class="page-header">
            <div>
                <h1>➕ Nueva Sucursal</h1>
                <p>Configura los datos, horarios y capacidad de la nueva sucursal</p>
            </div>
            <a href="/admin/sucursales" class="btn-volver">← Volver</a>
        </div>

        <!-- Formulario -->
        <form id="formNuevaSucursal" class="form-sucursal">
            <!-- Información General -->
            <div class="form-section">
                <h3>📋 Información General</h3>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Nombre *</label>
                        <input type="text" id="nombre" placeholder="Ej. Los Pinos" required />
                    </div>
                    <div class="form-group">
                        <label>Concepto</label>
                        <select id="concepto">
                            {conceptos.map(c => (
                                <option value={c.value}>{c.label}</option>
                            ))}
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>Dirección *</label>
                    <input type="text" id="direccion" placeholder="Ej. Av. Principal 123" required />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Teléfono *</label>
                        <input type="tel" id="telefono" placeholder="Ej. 70000000" required />
                    </div>
                    <div class="form-group">
                        <label>Capacidad Total (Cubiertos)</label>
                        <input type="number" id="capacidad" value="120" min="1" max="500" />
                    </div>
                </div>

                <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="permiteReservas" checked />
                        <span class="custom-checkbox"></span>
                        <div>
                            <strong>📅 Permite Reservas</strong>
                            <small>Los clientes pueden reservar en esta sucursal</small>
                        </div>
                    </label>
                </div>

                <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="permiteCubiertos" checked />
                        <span class="custom-checkbox"></span>
                        <div>
                            <strong>🪑 Permite Cubiertos</strong>
                            <small>Muestra disponibilidad de cubiertos</small>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Horarios -->
            <div class="form-section">
                <h3>🕐 Horarios de Atención</h3>
                <div class="horarios-container">
                    {diasSemana.map((dia) => {
                        return (
                            <div class="horario-dia" data-dia={dia.id}>
                                <div class="dia-header">
                                    <span class="dia-nombre">{dia.label}</span>
                                    <div class="dia-controls">
                                        <label class="switch-small">
                                            <input type="checkbox" class="dia-activo" checked />
                                            <span class="slider-small"></span>
                                        </label>
                                        <button type="button" class="btn-agregar-bloque" onclick="agregarBloque(this)">➕</button>
                                    </div>
                                </div>
                                <div class="dia-bloques">
                                    <div class="bloque-horario">
                                        <input type="time" class="bloque-inicio" value="11:30" />
                                        <span>a</span>
                                        <input type="time" class="bloque-fin" value="15:00" />
                                        <button type="button" class="btn-eliminar-bloque" onclick="eliminarBloque(this)">✕</button>
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>

            <!-- Botones -->
            <div class="form-actions">
                <a href="/admin/sucursales" class="btn-cancelar">Cancelar</a>
                <button type="submit" class="btn-guardar">➕ Crear Sucursal</button>
            </div>
        </form>
    </div>
</AdminLayout>

<script is:inline>
// ============================================
// MANEJO DE HORARIOS
// ============================================

function agregarBloque(btn) {
    const diaContainer = btn.closest('.horario-dia');
    const bloquesContainer = diaContainer.querySelector('.dia-bloques');
    
    const nuevoBloque = document.createElement('div');
    nuevoBloque.className = 'bloque-horario';
    nuevoBloque.innerHTML = `
        <input type="time" class="bloque-inicio" value="18:30" />
        <span>a</span>
        <input type="time" class="bloque-fin" value="22:00" />
        <button type="button" class="btn-eliminar-bloque" onclick="eliminarBloque(this)">✕</button>
    `;
    
    bloquesContainer.appendChild(nuevoBloque);
}

function eliminarBloque(btn) {
    const bloque = btn.closest('.bloque-horario');
    const diaContainer = bloque.closest('.horario-dia');
    const bloques = diaContainer.querySelectorAll('.bloque-horario');
    
    if (bloques.length <= 1) {
        alert('Debe haber al menos un bloque de horario');
        return;
    }
    
    if (confirm('¿Eliminar este bloque?')) {
        bloque.remove();
    }
}

// ============================================
// ENVÍO DEL FORMULARIO
// ============================================

document.getElementById('formNuevaSucursal').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const btn = document.querySelector('.btn-guardar');
    btn.textContent = '⏳ Creando...';
    btn.disabled = true;
    
    // Recolectar datos
    const data = {
        nombre: document.getElementById('nombre').value.trim(),
        concepto: document.getElementById('concepto').value,
        direccion: document.getElementById('direccion').value.trim(),
        telefono: document.getElementById('telefono').value.trim(),
        capacidad_total: parseInt(document.getElementById('capacidad').value) || 120,
        permite_reservas: document.getElementById('permiteReservas').checked ? 1 : 0,
        permite_cubiertos: document.getElementById('permiteCubiertos').checked ? 1 : 0,
        horarios: {}
    };
    
    // Recolectar horarios
    const dias = document.querySelectorAll('.horario-dia');
    dias.forEach(dia => {
        const diaId = dia.dataset.dia;
        const activo = dia.querySelector('.dia-activo').checked;
        const bloques = [];
        const bloqueElements = dia.querySelectorAll('.bloque-horario');
        
        bloqueElements.forEach(bloque => {
            const inicio = bloque.querySelector('.bloque-inicio').value;
            const fin = bloque.querySelector('.bloque-fin').value;
            if (inicio && fin) {
                bloques.push({ inicio, fin });
            }
        });
        
        data.horarios[diaId] = {
            activo: activo,
            bloques: bloques
        };
    });
    
    try {
        const response = await fetch('/api/sucursales/crear', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        
        const result = await response.json();
        
        if (result.success) {
            alert('✅ Sucursal creada exitosamente');
            window.location.href = '/admin/sucursales';
        } else {
            alert('❌ Error: ' + result.error);
            btn.textContent = '➕ Crear Sucursal';
            btn.disabled = false;
        }
    } catch (error) {
        alert('❌ Error de conexión');
        btn.textContent = '➕ Crear Sucursal';
        btn.disabled = false;
    }
});
</script>

<style is:global>
/* ============================================
   CREACIÓN DE SUCURSAL - ESTILOS
   ============================================ */
.editar-sucursal {
    max-width: 800px;
    margin: 0 auto;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    color: #1a1a1a;
    margin: 0;
}

.page-header p {
    color: rgba(26, 26, 26, 0.5);
    margin: 4px 0 0;
}

.btn-volver {
    padding: 8px 16px;
    border: 1px solid rgba(26, 26, 26, 0.1);
    border-radius: 8px;
    text-decoration: none;
    color: #1a1a1a;
    transition: all 0.3s ease;
}

.btn-volver:hover {
    background: rgba(26, 26, 26, 0.04);
}

.form-sucursal {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.form-section {
    background: white;
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.form-section h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 16px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.form-group {
    margin-bottom: 16px;
}

.form-group label {
    display: block;
    font-weight: 500;
    color: #1a1a1a;
    font-size: 0.85rem;
    margin-bottom: 4px;
}

.form-group input,
.form-group select {
    width: 100%;
    padding: 10px 14px;
    border: 1.5px solid rgba(26, 26, 26, 0.08);
    border-radius: 10px;
    font-size: 0.95rem;
    font-family: 'Inter', sans-serif;
    transition: all 0.3s ease;
    background: white;
    color: #1a1a1a;
}

.form-group input:focus,
.form-group select:focus {
    outline: none;
    border-color: #9e2a2b;
    box-shadow: 0 0 0 3px rgba(158, 42, 43, 0.08);
}

/* Horarios */
.horarios-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.horario-dia {
    background: rgba(255, 250, 240, 0.3);
    border-radius: 10px;
    padding: 12px 16px;
}

.dia-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.dia-nombre {
    font-weight: 600;
    font-size: 0.9rem;
}

.dia-controls {
    display: flex;
    align-items: center;
    gap: 8px;
}

.switch-small {
    position: relative;
    display: inline-block;
    width: 36px;
    height: 20px;
}

.switch-small input {
    opacity: 0;
    width: 0;
    height: 0;
}

.slider-small {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #ccc;
    border-radius: 20px;
    transition: all 0.3s ease;
}

.slider-small::before {
    content: '';
    position: absolute;
    height: 14px;
    width: 14px;
    left: 3px;
    bottom: 3px;
    background: white;
    border-radius: 50%;
    transition: all 0.3s ease;
}

.switch-small input:checked + .slider-small {
    background: #10b981;
}

.switch-small input:checked + .slider-small::before {
    transform: translateX(16px);
}

.btn-agregar-bloque {
    padding: 4px 10px;
    background: rgba(158, 42, 43, 0.08);
    color: #9e2a2b;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.8rem;
}

.btn-agregar-bloque:hover {
    background: rgba(158, 42, 43, 0.15);
}

.dia-bloques {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 8px;
    padding-left: 12px;
}

.bloque-horario {
    display: flex;
    align-items: center;
    gap: 8px;
    background: white;
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid rgba(26, 26, 26, 0.04);
}

.bloque-horario input {
    padding: 4px 8px;
    border: 1px solid rgba(26, 26, 26, 0.08);
    border-radius: 4px;
    font-size: 0.8rem;
    width: 80px;
    font-family: 'Inter', sans-serif;
}

.bloque-horario span {
    color: rgba(26, 26, 26, 0.3);
}

.btn-eliminar-bloque {
    background: transparent;
    border: none;
    color: #ef4444;
    cursor: pointer;
    font-size: 0.9rem;
    padding: 4px;
}

.btn-eliminar-bloque:hover {
    transform: scale(1.2);
}

/* Checkbox */
.checkbox-group {
    margin-top: 4px;
}

.checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
    padding: 10px 14px;
    background: rgba(26, 26, 26, 0.02);
    border-radius: 10px;
    transition: all 0.3s ease;
}

.checkbox-label:hover {
    background: rgba(26, 26, 26, 0.04);
}

.checkbox-label input[type="checkbox"] {
    display: none;
}

.custom-checkbox {
    width: 20px;
    height: 20px;
    min-width: 20px;
    border: 2px solid rgba(26, 26, 26, 0.15);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    margin-top: 2px;
}

.checkbox-label input:checked + .custom-checkbox {
    background: #9e2a2b;
    border-color: #9e2a2b;
}

.checkbox-label input:checked + .custom-checkbox::after {
    content: '✓';
    color: white;
    font-size: 14px;
    font-weight: bold;
}

.checkbox-label strong {
    display: block;
    font-weight: 500;
    font-size: 0.9rem;
    color: #1a1a1a;
}

.checkbox-label small {
    color: rgba(26, 26, 26, 0.4);
    font-size: 0.8rem;
}

/* Form Actions */
.form-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
}

.btn-cancelar,
.btn-guardar {
    padding: 12px 32px;
    border: none;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: 'Inter', sans-serif;
    text-decoration: none;
}

.btn-cancelar {
    background: transparent;
    color: #1a1a1a;
    border: 1.5px solid rgba(26, 26, 26, 0.1);
}

.btn-cancelar:hover {
    background: rgba(26, 26, 26, 0.04);
}

.btn-guardar {
    background: linear-gradient(135deg, #9e2a2b, #7a2021);
    color: #fffaf0;
    box-shadow: 0 4px 16px rgba(158, 42, 43, 0.2);
}

.btn-guardar:hover {
    transform: scale(1.02);
    box-shadow: 0 6px 24px rgba(158, 42, 43, 0.3);
}

/* Responsive */
@media (max-width: 768px) {
    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }
    
    .page-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
    
    .form-actions {
        flex-direction: column-reverse;
    }
    
    .btn-cancelar,
    .btn-guardar {
        width: 100%;
        text-align: center;
    }
}
</style>
