---
// src/pages/admin/whatsapp.astro
// Panel de control de WhatsApp con OpenWA - Sesiones, Notificaciones y Reenvío de Errores
import AdminLayout from '../../layouts/AdminLayout.astro';
import pool from '../../lib/db';

// Obtener logs de mensajes
let logs: any[] = [];
try {
    const [rows] = await pool.query(`
        SELECT 
            id,
            destinatario,
            mensaje,
            estado,
            error,
            fecha_envio,
            fecha_reenvio
        FROM logs_whatsapp
        ORDER BY fecha_envio DESC
        LIMIT 50
    `) as any[];
    logs = rows || [];
} catch (e) {
    console.error('Error al consultar logs_whatsapp:', e);
    logs = [];
}

// Estadísticas
let stats = { total: 0, enviados: 0, entregados: 0, errores: 0, reenviados: 0 };
try {
    const [rowsStats] = await pool.query(`
        SELECT 
            COUNT(*) as total,
            SUM(CASE WHEN estado = 'enviado' THEN 1 ELSE 0 END) as enviados,
            SUM(CASE WHEN estado = 'entregado' OR estado = 'leido' THEN 1 ELSE 0 END) as entregados,
            SUM(CASE WHEN estado = 'error' THEN 1 ELSE 0 END) as errores,
            SUM(CASE WHEN estado = 'reenviado' THEN 1 ELSE 0 END) as reenviados
        FROM logs_whatsapp
    `) as any[];
    if (rowsStats && rowsStats.length > 0) {
        stats = {
            total: rowsStats[0].total || 0,
            enviados: rowsStats[0].enviados || 0,
            entregados: rowsStats[0].entregados || 0,
            errores: rowsStats[0].errores || 0,
            reenviados: rowsStats[0].reenviados || 0
        };
    }
} catch (e) {
    console.error('Error al consultar estadísticas de whatsapp:', e);
}
---

<AdminLayout title="WhatsApp" description="Panel de control de mensajes y notificaciones">
    <div class="whatsapp-dashboard">
        <div class="page-header">
            <div>
                <h1>💬 WhatsApp OpenWA</h1>
                <p>Gestión de mensajes, notificaciones automáticas y control de sesiones</p>
            </div>
            <button class="btn-refresh" id="refreshBtn">🔄 Actualizar</button>
        </div>

        <!-- Estadísticas -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">📨</div>
                <div class="stat-info">
                    <span class="stat-number">{stats.total}</span>
                    <span class="stat-label">Total Mensajes</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">✅</div>
                <div class="stat-info">
                    <span class="stat-number">{stats.entregados}</span>
                    <span class="stat-label">Entregados / Leídos</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">❌</div>
                <div class="stat-info">
                    <span class="stat-number">{stats.errores}</span>
                    <span class="stat-label">Errores</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(168, 85, 247, 0.1); color: #a855f7;">🔄</div>
                <div class="stat-info">
                    <span class="stat-number">{stats.reenviados}</span>
                    <span class="stat-label">Reenviados</span>
                </div>
            </div>
        </div>

        <!-- Estado de Sesión con Botón de Desconexión -->
        <div class="section-card status-card">
            <div class="section-header">
                <h3>📱 Estado de Sesión OpenWA</h3>
                <button id="btnDesconectar" class="btn-desconectar">
                    🔴 Desconectar
                </button>
            </div>
            <div class="session-status" id="sessionStatus">
                <span class="status-indicator status-checking">⏳ Verificando conexión con OpenWA...</span>
            </div>
        </div>

        <!-- Historial de Mensajes con Selección Múltiple -->
        <div class="section-card">
            <div class="section-header">
                <h3>📋 Historial de Mensajes (Últimos 50)</h3>
                <div class="acciones-masivas" id="accionesMasivas" style="display: none;">
                    <button class="btn-accion btn-reenviar" onclick="reenviarSeleccionados()">
                        🔄 Reenviar
                    </button>
                    <button class="btn-accion btn-editar" onclick="editarSeleccionados()">
                        ✏️ Editar
                    </button>
                    <button class="btn-accion btn-chat" onclick="abrirChatOnline()">
                        💬 Chat
                    </button>
                    <button class="btn-accion btn-eliminar" onclick="eliminarSeleccionados()">
                        🗑️ Eliminar
                    </button>
                    <span class="seleccionados-info" id="seleccionadosInfo">0 seleccionados</span>
                </div>
            </div>

            {logs.length === 0 ? (
                <div class="empty-state">
                    <span class="empty-icon">💬</span>
                    <p>No hay registro de mensajes enviados</p>
                    <span class="empty-sub">Los mensajes enviados por WhatsApp aparecerán aquí</span>
                </div>
            ) : (
                <div class="table-wrapper">
                    <table class="tabla-mensajes">
                        <thead>
                            <tr>
                                <th style="width: 40px; text-align: center;">
                                    <input type="checkbox" id="seleccionarTodos" onchange="toggleSeleccionarTodos()" />
                                </th>
                                <th>#</th>
                                <th>Destinatario</th>
                                <th>Mensaje</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {logs.map((log: any, index: number) => {
                                const esError = log.estado === 'error';
                                return (
                                    <tr class={esError ? 'row-error' : ''}>
                                        <td style="text-align: center;">
                                            <input 
                                                type="checkbox" 
                                                class="seleccionar-mensaje" 
                                                data-id={log.id}
                                                onchange="actualizarSeleccion()"
                                            />
                                        </td>
                                        <td>{index + 1}</td>
                                        <td>
                                            <a href={`https://wa.me/${String(log.destinatario).replace(/\D/g, '')}`} 
                                               target="_blank" 
                                               class="whatsapp-num">
                                                💬 +{log.destinatario}
                                            </a>
                                        </td>
                                        <td class="mensaje-texto" title={log.mensaje}>
                                            {log.mensaje}
                                            {log.error && (
                                                <small class="error-detalle">
                                                    ⚠️ {log.error}
                                                </small>
                                            )}
                                        </td>
                                        <td>
                                            <span class={`badge-estado ${log.estado}`}>
                                                {log.estado === 'entregado' ? '✅ Entregado' :
                                                 log.estado === 'enviado' ? '📨 Enviado' :
                                                 log.estado === 'error' ? '❌ Error' :
                                                 log.estado === 'reenviado' ? '🔄 Reenviado' :
                                                 log.estado === 'leido' ? '👁️ Leído' :
                                                 '⏳ Pendiente'}
                                            </span>
                                        </td>
                                        <td>{new Date(log.fecha_envio).toLocaleString('es-ES')}</td>
                                        <td>
                                            <div class="acciones-individuales">
                                                {esError && (
                                                    <>
                                                        <button class="btn-accion-sm btn-reenviar-sm" 
                                                                onclick={`reenviarMensaje(${log.id})`}
                                                                title="Reenviar mensaje">
                                                            🔄
                                                        </button>
                                                        <button class="btn-accion-sm btn-editar-sm" 
                                                                onclick={`editarMensaje(${log.id})`}
                                                                title="Editar mensaje antes de reenviar">
                                                            ✏️
                                                        </button>
                                                    </>
                                                )}
                                                <button class="btn-accion-sm btn-chat-sm" 
                                                        onclick={`abrirChat('${log.destinatario}')`}
                                                        title="Abrir chat en WhatsApp">
                                                    💬
                                                </button>
                                                <button class="btn-accion-sm btn-eliminar-sm" 
                                                        onclick={`eliminarMensaje(${log.id})`}
                                                        title="Eliminar mensaje del historial">
                                                    🗑️
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                );
                            })}
                        </tbody>
                    </table>
                </div>
            )}
        </div>
    </div>

    <!-- Modal Código QR -->
    <div id="qrModal" class="modal-overlay" style="display: none;">
        <div class="modal-card">
            <div class="modal-header">
                <h3>📱 Escanea el código QR</h3>
                <button type="button" class="btn-close" id="btnCloseQr">✕</button>
            </div>
            <div class="modal-body">
                <p class="qr-desc">Abre WhatsApp en tu teléfono ➔ <strong>Dispositivos vinculados</strong> ➔ Vincular un dispositivo y escanea este código:</p>
                <div class="qr-container">
                    <img id="qrImage" src="" alt="Código QR WhatsApp" class="qr-img" />
                </div>
                <p class="qr-sub" id="qrStatusText">🔄 El código QR se actualiza automáticamente.</p>
                <div style="margin-top: 14px;">
                    <button type="button" id="btnResetQr" class="btn-reset-qr">
                        🔄 Generar Nuevo Código QR
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Edición de Mensaje -->
    <div id="modalEditar" class="modal-overlay" style="display: none;">
        <div class="modal-card modal-card-lg">
            <div class="modal-header">
                <h3>✏️ Editar Mensaje para Reenviar</h3>
                <button type="button" class="btn-close" id="cerrarEdicion">✕</button>
            </div>
            <div class="modal-body">
                <p class="qr-desc">Modifica el texto del mensaje antes de volver a enviarlo por WhatsApp:</p>
                <textarea id="editarTexto" rows="6" class="editar-textarea" placeholder="Escribe el mensaje..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" id="guardarEdicion" class="btn-primary-action">💾 Guardar y Reenviar</button>
                <button type="button" class="btn-secondary-action" id="cancelarEdicion">Cancelar</button>
            </div>
        </div>
    </div>
</AdminLayout>

<script>
let qrInterval: any = null;
let mensajesSeleccionados: number[] = [];

// ============================================
// GESTIÓN DE SELECCIÓN MÚLTIPLE
// ============================================

function toggleSeleccionarTodos() {
    const mainCb = document.getElementById('seleccionarTodos') as HTMLInputElement | null;
    const checkboxes = document.querySelectorAll('.seleccionar-mensaje') as NodeListOf<HTMLInputElement>;
    const todosChecked = mainCb?.checked || false;
    
    checkboxes.forEach(cb => {
        if (!cb.disabled) {
            cb.checked = todosChecked;
        }
    });
    
    actualizarSeleccion();
}

function actualizarSeleccion() {
    const checkboxes = document.querySelectorAll('.seleccionar-mensaje:checked') as NodeListOf<HTMLInputElement>;
    mensajesSeleccionados = Array.from(checkboxes).map(cb => parseInt(cb.dataset.id || '0')).filter(id => id > 0);
    
    const info = document.getElementById('seleccionadosInfo');
    const acciones = document.getElementById('accionesMasivas');
    
    if (info && acciones) {
        if (mensajesSeleccionados.length > 0) {
            info.textContent = `${mensajesSeleccionados.length} seleccionados`;
            acciones.style.display = 'flex';
        } else {
            acciones.style.display = 'none';
        }
    }
}

// ============================================
// DESCONECTAR SESIÓN
// ============================================

async function desconectarSesion() {
    if (!confirm('⚠️ ¿Estás seguro de desconectar la sesión de WhatsApp?\n\nSe cerrará la conexión actual y podrás vincular otro número de teléfono.')) {
        return;
    }

    const btn = document.getElementById('btnDesconectar') as HTMLButtonElement | null;
    if (btn) {
        btn.textContent = '⏳ Desconectando...';
        btn.disabled = true;
    }

    try {
        const response = await fetch('/api/whatsapp/logout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        const result = await response.json();

        if (result.success) {
            alert('✅ Sesión desconectada correctamente');
            location.reload();
        } else {
            alert('❌ Error: ' + (result.error || 'No se pudo desconectar'));
        }
    } catch (error) {
        alert('❌ Error de conexión con el servidor');
    } finally {
        if (btn) {
            btn.textContent = '🔴 Desconectar';
            btn.disabled = false;
        }
    }
}

// ============================================
// CONECTAR WHATSAPP CON OPENWA
// ============================================

async function conectarWhatsApp() {
    const btn = document.getElementById('btnConectar') as HTMLButtonElement | null;
    if (btn) {
        btn.textContent = '⏳ Conectando...';
        btn.disabled = true;
    }
    
    try {
        const response = await fetch('/api/whatsapp/conectar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        
        const result = await response.json();
        
        if (result.success && result.qr) {
            const modal = document.getElementById('qrModal');
            const qrImg = document.getElementById('qrImage') as HTMLImageElement | null;
            if (qrImg) {
                qrImg.src = result.qr.startsWith('data:') ? result.qr : `data:image/png;base64,${result.qr}`;
            }
            if (modal) {
                modal.style.display = 'flex';
            }
            iniciarAutoRefrescoQR();
        } else {
            alert('❌ Error: ' + (result.error || 'No se pudo generar el código QR'));
        }
    } catch (error) {
        alert('❌ Error de conexión con el servidor');
    } finally {
        if (btn) {
            btn.textContent = '📱 Conectar WhatsApp';
            btn.disabled = false;
        }
    }
}

async function reiniciarWhatsApp() {
    const btnReset = document.getElementById('btnResetQr') as HTMLButtonElement | null;
    const statusText = document.getElementById('qrStatusText');
    if (btnReset) {
        btnReset.textContent = '⏳ Generando nuevo QR...';
        btnReset.disabled = true;
    }
    if (statusText) statusText.textContent = '⏳ Limpiando sesión obsoleta...';

    try {
        const response = await fetch('/api/whatsapp/reiniciar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const result = await response.json();
        if (result.success && result.qr) {
            const qrImg = document.getElementById('qrImage') as HTMLImageElement | null;
            if (qrImg) {
                qrImg.src = result.qr.startsWith('data:') ? result.qr : `data:image/png;base64,${result.qr}`;
            }
            if (statusText) statusText.textContent = '✅ Nuevo código QR generado. Escanéalo ahora.';
        } else {
            if (statusText) statusText.textContent = '⚠️ Reintentando obtener QR...';
        }
    } catch (e) {
        if (statusText) statusText.textContent = '❌ Error al reiniciar sesión';
    } finally {
        if (btnReset) {
            btnReset.textContent = '🔄 Generar Nuevo Código QR';
            btnReset.disabled = false;
        }
    }
}

function iniciarAutoRefrescoQR() {
    if (qrInterval) clearInterval(qrInterval);
    qrInterval = setInterval(async () => {
        const modal = document.getElementById('qrModal');
        const qrImg = document.getElementById('qrImage') as HTMLImageElement | null;
        if (modal && modal.style.display !== 'none' && qrImg) {
            try {
                const res = await fetch('/api/whatsapp/conectar', { method: 'POST' });
                const data = await res.json();
                if (data.success && data.qr) {
                    qrImg.src = data.qr.startsWith('data:') ? data.qr : `data:image/png;base64,${data.qr}`;
                }
            } catch (e) {}
        } else {
            cerrarQRModal();
        }
    }, 6000);
}

function cerrarQRModal() {
    const modal = document.getElementById('qrModal');
    if (modal) modal.style.display = 'none';
    if (qrInterval) {
        clearInterval(qrInterval);
        qrInterval = null;
    }
}

// ============================================
// REENVIAR MENSAJES SELECCIONADOS (MASIVO)
// ============================================

async function reenviarSeleccionados() {
    if (mensajesSeleccionados.length === 0) {
        alert('⚠️ Selecciona al menos un mensaje con error');
        return;
    }

    if (!confirm(`¿Reenviar ${mensajesSeleccionados.length} mensajes seleccionados por WhatsApp?`)) {
        return;
    }

    const btn = document.querySelector('.btn-reenviar') as HTMLButtonElement | null;
    if (btn) {
        btn.textContent = '⏳ Reenviando...';
        btn.disabled = true;
    }

    try {
        const response = await fetch('/api/whatsapp/reenviar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                mensajes: mensajesSeleccionados.map(id => ({ id })),
                accion: 'reenviar'
            })
        });

        const result = await response.json();

        if (result.success) {
            alert(`✅ ${result.mensaje}`);
            location.reload();
        } else {
            alert('❌ Error: ' + (result.error || 'No se pudo reenviar'));
        }
    } catch (error) {
        alert('❌ Error de conexión con el servidor');
    } finally {
        if (btn) {
            btn.textContent = '🔄 Reenviar';
            btn.disabled = false;
        }
    }
}

// ============================================
// EDITAR MENSAJE (INDIVIDUAL O MASIVO)
// ============================================

function editarSeleccionados() {
    if (mensajesSeleccionados.length === 0) {
        alert('⚠️ Selecciona al menos un mensaje con error');
        return;
    }

    const primerId = mensajesSeleccionados[0];
    editarMensaje(primerId);
}

function editarMensaje(id: number) {
    const modal = document.getElementById('modalEditar');
    const textarea = document.getElementById('editarTexto') as HTMLTextAreaElement | null;
    const cb = document.querySelector(`.seleccionar-mensaje[data-id="${id}"]`);
    
    if (!modal || !textarea || !cb) return;

    const row = cb.closest('tr');
    if (!row) return;

    const textoElem = row.querySelector('.mensaje-texto');
    const textoActual = textoElem ? textoElem.childNodes[0].textContent?.trim() || '' : '';

    textarea.value = textoActual;
    modal.dataset.id = String(id);
    modal.style.display = 'flex';
}

function cerrarModalEditar() {
    const modal = document.getElementById('modalEditar');
    if (modal) modal.style.display = 'none';
}

// ============================================
// CHAT ONLINE (ABRIR WHATSAPP WEB/APP)
// ============================================

function abrirChatOnline() {
    if (mensajesSeleccionados.length === 0) {
        alert('⚠️ Selecciona al menos un mensaje');
        return;
    }

    const primerId = mensajesSeleccionados[0];
    const cb = document.querySelector(`.seleccionar-mensaje[data-id="${primerId}"]`);
    if (!cb) return;

    const row = cb.closest('tr');
    if (!row) return;

    const linkNum = row.querySelector('.whatsapp-num');
    const telefono = linkNum ? linkNum.textContent?.replace(/\D/g, '') || '' : '';

    if (telefono) {
        abrirChat(telefono);
    }
}

function abrirChat(telefono: string) {
    const numeroLimpio = String(telefono).replace(/\D/g, '');
    const numeroFinal = numeroLimpio.startsWith('591') || numeroLimpio.length > 8 ? numeroLimpio : `591${numeroLimpio}`;
    const url = `https://wa.me/${numeroFinal}`;
    window.open(url, '_blank');
}

async function reenviarMensaje(id: number) {
    if (!confirm('¿Reenviar este mensaje por WhatsApp?')) return;
    
    try {
        const response = await fetch('/api/whatsapp/reenviar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                mensajes: [{ id }],
                accion: 'reenviar'
            })
        });

        const result = await response.json();
        if (result.success) {
            alert('✅ Mensaje reenviado exitosamente');
            location.reload();
        } else {
            alert('❌ Error: ' + (result.error || 'No se pudo reenviar'));
        }
    } catch (error) {
        alert('❌ Error de conexión con el servidor');
    }
}

// ============================================
// ELIMINAR MENSAJES (INDIVIDUAL O MASIVO)
// ============================================

async function eliminarMensaje(id: number) {
    if (!confirm('🗑️ ¿Estás seguro de eliminar este mensaje del historial?')) return;
    
    try {
        const response = await fetch('/api/whatsapp/eliminar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
        });

        const result = await response.json();
        if (result.success) {
            alert('✅ Mensaje eliminado correctamente');
            location.reload();
        } else {
            alert('❌ Error: ' + (result.error || 'No se pudo eliminar el mensaje'));
        }
    } catch (error) {
        alert('❌ Error de conexión con el servidor');
    }
}

async function eliminarSeleccionados() {
    if (mensajesSeleccionados.length === 0) {
        alert('⚠️ Selecciona al menos un mensaje para eliminar');
        return;
    }

    if (!confirm(`🗑️ ¿Estás seguro de eliminar los ${mensajesSeleccionados.length} mensajes seleccionados del historial?`)) {
        return;
    }

    const btn = document.querySelector('.btn-eliminar') as HTMLButtonElement | null;
    if (btn) {
        btn.textContent = '⏳ Eliminando...';
        btn.disabled = true;
    }

    try {
        const response = await fetch('/api/whatsapp/eliminar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: mensajesSeleccionados })
        });

        const result = await response.json();
        if (result.success) {
            alert(`✅ ${result.mensaje}`);
            location.reload();
        } else {
            alert('❌ Error: ' + (result.error || 'No se pudieron eliminar los mensajes'));
        }
    } catch (error) {
        alert('❌ Error de conexión con el servidor');
    } finally {
        if (btn) {
            btn.textContent = '🗑️ Eliminar';
            btn.disabled = false;
        }
    }
}

// Event Listeners
document.getElementById('guardarEdicion')?.addEventListener('click', async function() {
    const modal = document.getElementById('modalEditar');
    const textarea = document.getElementById('editarTexto') as HTMLTextAreaElement | null;
    const btn = document.getElementById('guardarEdicion') as HTMLButtonElement | null;
    
    if (!modal || !textarea) return;
    
    const id = parseInt(modal.dataset.id || '0');
    const texto = textarea.value.trim();
    
    if (!id) {
        alert('⚠️ No hay mensaje seleccionado');
        return;
    }
    if (!texto) {
        alert('⚠️ El mensaje no puede estar vacío');
        return;
    }

    if (btn) {
        btn.textContent = '⏳ Guardando y reenviando...';
        btn.disabled = true;
    }

    try {
        const response = await fetch('/api/whatsapp/reenviar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                mensajes: [{ id }],
                accion: 'editar',
                nuevoTexto: texto
            })
        });

        const result = await response.json();
        
        if (result.success) {
            alert('✅ Mensaje editado y reenviado correctamente');
            cerrarModalEditar();
            location.reload();
        } else {
            alert('❌ Error: ' + (result.error || 'No se pudo reenviar'));
        }
    } catch (error) {
        alert('❌ Error de conexión con el servidor');
    } finally {
        if (btn) {
            btn.textContent = '💾 Guardar y Reenviar';
            btn.disabled = false;
        }
    }
});

document.getElementById('cerrarEdicion')?.addEventListener('click', cerrarModalEditar);
document.getElementById('cancelarEdicion')?.addEventListener('click', cerrarModalEditar);
document.getElementById('btnDesconectar')?.addEventListener('click', desconectarSesion);

(window as any).conectarWhatsApp = conectarWhatsApp;
(window as any).reiniciarWhatsApp = reiniciarWhatsApp;
(window as any).cerrarQRModal = cerrarQRModal;
(window as any).desconectarSesion = desconectarSesion;
(window as any).toggleSeleccionarTodos = toggleSeleccionarTodos;
(window as any).actualizarSeleccion = actualizarSeleccion;
(window as any).reenviarSeleccionados = reenviarSeleccionados;
(window as any).editarSeleccionados = editarSeleccionados;
(window as any).abrirChatOnline = abrirChatOnline;
(window as any).reenviarMensaje = reenviarMensaje;
(window as any).editarMensaje = editarMensaje;
(window as any).abrirChat = abrirChat;
(window as any).eliminarMensaje = eliminarMensaje;
(window as any).eliminarSeleccionados = eliminarSeleccionados;

// ============================================
// VERIFICAR ESTADO DE CONEXIÓN
// ============================================

async function verificarConexion() {
    const statusEl = document.getElementById('sessionStatus');
    if (!statusEl) return;

    try {
        const response = await fetch('/api/whatsapp/status');
        const data = await response.json();
        
        if (data.connected) {
            statusEl.innerHTML = `
                <div class="session-info">
                    <span class="status-indicator status-connected">🟢 Conectado</span>
                    <span class="status-detail">Sesión activa: <strong>${data.session}</strong></span>
                    ${data.phone ? `<span class="status-detail">Teléfono: <strong>+${data.phone}</strong> ${data.pushName ? `(${data.pushName})` : ''}</span>` : ''}
                </div>
            `;
            cerrarQRModal();
        } else {
            statusEl.innerHTML = `
                <div class="session-info">
                    <span class="status-indicator status-disconnected">🔴 Desconectado</span>
                    <span class="status-detail">Comprueba la sesión en OpenWA o escanea el código QR</span>
                    <button id="btnConectar" class="btn-conectar">
                        📱 Conectar WhatsApp
                    </button>
                </div>
            `;
            document.getElementById('btnConectar')?.addEventListener('click', conectarWhatsApp);
        }
    } catch (error) {
        statusEl.innerHTML = `
            <div class="session-info">
                <span class="status-indicator status-error">⚠️ Error de conexión</span>
                <span class="status-detail">No se pudo verificar el servicio OpenWA</span>
            </div>
        `;
    }
}

document.getElementById('btnCloseQr')?.addEventListener('click', cerrarQRModal);
document.getElementById('btnResetQr')?.addEventListener('click', reiniciarWhatsApp);
document.getElementById('qrModal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) cerrarQRModal();
});
document.getElementById('modalEditar')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) cerrarModalEditar();
});

// Botón actualizar
document.getElementById('refreshBtn')?.addEventListener('click', () => {
    verificarConexion();
    window.location.reload();
});

// Verificar periódicamente cada 10 segundos
setInterval(verificarConexion, 10000);
document.addEventListener('DOMContentLoaded', verificarConexion);
</script>

