---
// Página de Sucursales con Modal de Términos y Condiciones Obligatorio
import Minimal from "../layouts/Minimal.astro";
import NavbarSimple from "../components/NavbarSimple.astro";
import SucursalesSection from "../components/SucursalesSection.astro";
import FooterSimple from "../components/FooterSimple.astro";
import FloatCTA from "../components/FloatCTA.astro";
import TerminosModal from "../components/TerminosModal.astro";
---

<Minimal
  title="Sucursales - Brasargent | Encuentra tu restaurante más cercano"
  description="Descubre todas nuestras sucursales de Brasargent en Santa Cruz. Rodizio, Churrasqueria y Express. Encuentra la ubicación más cercana a ti."
>
  <!-- 🔴 Modal de Términos y Condiciones (se muestra en cada ingreso a /sucursales) -->
  <TerminosModal />

  <!-- Navbar fija -->
  <NavbarSimple />

  <!-- 🔴 Sección de Sucursales -->
  <div id="sucursalesContent" class="sucursales-page-wrapper">
    <SucursalesSection />
  </div>

  <!-- Footer -->
  <FooterSimple />

  <!-- Botón flotante de WhatsApp -->
  <FloatCTA />
</Minimal>

<style>
  .sucursales-page-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: filter 0.4s ease, opacity 0.4s ease;
  }

  .sucursales-page-wrapper.blocked {
    filter: blur(6px);
    pointer-events: none;
    user-select: none;
    opacity: 0.2;
  }
</style>
